use std.testing
fn testDependencyStringNoSource() {
    testing.assertEq(dependencyString("serde", "1.2.3", ""), "serde 1.2.3")
}
fn testDependencyStringWithSource() {
    testing.assertEq(
        dependencyString("serde", "1.2.3", "git+https://github.com/x/y"),
        "serde 1.2.3 (git+https://github.com/x/y)",
    )
}
fn testParseDependencyTwoFields() {
    let r = parseDependency("serde 1.2.3")
    testing.assert(r.ok)
    testing.assertEq(r.name, "serde")
    testing.assertEq(r.version, "1.2.3")
    testing.assertEq(r.source, "")
}
fn testParseDependencyWithSource() {
    let r = parseDependency("serde 1.2.3 (path:./vendor/serde)")
    testing.assert(r.ok)
    testing.assertEq(r.name, "serde")
    testing.assertEq(r.version, "1.2.3")
    testing.assertEq(r.source, "path:./vendor/serde")
}
fn testParseDependencyTrimsLeadingTrailing() {
    let r = parseDependency("  serde 1.2.3  ")
    testing.assert(r.ok)
    testing.assertEq(r.name, "serde")
    testing.assertEq(r.version, "1.2.3")
}
fn testParseDependencyRejectsSingleField() {
    let r = parseDependency("serde")
    testing.assert(!(r.ok))
}
fn testParseDependencyRejectsTooManyFields() {
    let r = parseDependency("serde 1.2.3 extra")
    testing.assert(!(r.ok))
}
fn testParseDependencyRejectsEmpty() {
    let r = parseDependency("")
    testing.assert(!(r.ok))
    let r2 = parseDependency("   ")
    testing.assert(!(r2.ok))
}
fn testParseDependencySourceWithEmbeddedParens() {
    // The source group is everything between the FIRST `(` and the
    // closing `)`. Embedded parens inside the source body are kept
    // as part of the source string.
    let r = parseDependency("crate 0.1.0 (registry+(local))")
    testing.assert(r.ok)
    testing.assertEq(r.source, "registry+(local)")
}
fn testParseDependencyRoundTrip() {
    let original = "tokio 1.5.0 (git+https://github.com/tokio-rs/tokio)"
    let parsed = parseDependency(original)
    testing.assert(parsed.ok)
    testing.assertEq(
        dependencyString(parsed.name, parsed.version, parsed.source),
        original,
    )
}
fn testTomlBasicStringAscii() {
    testing.assertEq(tomlBasicString("serde"), "\"serde\"")
    testing.assertEq(tomlBasicString(""), "\"\"")
}
fn testTomlBasicStringQuote() {
    testing.assertEq(tomlBasicString("a\"b"), "\"a\\\"b\"")
}
fn testTomlBasicStringBackslash() {
    testing.assertEq(tomlBasicString("a\\b"), "\"a\\\\b\"")
}
fn testTomlBasicStringNamedEscapes() {
    testing.assertEq(tomlBasicString("\n"), "\"\\n\"")
    testing.assertEq(tomlBasicString("\t"), "\"\\t\"")
    testing.assertEq(tomlBasicString("\r"), "\"\\r\"")
}
fn testTomlBasicStringHexEscape() {
    let s = "\u{01}"
    testing.assertEq(tomlBasicString(s), "\"\\x01\"")
}
fn testMarshalLockfileEmpty() {
    let out = marshalLockfile(1, [])
    let expected = "# This file is auto-generated by osty.\n# Do not edit manually; `osty update` regenerates it.\n\nversion = 1\n"
    testing.assertEq(out, expected)
}
fn testMarshalLockfileSinglePackageNoDeps() {
    let pkg = LockPackageSpec {
        name: "serde",
        version: "1.0.0",
        source: "registry+default",
        checksum: "sha256:abc",
        dependencies: [],
    }
    let out = marshalLockfile(1, [pkg])
    let expected = "# This file is auto-generated by osty.\n# Do not edit manually; `osty update` regenerates it.\n\nversion = 1\n\n[[package]]\nname = \"serde\"\nversion = \"1.0.0\"\nsource = \"registry+default\"\nchecksum = \"sha256:abc\"\n"
    testing.assertEq(out, expected)
}
fn testMarshalLockfilePathSourceNoChecksum() {
    let pkg = LockPackageSpec {
        name: "local",
        version: "0.1.0",
        source: "path+../local",
        checksum: "",
        dependencies: [],
    }
    let out = marshalLockfile(1, [pkg])
    testing.assert(strings.contains(out, "source = \"path+../local\"\n"))
    testing.assert(!(strings.contains(out, "checksum")))
}
fn testMarshalLockfileSortsPackages() {
    let zed = LockPackageSpec {
        name: "zed", version: "1.0.0", source: "", checksum: "", dependencies: [],
    }
    let alpha = LockPackageSpec {
        name: "alpha", version: "0.1.0", source: "", checksum: "", dependencies: [],
    }
    let out = marshalLockfile(1, [zed, alpha])
    let alphaAt = strings.indexOf(out, "name = \"alpha\"")
    let zedAt = strings.indexOf(out, "name = \"zed\"")
    match alphaAt {
        Some(a) -> match zedAt {
            Some(z) -> testing.assert(a < z),
            None -> testing.assert(false),
        },
        None -> testing.assert(false),
    }
}
fn testMarshalLockfileSortsDeps() {
    let dep1 = LockDepSpec {name: "zed", version: "1.0.0", source: ""}
    let dep2 = LockDepSpec {name: "alpha", version: "0.1.0", source: ""}
    let pkg = LockPackageSpec {
        name: "root", version: "1.0.0", source: "", checksum: "",
        dependencies: [dep1, dep2],
    }
    let out = marshalLockfile(1, [pkg])
    let alphaAt = strings.indexOf(out, "alpha 0.1.0")
    let zedAt = strings.indexOf(out, "zed 1.0.0")
    match alphaAt {
        Some(a) -> match zedAt {
            Some(z) -> testing.assert(a < z),
            None -> testing.assert(false),
        },
        None -> testing.assert(false),
    }
}
fn testMarshalLockfileVersionTiebreak() {
    // Same name, different versions — version order matters.
    let v110 = LockPackageSpec {
        name: "alpha", version: "1.10.0", source: "", checksum: "", dependencies: [],
    }
    let v90 = LockPackageSpec {
        name: "alpha", version: "1.9.0", source: "", checksum: "", dependencies: [],
    }
    // 1.10.0 sorts BEFORE 1.9.0 lexicographically (1.1 < 1.9).
    let out = marshalLockfile(1, [v90, v110])
    let v110At = strings.indexOf(out, "version = \"1.10.0\"")
    let v90At = strings.indexOf(out, "version = \"1.9.0\"")
    match v110At {
        Some(a) -> match v90At {
            Some(b) -> testing.assert(a < b),
            None -> testing.assert(false),
        },
        None -> testing.assert(false),
    }
}
