    checkRegisterFn(env, CheckFnSig {name: "isInfinite", owner: ownerName, receiverTy: ty, hasReceiver: true, retTy: tBool(tys), paramNames: [], paramTys: [], generics: [], genericBounds: []})
    checkRegisterFn(env, CheckFnSig {name: "isFinite", owner: ownerName, receiverTy: ty, hasReceiver: true, retTy: tBool(tys), paramNames: [], paramTys: [], generics: [], genericBounds: []})
