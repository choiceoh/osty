    let tListR = tyNamed(tys, "List", [tR])
    let tListU_list = tyNamed(tys, "List", [tU_list])
    let tListV_list = tyNamed(tys, "List", [tV_list])
    let tListListT_list = tyNamed(tys, "List", [tListT])
    let tMapKListT = tyNamed(tys, "Map", [tK_list, tListT])
    let tPairTU = tyTuple(tys, [tT, tU_list])
    let tPairIntT = tyTuple(tys, [tInt(tys), tT])
    let tTripleTUV = tyTuple(tys, [tT, tU_list, tV_list])
    let tFnTR = tyFn(tys, [tT], tR)
    let tFnTK = tyFn(tys, [tT], tK_list)
    let tFnTListR = tyFn(tys, [tT], tListR)
    let tFnTA = tyFn(tys, [tA_list, tT], tA_list)
    let tFnTTT = tyFn(tys, [tT, tT], tT)
    checkRegisterFn(env, CheckFnSig {name: "map", owner: "List", receiverTy: tListT, hasReceiver: true, retTy: tListR, paramNames: ["f"], paramTys: [tFnTR], generics: ["T", "R"], genericBounds: []})
