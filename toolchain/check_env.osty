    checkRegisterFn(env, CheckFnSig {name: "sortedBy", owner: "List", receiverTy: tListT, hasReceiver: true, retTy: tListT, paramNames: ["key"], paramTys: [tyFn(tys, [tT], tK_list)], generics: ["T", "K"], genericBounds: [orderedBoundK]})
    checkRegisterFn(env, CheckFnSig {name: "first", owner: "List", receiverTy: tListT, hasReceiver: true, retTy: tOptT, paramNames: [], paramTys: [], generics: ["T"], genericBounds: []})
    checkRegisterFn(env, CheckFnSig {name: "last", owner: "List", receiverTy: tListT, hasReceiver: true, retTy: tOptT, paramNames: [], paramTys: [], generics: ["T"], genericBounds: []})
    let tR = tyNamed(tys, "R", [])
    let tA_list = tyNamed(tys, "A", [])
    let tU_list = tyNamed(tys, "U", [])
