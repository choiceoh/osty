fn lirParityFunction(name: String, retType: String) -> MirFunction {
    let mut fn_ = mirFunction(name, retType, mirNoSpan())
    let ret = mirFunctionNewLocal(fn_, "_return", retType, false, mirNoSpan())
    fn_.returnLocal = ret
    fn_.locals[ret].isReturn = true
    fn_
}
fn lirParityParam(fn_: MirFunction, name: String, typ: String) -> Int {
    let id = mirFunctionNewLocal(fn_, name, typ, false, mirNoSpan())
    fn_.locals[id].isParam = true
    fn_.params.push(id)
    id
}
fn lirParityLocal(fn_: MirFunction, name: String, typ: String) -> Int {
    mirFunctionNewLocal(fn_, name, typ, false, mirNoSpan())
}
fn lirParityEntry(fn_: MirFunction) -> Int {
    let entry = mirFunctionNewBlock(fn_, mirNoSpan())
    fn_.entry = entry
    entry
}
fn lirParityReturnConst(fn_: MirFunction, block: Int, value: Int) {
    mirFunctionAppend(fn_, block, mirAssignInstr(mirPlace(fn_.returnLocal), mirRVUse(mirOperandConst(mirConstInt(value, "Int"))), mirNoSpan()))
    mirFunctionTerminate(fn_, block, mirReturnTerm(mirNoSpan()))
}
fn lirParityModule(functions: List<MirFunction>) -> MirModule {
    let mut m = mirModule("main")
    for fn_ in functions {
        m.functions.push(fn_)
    }
    m
}
fn lirParityField(index: Int, name: String, typ: String) -> MirFieldLayout {
    MirFieldLayout {index, name, typ}
}
fn lirParityStructLayout(name: String, fields: List<MirFieldLayout>) -> MirStructLayout {
    MirStructLayout {name, mangled: name, fields, size: 0, align: 0}
}
fn lirParityTupleLayout(key: String, fields: List<MirFieldLayout>) -> MirTupleLayout {
    MirTupleLayout {key, mangled: key, fields}
}
pub fn lirParityBuildManualModule(name: String) -> MirModule {
    if name == "const_return" {
        return lirParityBuildConstReturnModule()
    }
    if name == "direct_call" {
        return lirParityBuildDirectCallModule()
    }
    if name == "branch" {
        return lirParityBuildBranchModule()
    }
    if name == "switch" {
        return lirParityBuildSwitchModule()
    }
    if name == "println_string" {
        return lirParityBuildPrintlnStringModule()
    }
    if name == "cast_int_resize" {
        return lirParityBuildCastIntResizeModule()
    }
    if name == "cast_float_resize" {
        return lirParityBuildCastFloatResizeModule()
    }
    if name == "cast_int_to_float" {
        return lirParityBuildCastIntToFloatModule()
    }
    if name == "direct_call_arg_coercion" {
        return lirParityBuildDirectCallArgCoercionModule()
    }
    if name == "primitive_int_to_byte" {
        return lirParityBuildPrimitiveIntToByteModule()
    }
    if name == "primitive_byte_to_char" {
        return lirParityBuildPrimitiveByteToCharModule()
    }
    if name == "tuple_literal_read" {
        return lirParityBuildTupleLiteralReadModule()
    }
    if name == "struct_literal_read" {
        return lirParityBuildStructLiteralReadModule()
    }
    if name == "nested_struct_projected_assign" {
        return lirParityBuildNestedProjectedAssignModule()
    }
    if name == "projected_call_result" {
        return lirParityBuildProjectedCallResultModule()
    }
    if name == "projected_intrinsic_result" {
        return lirParityBuildProjectedIntrinsicResultModule()
    }
    mirModule("main")
}
pub fn lirParityBuildConstReturnModule() -> MirModule {
    let mut fn_ = lirParityFunction("answer", "Int")
    let entry = lirParityEntry(fn_)
    lirParityReturnConst(fn_, entry, 42)
    lirParityModule([fn_])
}
pub fn lirParityBuildDirectCallModule() -> MirModule {
    let mut inc = lirParityFunction("inc", "Int")
    let x = lirParityParam(inc, "x", "Int")
    let incEntry = lirParityEntry(inc)
    mirFunctionAppend(inc, incEntry, mirAssignInstr(mirPlace(inc.returnLocal), mirRVBinary(MirBinAdd, mirOperandCopy(mirPlace(x), "Int"), mirOperandConst(mirConstInt(1, "Int")), "Int"), mirNoSpan()))
    mirFunctionTerminate(inc, incEntry, mirReturnTerm(mirNoSpan()))
    let mut main = lirParityFunction("main", "Int")
    let mainEntry = lirParityEntry(main)
    mirFunctionAppend(main, mainEntry, mirCallInstr(true, mirPlace(main.returnLocal), "inc", "(Int)->Int", [mirOperandConst(mirConstInt(41, "Int"))], mirNoSpan()))
    mirFunctionTerminate(main, mainEntry, mirReturnTerm(mirNoSpan()))
    lirParityModule([inc, main])
}
pub fn lirParityBuildBranchModule() -> MirModule {
    let mut fn_ = lirParityFunction("choose", "Int")
    let cond = lirParityParam(fn_, "ok", "Bool")
    let entry = lirParityEntry(fn_)
    let thenBlock = mirFunctionNewBlock(fn_, mirNoSpan())
    let elseBlock = mirFunctionNewBlock(fn_, mirNoSpan())
    mirFunctionTerminate(fn_, entry, mirBranchTerm(mirOperandCopy(mirPlace(cond), "Bool"), thenBlock, elseBlock, mirNoSpan()))
    lirParityReturnConst(fn_, thenBlock, 1)
    lirParityReturnConst(fn_, elseBlock, 2)
    lirParityModule([fn_])
}
pub fn lirParityBuildSwitchModule() -> MirModule {
    let mut fn_ = lirParityFunction("pick", "Int")
    let n = lirParityParam(fn_, "n", "Int")
    let entry = lirParityEntry(fn_)
    let zero = mirFunctionNewBlock(fn_, mirNoSpan())
    let one = mirFunctionNewBlock(fn_, mirNoSpan())
    let default = mirFunctionNewBlock(fn_, mirNoSpan())
    mirFunctionTerminate(fn_, entry, mirSwitchIntTerm(mirOperandCopy(mirPlace(n), "Int"), [mirSwitchCase(0, zero, "zero"), mirSwitchCase(1, one, "one")], default, mirNoSpan()))
    lirParityReturnConst(fn_, zero, 10)
    lirParityReturnConst(fn_, one, 20)
    lirParityReturnConst(fn_, default, 30)
    lirParityModule([fn_])
}
pub fn lirParityBuildPrintlnStringModule() -> MirModule {
    let mut fn_ = lirParityFunction("main", "Unit")
    let entry = lirParityEntry(fn_)
    mirFunctionAppend(fn_, entry, mirIntrinsicInstr(false, mirPlace(-1), MirIntrinsicPrintln, [mirOperandConst(mirConstString("hello"))], mirNoSpan()))
    mirFunctionTerminate(fn_, entry, mirReturnTerm(mirNoSpan()))
    lirParityModule([fn_])
}
pub fn lirParityBuildCastIntResizeModule() -> MirModule {
    let mut fn_ = lirParityFunction("widen", "Int")
    let entry = lirParityEntry(fn_)
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(fn_.returnLocal), mirRVCast(MirCastIntResize, mirOperandConst(mirConstInt(7, "Int32")), "Int32", "Int"), mirNoSpan()))
    mirFunctionTerminate(fn_, entry, mirReturnTerm(mirNoSpan()))
    lirParityModule([fn_])
}
