pub fn lirParitySourcePrintlnIntFixture() -> LirParityFixture {
    lirParityFixture("source_println_int_runtime_abi", LirParitySource, "/tmp/lir_proto_source_println_int.osty", "fn say() \{\n    println(7)\n\}\n", "source-parity", ["source", "print", "runtime", "lir-only"], [lirParityNeedle("declare ptr @osty_rt_int_to_string(i64)", "integer string conversion runtime"), lirParityNeedle("declare void @osty_rt_io_write(ptr, i1, i1)", "io runtime"), lirParityNeedle("call ptr @osty_rt_int_to_string(i64 7)", "string conversion call"), lirParityNeedle("call void @osty_rt_io_write", "print call")])
