    let entry = lirParityEntry(fn_)
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(fn_.returnLocal), mirRVCast(MirCastFloatResize, mirOperandConst(mirConstFloat("1.5", "Float")), "Float", "Float32"), mirNoSpan()))
    mirFunctionTerminate(fn_, entry, mirReturnTerm(mirNoSpan()))
    lirParityModule([fn_])
}
pub fn lirParityBuildCastIntToFloatModule() -> MirModule {
    let mut fn_ = lirParityFunction("toFloat", "Float")
    let entry = lirParityEntry(fn_)
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(fn_.returnLocal), mirRVCast(MirCastIntToFloat, mirOperandConst(mirConstInt(7, "Int")), "Int", "Float"), mirNoSpan()))
    mirFunctionTerminate(fn_, entry, mirReturnTerm(mirNoSpan()))
    lirParityModule([fn_])
