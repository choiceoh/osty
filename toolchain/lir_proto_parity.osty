// lir_proto_parity.osty - Osty-owned parity fixture catalog for LIR Proto.
//
// The deleted prototype kept parity expectations outside the Osty source.
// This catalog keeps the same shape-critical expectations next to the
// self-hosted LIR surface so fixture ownership moves with the implementation.
use std.strings as strings
pub enum LirParityFixtureKind {
    LirParityManualMIR,
    LirParitySource,
}
pub struct LirParityNeedle {
    pub text: String,
    pub note: String,
}
pub fn lirParityNeedle(text: String, note: String) -> LirParityNeedle {
    LirParityNeedle {text, note}
}
pub struct LirParityFixture {
    pub name: String,
    pub kind: LirParityFixtureKind,
    pub sourcePath: String,
    pub source: String,
    pub phase: String,
    pub tags: List<String>,
    pub needles: List<LirParityNeedle>,
}
pub fn lirParityFixture(name: String, kind: LirParityFixtureKind, sourcePath: String, source: String, phase: String, tags: List<String>, needles: List<LirParityNeedle>) -> LirParityFixture {
    LirParityFixture {name, kind, sourcePath, source, phase, tags, needles}
}
pub fn lirParityNeedleTexts(fixture: LirParityFixture) -> List<String> {
    let mut out: List<String> = []
    for needle in fixture.needles {
        out.push(needle.text)
    }
    out
}
pub fn lirParityFixtureNames(fixtures: List<LirParityFixture>) -> List<String> {
    let mut out: List<String> = []
    for fixture in fixtures {
        out.push(fixture.name)
    }
    out
}
pub fn lirParityFindMissing(rendered: String, fixture: LirParityFixture) -> List<String> {
    let mut missing: List<String> = []
    for needle in fixture.needles {
        if !(strings.contains(rendered, needle.text)) {
            missing.push(needle.text)
        }
    }
    missing
}
pub fn lirParityRenderMissingReport(label: String, fixture: LirParityFixture, missing: List<String>) -> String {
    if missing.len() == 0 {
        return label + " " + fixture.name + ": ok"
    }
    label + " " + fixture.name + ": missing " + strings.join(missing, " | ")
}
pub struct LirParityCheckResult {
    pub label: String,
    pub fixtureName: String,
    pub ok: Bool,
    pub missing: List<String>,
    pub diagnostics: List<LirDiagnostic>,
    pub rendered: String,
}
pub fn lirParityCheckResult(label: String, fixtureName: String, missing: List<String>, diagnostics: List<LirDiagnostic>, rendered: String) -> LirParityCheckResult {
    LirParityCheckResult {label, fixtureName, ok: missing.len() == 0 && diagnostics.len() == 0, missing, diagnostics, rendered}
}
pub fn lirParityCheckRendered(label: String, fixture: LirParityFixture, rendered: String) -> LirParityCheckResult {
    lirParityCheckResult(label, fixture.name, lirParityFindMissing(rendered, fixture), [], rendered)
}
pub fn lirParityCheckManualFixture(cfg: LirLowerConfig, fixture: LirParityFixture) -> LirParityCheckResult {
    let mut diags: List<LirDiagnostic> = []
    if fixture.kind != LirParityManualMIR {
        diags.push(lirDiagnosticError(LirDiagInvalidInput, "fixture is not a manual MIR parity fixture", fixture.name))
        return lirParityCheckResult("lir", fixture.name, [], diags, "")
    }
    let mut lowerCfg = lirLowerConfigCopy(cfg)
    if lowerCfg.packageName == "" {
        lowerCfg.packageName = "main"
    }
    if lowerCfg.sourcePath == "" {
        lowerCfg.sourcePath = fixture.sourcePath
    }
    let lowered = lirLowererLowerMIR(lirNewLowerer(lowerCfg), lirParityBuildManualModule(fixture.name))
    for d in lowered.diagnostics {
        diags.push(d)
    }
    if lirLowerHasErrors(lowered) {
        return lirParityCheckResult("lir", fixture.name, [], diags, "")
    }
    let rendered = lirRenderModule(lowered.module)
    lirParityCheckResult("lir", fixture.name, lirParityFindMissing(rendered, fixture), diags, rendered)
}
pub fn lirParityCheckManualFixtures(cfg: LirLowerConfig, fixtures: List<LirParityFixture>) -> List<LirParityCheckResult> {
    let mut out: List<LirParityCheckResult> = []
    for fixture in fixtures {
        out.push(lirParityCheckManualFixture(cfg, fixture))
    }
    out
}
pub fn lirParityCheckAllManual(cfg: LirLowerConfig) -> List<LirParityCheckResult> {
    lirParityCheckManualFixtures(cfg, lirParityManualMIRFixtures())
}
pub fn lirParityChecksOK(results: List<LirParityCheckResult>) -> Bool {
    for result in results {
        if !(result.ok) {
            return false
        }
    }
    true
}
pub fn lirParityCheckReport(result: LirParityCheckResult) -> String {
    if result.ok {
        return result.label + " " + result.fixtureName + ": ok"
    }
    let mut parts: List<String> = []
    for d in result.diagnostics {
        parts.push(lirDiagnosticRender(d))
    }
    for missing in result.missing {
        parts.push("missing " + missing)
    }
    if parts.len() == 0 {
        parts.push("failed")
    }
    result.label + " " + result.fixtureName + ": " + strings.join(parts, " | ")
}
pub fn lirParityCheckReports(results: List<LirParityCheckResult>) -> List<String> {
    let mut out: List<String> = []
    for result in results {
        out.push(lirParityCheckReport(result))
    }
    out
}
pub fn lirParityCheckSummary(results: List<LirParityCheckResult>) -> String {
    strings.join(lirParityCheckReports(results), "\n")
}
pub fn lirParityBuiltinFixtures() -> List<LirParityFixture> {
    let mut out: List<LirParityFixture> = []
    for fixture in lirParityManualMIRFixtures() {
        out.push(fixture)
    }
    for fixture in lirParitySourceFixtures() {
        out.push(fixture)
    }
    out
}
pub fn lirParityManualMIRFixtures() -> List<LirParityFixture> {
    [lirParityManualConstReturnFixture(), lirParityManualDirectCallFixture(), lirParityManualBranchFixture(), lirParityManualSwitchFixture(), lirParityManualPrintlnStringFixture(), lirParityManualCastIntResizeFixture(), lirParityManualCastFloatResizeFixture(), lirParityManualCastIntToFloatFixture(), lirParityManualDirectCallArgCoercionFixture(), lirParityManualPrimitiveIntToByteFixture(), lirParityManualPrimitiveByteToCharFixture(), lirParityManualTupleLiteralReadFixture(), lirParityManualStructLiteralReadFixture(), lirParityManualNestedProjectedAssignFixture(), lirParityManualProjectedCallResultFixture(), lirParityManualProjectedIntrinsicResultFixture()]
}
