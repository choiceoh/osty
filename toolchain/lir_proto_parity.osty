pub fn lirParityBuildConstReturnModule() -> MirModule {
    let mut fn_ = lirParityFunction("answer", "Int")
    let entry = lirParityEntry(fn_)
    lirParityReturnConst(fn_, entry, 42)
    lirParityModule([fn_])
}
pub fn lirParityBuildDirectCallModule() -> MirModule {
    let mut inc = lirParityFunction("inc", "Int")
    let x = lirParityParam(inc, "x", "Int")
    let incEntry = lirParityEntry(inc)
    mirFunctionAppend(inc, incEntry, mirAssignInstr(mirPlace(inc.returnLocal), mirRVBinary(MirBinAdd, mirOperandCopy(mirPlace(x), "Int"), mirOperandConst(mirConstInt(1, "Int")), "Int"), mirNoSpan()))
    mirFunctionTerminate(inc, incEntry, mirReturnTerm(mirNoSpan()))
    let mut main = lirParityFunction("main", "Int")
    let mainEntry = lirParityEntry(main)
    mirFunctionAppend(main, mainEntry, mirCallInstr(true, mirPlace(main.returnLocal), "inc", "(Int)->Int", [mirOperandConst(mirConstInt(41, "Int"))], mirNoSpan()))
    mirFunctionTerminate(main, mainEntry, mirReturnTerm(mirNoSpan()))
    lirParityModule([inc, main])
}
pub fn lirParityBuildBranchModule() -> MirModule {
    let mut fn_ = lirParityFunction("choose", "Int")
    let cond = lirParityParam(fn_, "ok", "Bool")
    let entry = lirParityEntry(fn_)
    let thenBlock = mirFunctionNewBlock(fn_, mirNoSpan())
    let elseBlock = mirFunctionNewBlock(fn_, mirNoSpan())
    mirFunctionTerminate(fn_, entry, mirBranchTerm(mirOperandCopy(mirPlace(cond), "Bool"), thenBlock, elseBlock, mirNoSpan()))
    lirParityReturnConst(fn_, thenBlock, 1)
    lirParityReturnConst(fn_, elseBlock, 2)
    lirParityModule([fn_])
}
pub fn lirParityBuildSwitchModule() -> MirModule {
    let mut fn_ = lirParityFunction("pick", "Int")
    let n = lirParityParam(fn_, "n", "Int")
    let entry = lirParityEntry(fn_)
    let zero = mirFunctionNewBlock(fn_, mirNoSpan())
    let one = mirFunctionNewBlock(fn_, mirNoSpan())
    let default = mirFunctionNewBlock(fn_, mirNoSpan())
    mirFunctionTerminate(fn_, entry, mirSwitchIntTerm(mirOperandCopy(mirPlace(n), "Int"), [mirSwitchCase(0, zero, "zero"), mirSwitchCase(1, one, "one")], default, mirNoSpan()))
    lirParityReturnConst(fn_, zero, 10)
    lirParityReturnConst(fn_, one, 20)
    lirParityReturnConst(fn_, default, 30)
    lirParityModule([fn_])
}
pub fn lirParityBuildPrintlnStringModule() -> MirModule {
    let mut fn_ = lirParityFunction("main", "Unit")
    let entry = lirParityEntry(fn_)
    mirFunctionAppend(fn_, entry, mirIntrinsicInstr(false, mirPlace(-1), MirIntrinsicPrintln, [mirOperandConst(mirConstString("hello"))], mirNoSpan()))
    mirFunctionTerminate(fn_, entry, mirReturnTerm(mirNoSpan()))
    lirParityModule([fn_])
}
