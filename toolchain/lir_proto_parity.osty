pub fn lirParityBuildTupleLiteralReadModule() -> MirModule {
    let tupleName = "Tuple.i64.i64"
    let mut fn_ = lirParityFunction("pack", "Int")
    let tupleLocal = lirParityLocal(fn_, "t", tupleName)
    let entry = lirParityEntry(fn_)
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(tupleLocal), mirRVAggregate(MirAggTuple, [mirOperandConst(mirConstInt(1, "Int")), mirOperandConst(mirConstInt(2, "Int"))], tupleName), mirNoSpan()))
    let left = mirOperandCopy(mirPlaceProject(mirPlace(tupleLocal), mirTupleProj(0, "Int")), "Int")
    let right = mirOperandCopy(mirPlaceProject(mirPlace(tupleLocal), mirTupleProj(1, "Int")), "Int")
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(fn_.returnLocal), mirRVBinary(MirBinAdd, left, right, "Int"), mirNoSpan()))
    mirFunctionTerminate(fn_, entry, mirReturnTerm(mirNoSpan()))
    let mut m = lirParityModule([fn_])
    m.layouts.tuples.push(lirParityTupleLayout(tupleName, [lirParityField(0, "0", "Int"), lirParityField(1, "1", "Int")]))
    m
}
pub fn lirParityBuildStructLiteralReadModule() -> MirModule {
    let mut fn_ = lirParityFunction("sum", "Int")
    let pointLocal = lirParityLocal(fn_, "p", "Point")
    let entry = lirParityEntry(fn_)
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(pointLocal), mirRVAggregate(MirAggStruct, [mirOperandConst(mirConstInt(1, "Int")), mirOperandConst(mirConstInt(2, "Int"))], "Point"), mirNoSpan()))
    let left = mirOperandCopy(mirPlaceProject(mirPlace(pointLocal), mirFieldProj(0, "x", "Int")), "Int")
    let right = mirOperandCopy(mirPlaceProject(mirPlace(pointLocal), mirFieldProj(1, "y", "Int")), "Int")
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(fn_.returnLocal), mirRVBinary(MirBinAdd, left, right, "Int"), mirNoSpan()))
    mirFunctionTerminate(fn_, entry, mirReturnTerm(mirNoSpan()))
    let mut m = lirParityModule([fn_])
    m.layouts.structs.push(lirParityStructLayout("Point", [lirParityField(0, "x", "Int"), lirParityField(1, "y", "Int")]))
    m
}
pub fn lirParityBuildNestedProjectedAssignModule() -> MirModule {
    let mut fn_ = lirParityFunction("update", "Int")
    let innerLocal = lirParityLocal(fn_, "inner", "Inner")
    let outerLocal = lirParityLocal(fn_, "outer", "Outer")
    let entry = lirParityEntry(fn_)
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(innerLocal), mirRVAggregate(MirAggStruct, [mirOperandConst(mirConstInt(0, "Int"))], "Inner"), mirNoSpan()))
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(outerLocal), mirRVAggregate(MirAggStruct, [mirOperandCopy(mirPlace(innerLocal), "Inner"), mirOperandConst(mirConstInt(1, "Int"))], "Outer"), mirNoSpan()))
    let nested = mirPlaceProject(mirPlaceProject(mirPlace(outerLocal), mirFieldProj(0, "inner", "Inner")), mirFieldProj(0, "value", "Int"))
    mirFunctionAppend(fn_, entry, mirAssignInstr(nested, mirRVUse(mirOperandConst(mirConstInt(42, "Int"))), mirNoSpan()))
    let left = mirOperandCopy(nested, "Int")
    let right = mirOperandCopy(mirPlaceProject(mirPlace(outerLocal), mirFieldProj(1, "flag", "Int")), "Int")
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(fn_.returnLocal), mirRVBinary(MirBinAdd, left, right, "Int"), mirNoSpan()))
    mirFunctionTerminate(fn_, entry, mirReturnTerm(mirNoSpan()))
    let mut m = lirParityModule([fn_])
    m.layouts.structs.push(lirParityStructLayout("Inner", [lirParityField(0, "value", "Int")]))
    m.layouts.structs.push(lirParityStructLayout("Outer", [lirParityField(0, "inner", "Inner"), lirParityField(1, "flag", "Int")]))
    m
}
pub fn lirParityBuildProjectedCallResultModule() -> MirModule {
    let mut makeValue = lirParityFunction("makeValue", "Int")
    let makeEntry = lirParityEntry(makeValue)
    lirParityReturnConst(makeValue, makeEntry, 7)
    let mut fill = lirParityFunction("fill", "Int")
    let cellLocal = lirParityLocal(fill, "cell", "Cell")
    let fillEntry = lirParityEntry(fill)
    mirFunctionAppend(fill, fillEntry, mirAssignInstr(mirPlace(cellLocal), mirRVAggregate(MirAggStruct, [mirOperandConst(mirConstInt(0, "Int")), mirOperandConst(mirConstInt(1, "Int"))], "Cell"), mirNoSpan()))
    let valuePlace = mirPlaceProject(mirPlace(cellLocal), mirFieldProj(0, "value", "Int"))
    mirFunctionAppend(fill, fillEntry, mirCallInstr(true, valuePlace, "makeValue", "()->Int", [], mirNoSpan()))
    let left = mirOperandCopy(valuePlace, "Int")
    let right = mirOperandCopy(mirPlaceProject(mirPlace(cellLocal), mirFieldProj(1, "other", "Int")), "Int")
    mirFunctionAppend(fill, fillEntry, mirAssignInstr(mirPlace(fill.returnLocal), mirRVBinary(MirBinAdd, left, right, "Int"), mirNoSpan()))
    mirFunctionTerminate(fill, fillEntry, mirReturnTerm(mirNoSpan()))
    let mut m = lirParityModule([makeValue, fill])
    m.layouts.structs.push(lirParityStructLayout("Cell", [lirParityField(0, "value", "Int"), lirParityField(1, "other", "Int")]))
    m
}
pub fn lirParityBuildProjectedIntrinsicResultModule() -> MirModule {
    let mut fn_ = lirParityFunction("fillIntrinsic", "Int")
    let cellLocal = lirParityLocal(fn_, "cell", "Cell")
    let byteLocal = lirParityParam(fn_, "b", "Byte")
    let entry = lirParityEntry(fn_)
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(cellLocal), mirRVAggregate(MirAggStruct, [mirOperandConst(mirConstInt(0, "Int")), mirOperandConst(mirConstInt(1, "Int"))], "Cell"), mirNoSpan()))
    let valuePlace = mirPlaceProject(mirPlace(cellLocal), mirFieldProj(0, "value", "Int"))
    mirFunctionAppend(fn_, entry, mirIntrinsicInstr(true, valuePlace, MirIntrinsicByteToInt, [mirOperandCopy(mirPlace(byteLocal), "Byte")], mirNoSpan()))
    let left = mirOperandCopy(valuePlace, "Int")
    let right = mirOperandCopy(mirPlaceProject(mirPlace(cellLocal), mirFieldProj(1, "other", "Int")), "Int")
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(fn_.returnLocal), mirRVBinary(MirBinAdd, left, right, "Int"), mirNoSpan()))
    mirFunctionTerminate(fn_, entry, mirReturnTerm(mirNoSpan()))
    let mut m = lirParityModule([fn_])
    m.layouts.structs.push(lirParityStructLayout("Cell", [lirParityField(0, "value", "Int"), lirParityField(1, "other", "Int")]))
    m
}
