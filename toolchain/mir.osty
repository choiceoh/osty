    }
    if op == MirBinBitXor {
        return "bit_xor"
    }
    if op == MirBinShl {
        return "shl"
    }
    if op == MirBinShr {
        return "shr"
    }
    "invalid"
}
// B2: payload-less enum dispatch as if-else chain (stage0 P0–P15).
pub fn mirOperandKindName(k: MirOperandKind) -> String {
    if k == MirOpCopy {
        return "copy"
    }
    if k == MirOpMove {
        return "move"
    }
    if k == MirOpConst {
        return "const"
    }
    "invalid"
}
