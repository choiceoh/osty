// B2: payload-less enum dispatch as if-else chain (stage0 P0–P15).
// ====================================================================
// Formatting helpers
// ====================================================================
fn mirIndent(level: Int) -> String {
    let mut out = ""
    for _i in 0..level {
        out = out + "    "
    }
    out
}
/// mirIntToString formats an integer using base-10 digits. Kept as a
/// local helper so the MIR printer does not depend on any stdlib
/// conversion that may not be available in early bootstrap.
fn mirIntToString(n: Int) -> String {
    if n == 0 {
        return "0"
    }
    let mut value = n
    let mut negative = false
    if value < 0 {
        negative = true
        value = -value
    }
    let mut digits: List<Int> = []
    for _d in 0..40 {
        if value == 0 {
            break
        }
        digits.push(value % 10)
        value = value / 10
    }
    let mut out = ""
    if negative {
        out = "-"
    }
    let mut i = digits.len() - 1
    for _j in 0..digits.len() {
        if i < 0 {
            break
        }
        out = out + mirDigitChar(digits[i])
        i = i - 1
    }
    out
}
fn mirDigitChar(d: Int) -> String {
    if d == 0 {
        return "0"
    }
    if d == 1 {
        return "1"
    }
    if d == 2 {
        return "2"
    }
    if d == 3 {
        return "3"
    }
    if d == 4 {
        return "4"
    }
    if d == 5 {
        return "5"
    }
    if d == 6 {
        return "6"
    }
    if d == 7 {
        return "7"
    }
    if d == 8 {
        return "8"
    }
    if d == 9 {
        return "9"
    }
    "?"
}
