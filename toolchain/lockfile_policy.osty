/// Pure `osty.lock` Dependency surface — the `name version (source)`
/// canonical string and its inverse parser. The lockfile generator
/// uses this to emit deterministic single-line dependency entries
/// the human-edited form can round-trip through.
///
/// Host code (`internal/lockfile`) owns the multi-line lockfile
/// document, TOML parsing, and filesystem I/O; this module decides
/// the per-entry string shape.
///
/// Mirrored by `internal/runner/lockfile_policy.go`. The drift
/// test under internal/runner keeps the two in sync — the Osty
/// file is the source of truth at review time.
use std.bytes as bytes
use std.strings as strings
/// DependencyParts is the outcome of parsing a single dependency
/// line back into its `(name, version, source)` triple. `ok ==
/// false` signals a malformed shape so the host emits a precise
/// `invalid dependency "..."` diagnostic. `source == ""` means the
/// dependency came from the default registry — no `( ... )` was
/// appended.
pub struct DependencyParts {
    pub name: String,
    pub version: String,
    pub source: String,
    pub ok: Bool,
}
/// dependencyString renders one lockfile entry as the canonical
/// single-line form:
///
///   - `<name> <version>` when source is empty (default registry).
///   - `<name> <version> (<source>)` otherwise (path/git/custom
///     registry).
///
/// The whitespace separator + parenthesised source format is what
/// the parser below understands; keep the two in lockstep.
pub fn dependencyString(name: String, version: String, source: String) -> String {
    if source == "" {
        return name + " " + version
    }
    name + " " + version + " (" + source + ")"
}
/// parseDependency is the inverse of `dependencyString`. Accepts:
///
///   - `name version`
///   - `name version (source)`  — `source` may itself contain
///     whitespace; only the trailing `)` closes the group.
///
/// Returns `ok == false` for anything else (wrong field count,
/// missing closing paren, etc.). The host blames the malformed
/// line with `invalid dependency "..."`.
pub fn parseDependency(line: String) -> DependencyParts {
    let trimmed = strings.trimSpace(line)
    let mut head = trimmed
    let mut source = ""
    if strings.hasSuffix(trimmed, ")") {
        let openOpt = strings.indexOf(trimmed, "(")
        match openOpt {
            Some(open) -> {
                if open > 0 {
                    source = strings.slice(trimmed, open + 1, trimmed.len() - 1)
                    head = strings.trimSpace(strings.slice(trimmed, 0, open))
                }
            },
            None -> {
            },
        }
    }
    let parts = parseDependencyFields(head)
    if parts.len() != 2 {
        return DependencyParts {name: "", version: "", source: "", ok: false}
    }
    DependencyParts {name: parts[0], version: parts[1], source: source, ok: true}
}
/// parseDependencyFields splits `head` on runs of ASCII space /
/// tab (matches Go's `strings.Fields` for the limited alphabet
/// the lockfile lexer accepts — dependency names and versions
/// never carry CR/LF/VT/FF). Empty runs are dropped so callers
/// see exactly the non-whitespace tokens.
fn parseDependencyFields(head: String) -> List<String> {
    let bs = head.bytes()
    let n = bs.len()
    let mut out: List<String> = []
    let mut start = -1
    let mut i = 0
    for i < n {
        let b = bs[i].toInt()
        let isWS = b == 0x20 || b == 0x09
        if isWS {
            if start >= 0 {
                out.push(strings.slice(head, start, i))
                start = -1
            }
        } else if start < 0 {
            start = i
        }
        i = i + 1
    }
    if start >= 0 {
        out.push(strings.slice(head, start, n))
    }
    out
}
/// LockDepSpec is one in-memory dependency entry the host hands
/// to `marshalLockfile`. Fields mirror `internal/lockfile.Dependency`;
/// the marshaller renders each entry via `dependencyString`.
pub struct LockDepSpec {
    pub name: String,
    pub version: String,
    pub source: String,
}
/// LockPackageSpec is one in-memory lockfile package the host
/// hands to `marshalLockfile`. `source` and `checksum` are empty
/// strings when absent (path sources skip checksum); the marshaller
/// omits the corresponding lines.
pub struct LockPackageSpec {
    pub name: String,
    pub version: String,
    pub source: String,
    pub checksum: String,
    pub dependencies: List<LockDepSpec>,
}
/// marshalLockfile renders a complete osty.lock document as TOML
/// bytes. The output is deterministic: packages are sorted by
/// (name, version) and dependencies within each package by
/// (name, version) so diffs are small.
///
/// Mirrors the contract of `internal/lockfile.Marshal`: same
/// header, same field order, same `tomlBasicString` (Go `%q`)
/// quoting on ASCII inputs.
pub fn marshalLockfile(version: Int, packages: List<LockPackageSpec>) -> String {
    let mut out: List<String> = []
    out.push("# This file is auto-generated by osty.\n")
    out.push("# Do not edit manually; `osty update` regenerates it.\n\n")
    out.push("version = {version}\n")
    let sortedPkgs = sortLockPackages(packages)
    for p in sortedPkgs {
        out.push("\n[[package]]\n")
        out.push("name = ")
        out.push(tomlBasicString(p.name))
        out.push("\n")
        out.push("version = ")
        out.push(tomlBasicString(p.version))
        out.push("\n")
        if p.source != "" {
            out.push("source = ")
            out.push(tomlBasicString(p.source))
            out.push("\n")
        }
        if p.checksum != "" {
            out.push("checksum = ")
            out.push(tomlBasicString(p.checksum))
            out.push("\n")
        }
        if p.dependencies.len() > 0 {
            let sortedDeps = sortLockDeps(p.dependencies)
            out.push("dependencies = [\n")
            for d in sortedDeps {
                out.push("    ")
                out.push(tomlBasicString(dependencyString(d.name, d.version, d.source)))
                out.push(",\n")
            }
            out.push("]\n")
        }
    }
    strings.join(out, "")
}
/// sortLockPackages returns packages sorted by the same (name, version)
/// tuple as Go's lockfile marshaller. It is intentionally specialized
/// instead of using `sortedBy`: stage0 self-hosting must lower this file
/// before closure/generic higher-order calls are fully available.
fn sortLockPackages(packages: List<LockPackageSpec>) -> List<LockPackageSpec> {
    let mut out: List<LockPackageSpec> = []
    for item in packages {
        out.push(item)
    }
    let mut i = 0
    for i < out.len() {
        let mut best = i
        let mut j = i + 1
        for j < out.len() {
            if lockSortKey(out[j].name, out[j].version) < lockSortKey(out[best].name, out[best].version) {
                best = j
            }
            j = j + 1
        }
        if best != i {
            let tmp = out[i]
            out[i] = out[best]
            out[best] = tmp
        }
        i = i + 1
    }
    out
}
/// sortLockDeps is the dependency equivalent of `sortLockPackages`.
fn sortLockDeps(deps: List<LockDepSpec>) -> List<LockDepSpec> {
    let mut out: List<LockDepSpec> = []
    for item in deps {
        out.push(item)
    }
    let mut i = 0
    for i < out.len() {
        let mut best = i
        let mut j = i + 1
        for j < out.len() {
            if lockSortKey(out[j].name, out[j].version) < lockSortKey(out[best].name, out[best].version) {
                best = j
            }
            j = j + 1
        }
        if best != i {
            let tmp = out[i]
            out[i] = out[best]
            out[best] = tmp
        }
        i = i + 1
    }
    out
}
/// lockSortKey concatenates name + NUL + version so a single
/// lexicographic Ordered key matches the (Name, Version) tuple
/// sort used by Go's sort.SliceStable.
fn lockSortKey(name: String, version: String) -> String {
    name + "\u{00}" + version
}
/// tomlBasicString renders `s` as a TOML basic (double-quoted)
/// string with Go `%q` escape semantics on the ASCII range:
///
///   - `"`         → `\"`
///   - `\`         → `\\`
///   - `\a/\b/\t/\n/\v/\f/\r` → named escapes
///   - 0x20-0x7E (other than `"` and `\`) → literal byte
///   - other 0x00-0x1F or 0x7F → `\xNN` (two lowercase hex digits)
///   - 0x80+      → literal byte (UTF-8 passthrough)
///
/// Used by `marshalLockfile`; safe for any input the manifest /
/// lockfile pipeline actually surfaces (all-ASCII package names,
/// SemVer versions, URLs, checksums). High bytes (0x80+) pass
/// through verbatim — multi-byte UTF-8 stays intact byte-for-byte
/// like Go's `b.WriteByte(c)`. Building the result as `List<Byte>`
/// and converting at the end (mirrors `std.json`'s escape pattern)
/// is what guarantees no accidental `Byte→Char→UTF-8` re-encoding.
pub fn tomlBasicString(s: String) -> String {
    let bs = s.bytes()
    let n = bs.len()
    let mut buf: List<Byte> = []
    buf.push(0x22.toByte())
    let mut i = 0
    for i < n {
        let b = bs[i]
        let c = b.toInt()
        if c == 0x22 {
            tomlPushAscii(buf, "\\\"")
        } else if c == 0x5C {
            tomlPushAscii(buf, "\\\\")
        } else if c == 0x07 {
            tomlPushAscii(buf, "\\a")
        } else if c == 0x08 {
            tomlPushAscii(buf, "\\b")
        } else if c == 0x09 {
            tomlPushAscii(buf, "\\t")
        } else if c == 0x0A {
            tomlPushAscii(buf, "\\n")
        } else if c == 0x0B {
            tomlPushAscii(buf, "\\v")
        } else if c == 0x0C {
            tomlPushAscii(buf, "\\f")
        } else if c == 0x0D {
            tomlPushAscii(buf, "\\r")
        } else if c >= 0x20 && c <= 0x7E {
            buf.push(b)
        } else if c < 0x20 || c == 0x7F {
            tomlPushAscii(buf, "\\x")
            tomlPushHexNibble(buf, (c >> 4) & 0xF)
            tomlPushHexNibble(buf, c & 0xF)
        } else {
            // 0x80+: raw UTF-8 continuation / leading byte. Push the
            // byte unchanged so a multi-byte sequence in `s` survives
            // intact instead of being transcoded through Char.
            buf.push(b)
        }
        i = i + 1
    }
    buf.push(0x22.toByte())
    bytes.toString(bytes.from(buf)).unwrap()
}
/// tomlPushAscii appends each byte of an ASCII string `s` to `buf`.
/// `s` is assumed to be ASCII-only — the escape literals emitted by
/// `tomlBasicString` all are.
fn tomlPushAscii(buf: List<Byte>, s: String) {
    let bs = s.bytes()
    let n = bs.len()
    let mut i = 0
    for i < n {
        buf.push(bs[i])
        i = i + 1
    }
}
/// tomlPushHexNibble writes the lowercase ASCII hex digit for the
/// 4-bit value `n` (0-15). Used twice per `\xNN` escape inside
/// `tomlBasicString`.
fn tomlPushHexNibble(buf: List<Byte>, n: Int) {
    let code = if n < 10 { 0x30 + n } else { 0x61 + (n - 10) }
    buf.push(code.toByte())
}
