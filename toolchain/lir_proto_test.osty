fn testLirProtoLowerMirNestedProjectedAssignOstyOwned() {
    let mut fn_ = lirTestFunction("update", "Int")
    let innerLocal = lirTestAddLocal(fn_, "inner", "Inner")
    let outerLocal = lirTestAddLocal(fn_, "outer", "Outer")
    let entry = lirTestEntryBlock(fn_)
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(innerLocal), mirRVAggregate(MirAggStruct, [mirOperandConst(mirConstInt(0, "Int"))], "Inner"), mirNoSpan()))
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(outerLocal), mirRVAggregate(MirAggStruct, [mirOperandCopy(mirPlace(innerLocal), "Inner"), mirOperandConst(mirConstInt(1, "Int"))], "Outer"), mirNoSpan()))
    let nested = mirPlaceProject(mirPlaceProject(mirPlace(outerLocal), mirFieldProj(0, "inner", "Inner")), mirFieldProj(0, "value", "Int"))
    mirFunctionAppend(fn_, entry, mirAssignInstr(nested, mirRVUse(mirOperandConst(mirConstInt(42, "Int"))), mirNoSpan()))
    let left = mirOperandCopy(nested, "Int")
    let right = mirOperandCopy(mirPlaceProject(mirPlace(outerLocal), mirFieldProj(1, "flag", "Int")), "Int")
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(fn_.returnLocal), mirRVBinary(MirBinAdd, left, right, "Int"), mirNoSpan()))
    mirFunctionTerminate(fn_, entry, mirReturnTerm(mirNoSpan()))
    let mut m = lirTestModule([fn_])
    m.layouts.structs.push(lirTestStructLayout("Inner", [lirTestField(0, "value", "Int")]))
    m.layouts.structs.push(lirTestStructLayout("Outer", [lirTestField(0, "inner", "Inner"), lirTestField(1, "flag", "Int")]))
    assertLirLoweredContains(m, ["%Inner = type \{ i64 \}", "%Outer = type \{ %Inner, i64 \}", "extractvalue %Outer", "insertvalue %Inner", "insertvalue %Outer", "store %Outer"])
}
fn testLirProtoLowerMirProjectedCallAndIntrinsicResultsOstyOwned() {
    let mut makeValue = lirTestFunction("makeValue", "Int")
    let makeEntry = lirTestEntryBlock(makeValue)
    mirFunctionAppend(makeValue, makeEntry, mirAssignInstr(mirPlace(makeValue.returnLocal), mirRVUse(mirOperandConst(mirConstInt(7, "Int"))), mirNoSpan()))
    mirFunctionTerminate(makeValue, makeEntry, mirReturnTerm(mirNoSpan()))
    let mut fill = lirTestFunction("fill", "Int")
    let cellLocal = lirTestAddLocal(fill, "cell", "Cell")
    let byteLocal = lirTestAddParam(fill, "b", "Byte")
    let fillEntry = lirTestEntryBlock(fill)
    mirFunctionAppend(fill, fillEntry, mirAssignInstr(mirPlace(cellLocal), mirRVAggregate(MirAggStruct, [mirOperandConst(mirConstInt(0, "Int")), mirOperandConst(mirConstInt(1, "Int"))], "Cell"), mirNoSpan()))
    let cellValue = mirPlaceProject(mirPlace(cellLocal), mirFieldProj(0, "value", "Int"))
    mirFunctionAppend(fill, fillEntry, mirCallInstr(true, cellValue, "makeValue", "()->Int", [], mirNoSpan()))
    mirFunctionAppend(fill, fillEntry, mirIntrinsicInstr(true, cellValue, MirIntrinsicByteToInt, [mirOperandCopy(mirPlace(byteLocal), "Byte")], mirNoSpan()))
    let left = mirOperandCopy(cellValue, "Int")
    let right = mirOperandCopy(mirPlaceProject(mirPlace(cellLocal), mirFieldProj(1, "other", "Int")), "Int")
    mirFunctionAppend(fill, fillEntry, mirAssignInstr(mirPlace(fill.returnLocal), mirRVBinary(MirBinAdd, left, right, "Int"), mirNoSpan()))
    mirFunctionTerminate(fill, fillEntry, mirReturnTerm(mirNoSpan()))
    let mut m = lirTestModule([makeValue, fill])
    m.layouts.structs.push(lirTestStructLayout("Cell", [lirTestField(0, "value", "Int"), lirTestField(1, "other", "Int")]))
    assertLirLoweredContains(m, ["%Cell = type \{ i64, i64 \}", "define i64 @makeValue() \{", "define i64 @fill(i8 %p2) \{", "call i64 @makeValue()", "zext i8", "insertvalue %Cell", "store %Cell", "extractvalue %Cell"])
}
fn testLirProtoLowerMirUsesAreTraceOnlyOstyOwned() {
    let mut m = mirModule("main")
    m.globals.push(mirGlobal("g", "Int", false, mirNoSpan()))
    m.uses.push(mirUse("std.io", "io", mirNoSpan()))
    assertLirLoweredContains(m, ["@g = global i64 zeroinitializer", "; MIR use std.io as io"])
}
fn testLirProtoLowerMirReportsUnsupportedModuleTypeOstyOwned() {
    let mut m = mirModule("main")
    let mut g = mirGlobal("g", "OpaqueThing", false, mirNoSpan())
    g.hasInit = true
    g.initSymbol = "init_g"
    m.globals.push(g)
    let result = lirLowerMirModule(lirLowerConfig("main", "/tmp/lir_proto_fixture.osty", ""), m)
    testing.assert(lirLowerHasErrors(result))
    assertLirDiagnosticsContain(result.diagnostics, "unsupported module type `OpaqueThing`")
    testing.assertEq(result.diagnostics.len(), 1)
}
fn testLirProtoParityCatalogIsOstyOwned() {
    let manual = lirParityManualMIRFixtures()
    let source = lirParitySourceFixtures()
    let current = lirParityCurrentGeneratorSourceFixtures()
    let all = lirParityBuiltinFixtures()
    testing.assert(manual.len() >= 16)
    testing.assert(source.len() >= 10)
    testing.assert(current.len() >= 9)
    testing.assert(all.len() == manual.len() + source.len())
    let names = strings.join(lirParityFixtureNames(all), ",")
    assertLirContains(names, "const_return")
    assertLirContains(names, "projected_intrinsic_result")
    assertLirContains(names, "source_projected_intrinsic_result")
    assertLirContains(names, "source_println_int_runtime_abi")
    let currentNames = strings.join(lirParityFixtureNames(current), ",")
    assertLirContains(currentNames, "source_scalar_arithmetic")
    assertLirContains(currentNames, "source_projected_intrinsic_result")
    assertLirContains(currentNames, "source_nested_struct_binding")
    testing.assert(!(strings.contains(currentNames, "source_println_int_runtime_abi")))
}
fn testLirProtoParityCatalogFindsMissingNeedles() {
    let fixture = lirParityManualConstReturnFixture()
    let ok = "define i64 @answer()\nstore i64 42\nret i64"
    testing.assertEq(lirParityFindMissing(ok, fixture).len(), 0)
    let okCheck = lirParityCheckRendered("lir", fixture, ok)
    testing.assert(okCheck.ok)
    let missing = lirParityFindMissing("define i64 @answer()", fixture)
    testing.assert(missing.len() > 0)
    let report = lirParityRenderMissingReport("lir", fixture, missing)
    assertLirContains(report, "const_return")
    assertLirContains(report, "missing")
    let failedCheck = lirParityCheckRendered("lir", fixture, "define i64 @answer()")
    testing.assert(!(failedCheck.ok))
    assertLirContains(lirParityCheckReport(failedCheck), "missing")
}
fn testLirProtoParityManualBuildersLowerThroughOsty() {
    let constFixture = lirParityManualConstReturnFixture()
    let constResult = lirLowerMirModule(lirLowerConfig("main", constFixture.sourcePath, ""), lirParityBuildManualModule(constFixture.name))
    testing.assert(!(lirLowerHasErrors(constResult)))
    testing.assertEq(lirParityFindMissing(lirRenderModule(constResult.module), constFixture).len(), 0)
    let projectedFixture = lirParityManualProjectedIntrinsicResultFixture()
    let projectedResult = lirLowerMirModule(lirLowerConfig("main", projectedFixture.sourcePath, ""), lirParityBuildManualModule(projectedFixture.name))
    testing.assert(!(lirLowerHasErrors(projectedResult)))
    testing.assertEq(lirParityFindMissing(lirRenderModule(projectedResult.module), projectedFixture).len(), 0)
    let checks = lirParityCheckAllManual(lirLowerConfig("main", "", ""))
    testing.assertEq(checks.len(), lirParityManualMIRFixtures().len())
    testing.assert(lirParityChecksOK(checks))
    assertLirContains(lirParityCheckSummary(checks), "projected_intrinsic_result: ok")
}
fn testLirProtoLowererEnvelopeAndPackageFallbackOstyOwned() {
    let mut cfg = lirLowerConfig("", "/tmp/empty.osty", "arm64-apple-macosx")
    testing.assert(lirLowerConfigAddFeatureGate(cfg, "x"))
    let lowerer = lirNewLowerer(cfg)
    let mut snapshot = lirLowererConfig(lowerer)
    testing.assert(lirLowerConfigHasFeatureGate(snapshot, "x"))
    testing.assert(lirLowerConfigAddFeatureGate(snapshot, "y"))
    testing.assert(!(lirLowerConfigHasFeatureGate(lirLowererConfig(lowerer), "y")))
    let mut empty = mirModule("pkg")
    let result = lirLowererLowerMIR(lowerer, empty)
    testing.assert(lirLowerOK(result))
    testing.assert(!(lirLowerHasErrors(result)))
    testing.assert(!(lirLowerHasUnsupported(result)))
    testing.assertEq(result.module.packageName, "pkg")
    let ir = lirRenderModule(result.module)
    assertLirContains(ir, "source_filename = \"/tmp/empty.osty\"")
    assertLirContains(ir, "target triple = \"arm64-apple-macosx\"")
    let mut unsupported = mirModule("pkg")
    unsupported.globals.push(mirGlobal("g", "OpaqueThing", false, mirNoSpan()))
    let first = lirLowererLowerMIR(lowerer, unsupported)
    testing.assert(!(lirLowerOK(first)))
    testing.assert(lirLowerHasErrors(first))
    testing.assert(lirLowerHasUnsupported(first))
    let second = lirLowererLowerMIR(lowerer, mirModule("pkg"))
    testing.assert(lirLowerOK(second))
    testing.assertEq(second.diagnostics.len(), 0)
}
fn testLirProtoLowererReportsInvalidControlTargetsOstyOwned() {
    let mut fn_ = lirTestFunction("bad", "Int")
    let entry = lirTestEntryBlock(fn_)
    mirFunctionTerminate(fn_, entry, mirGotoTerm(99, mirNoSpan()))
    assertLirLoweredDiagnosticsContain(lirTestModule([fn_]), "target block 99 is not present")
}
fn testLirProtoLowererReportsVoidDestinationMismatchOstyOwned() {
    let mut noop = lirTestFunction("noop", "Unit")
    let noopEntry = lirTestEntryBlock(noop)
    mirFunctionTerminate(noop, noopEntry, mirReturnTerm(mirNoSpan()))
    let mut caller = lirTestFunction("main", "Int")
    let entry = lirTestEntryBlock(caller)
    mirFunctionAppend(caller, entry, mirCallInstr(true, mirPlace(caller.returnLocal), "noop", "()->Unit", [], mirNoSpan()))
    mirFunctionTerminate(caller, entry, mirReturnTerm(mirNoSpan()))
    assertLirLoweredDiagnosticsContain(lirTestModule([noop, caller]), "cannot store void result into non-unit local")
}
