use std.strings as strings
use std.testing
fn assertLirContains(text: String, needle: String) {
    testing.assert(strings.contains(text, needle))
}
fn assertLirDiagnosticsContain(diags: List<LirDiagnostic>, needle: String) {
    let mut rendered = ""
    for d in diags {
        rendered = rendered + "\n" + lirDiagnosticRender(d)
    }
    assertLirContains(rendered, needle)
}
fn testLirProtoRendersSimpleModuleOstyOwned() {
    let i64 = lirIntType(64)
    let i32 = lirIntType(32)
    let ptr = lirPtrType()
    let mut decls = lirRuntimeDecls()
    testing.assert(lirRuntimeDeclsDeclare(decls, lirRuntimeDecl("printf", i32, [ptr], true)))
    testing.assert(!(lirRuntimeDeclsDeclare(decls, lirRuntimeDecl("printf", i32, [ptr], true))))
    let mut pool = lirStringPool()
    testing.assertEq(lirStringPoolInternKnown(pool, "hello\n", "hello\\0A\\00", 7), "@.str.0")
    testing.assertEq(lirStringPoolInternKnown(pool, "hello\n", "hello\\0A\\00", 7), "@.str.0")
    let mut fn_ = lirFunction("add", i64)
    fn_.params.push(lirParam("%a", i64))
    fn_.params.push(lirParam("%b", i64))
    let mut block = lirBlock("entry", lirRetValue(i64, "%t0"))
    block.instrs.push(lirBinary("%t0", "add", i64, "%a", "%b"))
    fn_.blocks.push(block)
    let mut m = lirModule("main", "/tmp/main.osty", "x86_64-unknown-linux-gnu")
    m.typeDefs.push(lirTypeDef("%Pair", "\{ i64, ptr \}"))
    m.globals.push(lirGlobal("@counter", i64, "0"))
    m.runtimeDecls = decls
    m.stringPool = pool
    m.functions.push(fn_)
    m.metadata.push("; metadata sentinel")
    let ir = lirRenderModule(m)
    assertLirContains(ir, "; Code generated by osty LIR Proto. DO NOT EDIT.")
    assertLirContains(ir, "source_filename = \"/tmp/main.osty\"")
    assertLirContains(ir, "target triple = \"x86_64-unknown-linux-gnu\"")
    assertLirContains(ir, "%Pair = type \{ i64, ptr \}")
    assertLirContains(ir, "@counter = global i64 0")
    assertLirContains(ir, "@.str.0 = private unnamed_addr constant [7 x i8] c\"hello\\0A\\00\"")
    assertLirContains(ir, "declare i32 @printf(ptr, ...)")
    assertLirContains(ir, "define i64 @add(i64 %a, i64 %b) \{")
    assertLirContains(ir, "%t0 = add i64 %a, %b")
    assertLirContains(ir, "ret i64 %t0")
    assertLirContains(ir, "; metadata sentinel")
    testing.assertEq(lirValidateModule(m).len(), 0)
}
fn testLirProtoRuntimeDeclAndStringPoolOrderingOstyOwned() {
    let i32 = lirIntType(32)
    let ptr = lirPtrType()
    let mut decls = lirRuntimeDecls()
    testing.assert(lirRuntimeDeclsIsEmpty(decls))
    testing.assert(lirRuntimeDeclsDeclare(decls, lirRuntimeDecl("printf", i32, [ptr], true)))
    testing.assert(lirRuntimeDeclsDeclare(decls, lirRuntimeDecl("osty_rt_ping", lirVoidType(), [], false)))
    testing.assert(!(lirRuntimeDeclsDeclare(decls, lirRuntimeDecl("printf", i32, [ptr], true))))
    testing.assert(!(lirRuntimeDeclsIsEmpty(decls)))
    let mut orderedDecls = lirRuntimeDeclsOrdered(decls)
    testing.assertEq(orderedDecls.len(), 2)
    testing.assertEq(orderedDecls[0].symbol, "printf")
    testing.assertEq(orderedDecls[1].symbol, "osty_rt_ping")
    orderedDecls.push(lirRuntimeDecl("extra", lirVoidType(), [], false))
    testing.assertEq(lirRuntimeDeclsOrdered(decls).len(), 2)
    let mut pool = lirStringPool()
    testing.assert(lirStringPoolIsEmpty(pool))
    testing.assertEq(lirStringPoolIntern(pool, "hello\n"), "@.str.0")
    testing.assertEq(lirStringPoolIntern(pool, "hello\n"), "@.str.0")
    testing.assertEq(lirStringPoolIntern(pool, "quote \" slash \\"), "@.str.1")
    testing.assertEq(lirStringPoolSymbol(pool, "hello\n"), "@.str.0")
    testing.assertEq(lirStringPoolSymbol(pool, "missing"), "")
    testing.assert(!(lirStringPoolIsEmpty(pool)))
    let mut strings_ = lirStringPoolOrdered(pool)
    testing.assertEq(strings_.len(), 2)
    testing.assertEq(strings_[0].symbol, "@.str.0")
    testing.assertEq(strings_[0].encoded, "hello\\0A\\00")
    testing.assertEq(strings_[0].byteLen, 7)
    testing.assertEq(strings_[1].symbol, "@.str.1")
    testing.assertEq(strings_[1].encoded, "quote \\22 slash \\5C\\00")
    strings_.push(lirStringGlobal("@.str.extra", "extra", "extra\\00", 6))
    testing.assertEq(lirStringPoolOrdered(pool).len(), 2)
}
fn testLirProtoRendersDefaultSourceAndVoidReturnOstyOwned() {
    let mut fn_ = lirFunction("main", lirTypeInvalid())
    fn_.blocks.push(lirBlock("", lirRetVoid()))
    let mut m = lirModule("", "", "")
    m.functions.push(fn_)
    let ir = lirRenderModule(m)
    assertLirContains(ir, "; Osty: <unknown>")
    assertLirContains(ir, "source_filename = \"<unknown>\"")
    assertLirContains(ir, "define void @main() \{")
    assertLirContains(ir, "entry:")
    assertLirContains(ir, "ret void")
    testing.assertEq(lirValidateModule(m).len(), 0)
}
fn testLirProtoRendersTypedInstructionSurface() {
    let i1 = lirIntType(1)
    let i64 = lirIntType(64)
    let i128 = lirIntType(128)
    let ptr = lirPtrType()
    let pair = lirAggregateType("%Pair")
    let mut fn_ = lirFunction("typed", lirVoidType())
    fn_.params.push(lirParam("%p", ptr))
    fn_.params.push(lirParam("%cond", i1))
    let mut entry = lirBlock("entry", lirCondBr("%cond", "then", "else"))
    entry.instrs.push(lirComment("typed body"))
    entry.instrs.push(lirAlloca("%slot", i64, 8))
    entry.instrs.push(lirStore(lirOperand(i64, "7"), "%slot", 8))
    entry.instrs.push(lirLoad("%v", i64, "%slot", 8))
    entry.instrs.push(lirBinary("%sum", "add", i64, "%v", "1"))
    entry.instrs.push(lirCast("%wide", "sext", lirOperand(i64, "%sum"), i128))
    entry.instrs.push(lirInsertValue("%pair", pair, "undef", lirOperand(i64, "%v"), [0]))
    entry.instrs.push(lirExtractValue("%field", pair, "%pair", [0]))
    entry.instrs.push(lirGep("%elem", i64, "%p", [lirOperand(i64, "%field")], true))
    entry.instrs.push(lirCall("", lirVoidType(), "@side", [lirOperand(ptr, "%elem"), lirOperand(i128, "%wide")]))
    fn_.blocks.push(entry)
    fn_.blocks.push(lirBlock("then", lirBr("done")))
    fn_.blocks.push(lirBlock("else", lirUnreachable()))
    fn_.blocks.push(lirBlock("done", lirRetVoid()))
    let mut m = lirModule("main", "/tmp/typed.osty", "")
    m.typeDefs.push(lirTypeDef("%Pair", "\{ i64, i64 \}"))
    m.functions.push(fn_)
    let ir = lirRenderModule(m)
    assertLirContains(ir, "; typed body")
    assertLirContains(ir, "%slot = alloca i64, align 8")
    assertLirContains(ir, "store i64 7, ptr %slot, align 8")
    assertLirContains(ir, "%v = load i64, ptr %slot, align 8")
    assertLirContains(ir, "%wide = sext i64 %sum to i128")
    assertLirContains(ir, "%pair = insertvalue %Pair undef, i64 %v, 0")
    assertLirContains(ir, "%field = extractvalue %Pair %pair, 0")
    assertLirContains(ir, "%elem = getelementptr inbounds i64, ptr %p, i64 %field")
    assertLirContains(ir, "call void @side(ptr %elem, i128 %wide)")
    assertLirContains(ir, "br i1 %cond, label %then, label %else")
    assertLirContains(ir, "br label %done")
    assertLirContains(ir, "unreachable")
    assertLirContains(ir, "ret void")
    testing.assertEq(lirValidateModule(m).len(), 0)
}
fn testLirProtoValidationFindsMalformedPlan() {
    let badPtr = LirType {llvm: "i64", className: LirTypePtr}
    let mut fn_ = lirFunction("", lirVoidType())
    let mut entry = lirBlock("entry", lirTermInvalid())
    entry.instrs.push(lirAlloca("", lirVoidType(), -1))
    entry.instrs.push(lirCall("", lirIntType(64), "", []))
    fn_.blocks.push(entry)
    fn_.params.push(lirParam("%p", badPtr))
    fn_.blocks.push(lirBlock("entry", lirRetValue(lirTypeInvalid(), "%dangling")))
    let mut m = lirModule("main", "", "")
    m.typeDefs.push(lirTypeDef("", ""))
    m.typeDefs.push(lirTypeDef("%Broken", ""))
    m.globals.push(lirGlobal("@bad", lirVoidType(), ""))
    m.functions.push(fn_)
    let diags = lirValidateModule(m)
    testing.assert(diags.len() >= 10)
    assertLirDiagnosticsContain(diags, "missing name")
    assertLirDiagnosticsContain(diags, "missing body")
    assertLirDiagnosticsContain(diags, "void is not allowed here")
    assertLirDiagnosticsContain(diags, "class ptr has LLVM spelling `i64`")
    assertLirDiagnosticsContain(diags, "missing dest")
    assertLirDiagnosticsContain(diags, "negative alignment")
    assertLirDiagnosticsContain(diags, "missing callee")
    assertLirDiagnosticsContain(diags, "duplicate block label `entry`")
    assertLirDiagnosticsContain(diags, "missing terminator")
    assertLirDiagnosticsContain(diags, "return value without return type")
}
fn testLirProtoScalarPlanningHelpers() {
    testing.assertEq(lirLowerPrimitiveTypeName("Int").llvm, "i64")
    testing.assertEq(lirLowerPrimitiveTypeName("Bool").llvm, "i1")
    testing.assertEq(lirLowerPrimitiveTypeName("Float32").llvm, "float")
    testing.assertEq(lirLowerPrimitiveTypeName("String").llvm, "ptr")
    testing.assert(lirPrimitiveTypeIsUnsigned("Byte"))
    testing.assert(!(lirPrimitiveTypeIsUnsigned("Int")))
    testing.assertEq(lirPlanScalarCastOpcode(lirIntType(32), lirIntType(64), false), "sext")
    testing.assertEq(lirPlanScalarCastOpcode(lirIntType(32), lirIntType(64), true), "zext")
    testing.assertEq(lirPlanScalarCastOpcode(lirIntType(64), lirIntType(8), false), "trunc")
    testing.assertEq(lirPlanScalarCastOpcode(lirIntType(64), lirFloatType("double"), false), "sitofp")
    testing.assertEq(lirPlanScalarCastOpcode(lirFloatType("double"), lirIntType(64), false), "fptosi")
    testing.assertEq(lirPlanScalarCastOpcode(lirFloatType("double"), lirFloatType("float"), false), "fptrunc")
    testing.assertEq(lirPlanSameFamilyCoercionOpcode(lirIntType(32), lirFloatType("double"), false), "")
}
fn testLirProtoAggregateProjectionHelpers() {
    let types = [lirIntType(64), lirPtrType()]
    testing.assertEq(lirTupleTypeNameFromTypes(types), "%osty.tuple.i64.ptr")
    testing.assertEq(lirTupleTypeBody(types), "\{ i64, ptr \}")
    testing.assertEq(lirNamedTypeLayoutKey("main", false, "Pair"), "main.Pair")
    testing.assertEq(lirNamedTypeLayoutKey("", true, "String"), "builtin:String")
    let steps = [lirFieldProjection(1, "inner", lirAggregateType("%Inner")), lirTupleProjection(0, lirIntType(64))]
    testing.assertEq(lirProjectionPathText(steps), ".inner.0")
    testing.assertEq(lirRenderIndices(lirProjectionPathIndices(steps)), "1, 0")
}
fn testLirProtoProjectionFrameKeepsEachAggregateOperand() {
    let root = lirAggregateType("%Root")
    let middle = lirAggregateType("%Middle")
    let leaf = lirAggregateType("%Leaf")
    let frames = [lirProjectionFrame(lirOperand(root, "%base"), 0), lirProjectionFrame(lirOperand(middle, "%middle"), 0), lirProjectionFrame(lirOperand(leaf, "%leaf"), 0)]
    testing.assertEq(frames.len(), 3)
    testing.assertEq(frames[0].aggregate.typ.llvm, "%Root")
    testing.assertEq(frames[0].aggregate.value, "%base")
    testing.assertEq(frames[1].aggregate.typ.llvm, "%Middle")
    testing.assertEq(frames[1].aggregate.value, "%middle")
    testing.assertEq(frames[2].aggregate.typ.llvm, "%Leaf")
    testing.assertEq(frames[2].aggregate.value, "%leaf")
}
fn testLirProtoRendersDeepProjectedStoreRebuildOstyOwned() {
    let i64 = lirIntType(64)
    let ptr = lirPtrType()
    let leaf = lirAggregateType("%Leaf")
    let middle = lirAggregateType("%Middle")
    let root = lirAggregateType("%Root")
    let mut fn_ = lirFunction("deepProjectedStore", lirVoidType())
    fn_.params.push(lirParam("%root", ptr))
    fn_.params.push(lirParam("%value", i64))
    let mut entry = lirBlock("entry", lirRetVoid())
    entry.instrs.push(lirLoad("%base", root, "%root", 0))
    entry.instrs.push(lirExtractValue("%middle", root, "%base", [0]))
    entry.instrs.push(lirExtractValue("%leaf", middle, "%middle", [0]))
    entry.instrs.push(lirInsertValue("%newLeaf", leaf, "%leaf", lirOperand(i64, "%value"), [0]))
    entry.instrs.push(lirInsertValue("%newMiddle", middle, "%middle", lirOperand(leaf, "%newLeaf"), [0]))
    entry.instrs.push(lirInsertValue("%newRoot", root, "%base", lirOperand(middle, "%newMiddle"), [0]))
    entry.instrs.push(lirStore(lirOperand(root, "%newRoot"), "%root", 0))
    fn_.blocks.push(entry)
    let mut m = lirModule("main", "/tmp/deep_projected_store.osty", "")
    m.typeDefs.push(lirTypeDef("%Leaf", "\{ i64 \}"))
    m.typeDefs.push(lirTypeDef("%Middle", "\{ %Leaf, i64 \}"))
    m.typeDefs.push(lirTypeDef("%Root", "\{ %Middle, i64 \}"))
    m.functions.push(fn_)
    let ir = lirRenderModule(m)
    assertLirContains(ir, "%Leaf = type \{ i64 \}")
    assertLirContains(ir, "%Middle = type \{ %Leaf, i64 \}")
    assertLirContains(ir, "%Root = type \{ %Middle, i64 \}")
    assertLirContains(ir, "%base = load %Root, ptr %root")
    assertLirContains(ir, "%middle = extractvalue %Root %base, 0")
    assertLirContains(ir, "%leaf = extractvalue %Middle %middle, 0")
    assertLirContains(ir, "%newLeaf = insertvalue %Leaf %leaf, i64 %value, 0")
    assertLirContains(ir, "%newMiddle = insertvalue %Middle %middle, %Leaf %newLeaf, 0")
    assertLirContains(ir, "%newRoot = insertvalue %Root %base, %Middle %newMiddle, 0")
    assertLirContains(ir, "store %Root %newRoot, ptr %root")
    testing.assertEq(lirValidateModule(m).len(), 0)
}
fn assertLirContainsAll(text: String, needles: List<String>) {
    for needle in needles {
        assertLirContains(text, needle)
    }
}
fn assertLirLoweredContains(m: MirModule, needles: List<String>) {
    let result = lirLowerMirModule(lirLowerConfig("main", "/tmp/lir_proto_fixture.osty", ""), m)
    testing.assert(!(lirLowerHasErrors(result)))
    let ir = lirRenderModule(result.module)
    assertLirContainsAll(ir, needles)
}
fn assertLirLoweredDiagnosticsContain(m: MirModule, needle: String) {
    let result = lirLowerMirModule(lirLowerConfig("main", "/tmp/lir_proto_fixture.osty", ""), m)
    testing.assert(lirLowerHasErrors(result))
    assertLirDiagnosticsContain(result.diagnostics, needle)
}
fn lirTestFunction(name: String, retType: String) -> MirFunction {
    let mut fn_ = mirFunction(name, retType, mirNoSpan())
    let ret = mirFunctionNewLocal(fn_, "_return", retType, false, mirNoSpan())
    fn_.returnLocal = ret
    fn_.locals[ret].isReturn = true
    fn_
}
fn lirTestAddParam(fn_: MirFunction, name: String, typ: String) -> Int {
    let id = mirFunctionNewLocal(fn_, name, typ, false, mirNoSpan())
    fn_.locals[id].isParam = true
    fn_.params.push(id)
    id
}
fn lirTestAddLocal(fn_: MirFunction, name: String, typ: String) -> Int {
    mirFunctionNewLocal(fn_, name, typ, false, mirNoSpan())
}
fn lirTestEntryBlock(fn_: MirFunction) -> Int {
    let entry = mirFunctionNewBlock(fn_, mirNoSpan())
    fn_.entry = entry
    entry
}
fn lirTestAppendConstReturn(fn_: MirFunction, block: Int, value: Int) {
    mirFunctionAppend(fn_, block, mirAssignInstr(mirPlace(fn_.returnLocal), mirRVUse(mirOperandConst(mirConstInt(value, "Int"))), mirNoSpan()))
    mirFunctionTerminate(fn_, block, mirReturnTerm(mirNoSpan()))
}
fn lirTestModule(functions: List<MirFunction>) -> MirModule {
    let mut m = mirModule("main")
    for fn_ in functions {
        m.functions.push(fn_)
    }
    m
}
fn lirTestField(index: Int, name: String, typ: String) -> MirFieldLayout {
    MirFieldLayout {index, name, typ}
}
fn lirTestStructLayout(name: String, fields: List<MirFieldLayout>) -> MirStructLayout {
    MirStructLayout {name, mangled: name, fields, size: 0, align: 0}
}
fn lirTestTupleLayout(key: String, fields: List<MirFieldLayout>) -> MirTupleLayout {
    MirTupleLayout {key, mangled: key, fields}
}
fn lirTestInterfaceLayout(name: String, methods: List<MirInterfaceMethod>) -> MirInterfaceLayout {
    MirInterfaceLayout {name, methods, impls: []}
}
fn lirTestInterfaceMethod(name: String, slot: Int) -> MirInterfaceMethod {
    MirInterfaceMethod {name, slot}
}
fn testLirProtoLowerMirConstReturnOstyOwned() {
    let mut fn_ = lirTestFunction("answer", "Int")
    let entry = lirTestEntryBlock(fn_)
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(fn_.returnLocal), mirRVUse(mirOperandConst(mirConstInt(42, "Int"))), mirNoSpan()))
    mirFunctionTerminate(fn_, entry, mirReturnTerm(mirNoSpan()))
    assertLirLoweredContains(lirTestModule([fn_]), ["source_filename = \"/tmp/lir_proto_fixture.osty\"", "define i64 @answer() \{", "%l0 = alloca i64", "store i64 42, ptr %l0", "ret i64"])
}
fn testLirProtoLowerMirBinaryParamsOstyOwned() {
    let mut fn_ = lirTestFunction("add", "Int")
    let a = lirTestAddParam(fn_, "a", "Int")
    let b = lirTestAddParam(fn_, "b", "Int")
    let entry = lirTestEntryBlock(fn_)
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(fn_.returnLocal), mirRVBinary(MirBinAdd, mirOperandCopy(mirPlace(a), "Int"), mirOperandCopy(mirPlace(b), "Int"), "Int"), mirNoSpan()))
    mirFunctionTerminate(fn_, entry, mirReturnTerm(mirNoSpan()))
    assertLirLoweredContains(lirTestModule([fn_]), ["define i64 @add(i64 %p1, i64 %p2) \{", "store i64 %p1, ptr %l1", "store i64 %p2, ptr %l2", "add i64", "store i64", "ret i64"])
}
fn testLirProtoLowerMirBranchAndSwitchOstyOwned() {
    let mut choose = lirTestFunction("choose", "Int")
    let cond = lirTestAddParam(choose, "cond", "Bool")
    let entry = lirTestEntryBlock(choose)
    let thenBlock = mirFunctionNewBlock(choose, mirNoSpan())
    let elseBlock = mirFunctionNewBlock(choose, mirNoSpan())
    mirFunctionTerminate(choose, entry, mirBranchTerm(mirOperandCopy(mirPlace(cond), "Bool"), thenBlock, elseBlock, mirNoSpan()))
    lirTestAppendConstReturn(choose, thenBlock, 1)
    lirTestAppendConstReturn(choose, elseBlock, 2)
    let mut pick = lirTestFunction("pick", "Int")
    let n = lirTestAddParam(pick, "n", "Int")
    let switchEntry = lirTestEntryBlock(pick)
    let zero = mirFunctionNewBlock(pick, mirNoSpan())
    let one = mirFunctionNewBlock(pick, mirNoSpan())
    let default = mirFunctionNewBlock(pick, mirNoSpan())
    mirFunctionTerminate(pick, switchEntry, mirSwitchIntTerm(mirOperandCopy(mirPlace(n), "Int"), [mirSwitchCase(0, zero, "zero"), mirSwitchCase(1, one, "one")], default, mirNoSpan()))
    lirTestAppendConstReturn(pick, zero, 10)
    lirTestAppendConstReturn(pick, one, 20)
    lirTestAppendConstReturn(pick, default, 30)
    assertLirLoweredContains(lirTestModule([choose, pick]), ["define i64 @choose(i1 %p1) \{", "br i1", "label %bb1", "label %bb2", "define i64 @pick(i64 %p1) \{", "switch i64", "i64 0, label %bb1", "i64 1, label %bb2"])
}
fn testLirProtoLowerMirDirectCallsOstyOwned() {
    let mut inc = lirTestFunction("inc", "Int")
    let x = lirTestAddParam(inc, "x", "Int")
    let incEntry = lirTestEntryBlock(inc)
    mirFunctionAppend(inc, incEntry, mirAssignInstr(mirPlace(inc.returnLocal), mirRVBinary(MirBinAdd, mirOperandCopy(mirPlace(x), "Int"), mirOperandConst(mirConstInt(1, "Int")), "Int"), mirNoSpan()))
    mirFunctionTerminate(inc, incEntry, mirReturnTerm(mirNoSpan()))
    let mut noop = lirTestFunction("noop", "Unit")
    let noopEntry = lirTestEntryBlock(noop)
    mirFunctionTerminate(noop, noopEntry, mirReturnTerm(mirNoSpan()))
    let mut caller = lirTestFunction("main", "Int")
    let callerEntry = lirTestEntryBlock(caller)
    mirFunctionAppend(caller, callerEntry, mirCallInstr(true, mirPlace(caller.returnLocal), "inc", "(Int)->Int", [mirOperandConst(mirConstInt(41, "Int"))], mirNoSpan()))
    mirFunctionAppend(caller, callerEntry, mirCallInstr(false, mirPlace(-1), "noop", "()->Unit", [], mirNoSpan()))
    mirFunctionTerminate(caller, callerEntry, mirReturnTerm(mirNoSpan()))
    assertLirLoweredContains(lirTestModule([inc, noop, caller]), ["define i64 @inc(i64 %p1) \{", "define void @noop() \{", "call i64 @inc(i64 41)", "call void @noop()"])
}
fn testLirProtoLowerMirPrintIntrinsicsOstyOwned() {
    let mut fn_ = lirTestFunction("main", "Unit")
    let entry = lirTestEntryBlock(fn_)
    mirFunctionAppend(fn_, entry, mirIntrinsicInstr(false, mirPlace(-1), MirIntrinsicPrintln, [mirOperandConst(mirConstString("hello"))], mirNoSpan()))
    mirFunctionAppend(fn_, entry, mirIntrinsicInstr(false, mirPlace(-1), MirIntrinsicEprintln, [mirOperandConst(mirConstInt(7, "Int"))], mirNoSpan()))
    mirFunctionAppend(fn_, entry, mirIntrinsicInstr(false, mirPlace(-1), MirIntrinsicPrint, [mirOperandConst(mirConstFloat("1.5", "Float32"))], mirNoSpan()))
    mirFunctionTerminate(fn_, entry, mirReturnTerm(mirNoSpan()))
    assertLirLoweredContains(lirTestModule([fn_]), ["@.str.0 = private unnamed_addr constant [6 x i8] c\"hello\\00\"", "declare ptr @osty_rt_int_to_string(i64)", "declare ptr @osty_rt_float_to_string(double)", "declare void @osty_rt_io_write(ptr, i1, i1)", "call void @osty_rt_io_write(ptr @.str.0, i1 1, i1 0)", "call void @osty_rt_io_write"])
}
fn testLirProtoLowerMirScalarCastsOstyOwned() {
    let mut widen = lirTestFunction("widen", "Int")
    let widenEntry = lirTestEntryBlock(widen)
    mirFunctionAppend(widen, widenEntry, mirAssignInstr(mirPlace(widen.returnLocal), mirRVCast(MirCastIntResize, mirOperandConst(mirConstInt(7, "Int32")), "Int32", "Int"), mirNoSpan()))
    mirFunctionTerminate(widen, widenEntry, mirReturnTerm(mirNoSpan()))
    let mut unsigned = lirTestFunction("uwiden", "UInt64")
    let unsignedEntry = lirTestEntryBlock(unsigned)
    mirFunctionAppend(unsigned, unsignedEntry, mirAssignInstr(mirPlace(unsigned.returnLocal), mirRVCast(MirCastIntResize, mirOperandConst(mirConstInt(7, "UInt32")), "UInt32", "UInt64"), mirNoSpan()))
    mirFunctionTerminate(unsigned, unsignedEntry, mirReturnTerm(mirNoSpan()))
    let mut floatNarrow = lirTestFunction("narrowFloat", "Float32")
    let floatEntry = lirTestEntryBlock(floatNarrow)
    mirFunctionAppend(floatNarrow, floatEntry, mirAssignInstr(mirPlace(floatNarrow.returnLocal), mirRVCast(MirCastFloatResize, mirOperandConst(mirConstFloat("1.5", "Float")), "Float", "Float32"), mirNoSpan()))
    mirFunctionTerminate(floatNarrow, floatEntry, mirReturnTerm(mirNoSpan()))
    let mut toFloat = lirTestFunction("toFloat", "Float")
    let toFloatEntry = lirTestEntryBlock(toFloat)
    mirFunctionAppend(toFloat, toFloatEntry, mirAssignInstr(mirPlace(toFloat.returnLocal), mirRVCast(MirCastIntToFloat, mirOperandConst(mirConstInt(7, "Int")), "Int", "Float"), mirNoSpan()))
    mirFunctionTerminate(toFloat, toFloatEntry, mirReturnTerm(mirNoSpan()))
    assertLirLoweredContains(lirTestModule([widen, unsigned, floatNarrow, toFloat]), ["define i64 @widen() \{", "sext i32 7 to i64", "define i64 @uwiden() \{", "zext i32 7 to i64", "define float @narrowFloat() \{", "fptrunc double 1.5 to float", "define double @toFloat() \{", "sitofp i64 7 to double"])
}
fn testLirProtoLowerMirPrimitiveConversionIntrinsicsOstyOwned() {
    let mut byteToInt = lirTestFunction("byteToInt", "Int")
    let btiEntry = lirTestEntryBlock(byteToInt)
    mirFunctionAppend(byteToInt, btiEntry, mirIntrinsicInstr(true, mirPlace(byteToInt.returnLocal), MirIntrinsicByteToInt, [mirOperandConst(mirConstByte(7))], mirNoSpan()))
    mirFunctionTerminate(byteToInt, btiEntry, mirReturnTerm(mirNoSpan()))
    let mut charToInt = lirTestFunction("charToInt", "Int")
    let ctiEntry = lirTestEntryBlock(charToInt)
    mirFunctionAppend(charToInt, ctiEntry, mirIntrinsicInstr(true, mirPlace(charToInt.returnLocal), MirIntrinsicCharToInt, [mirOperandConst(mirConstChar(65))], mirNoSpan()))
    mirFunctionTerminate(charToInt, ctiEntry, mirReturnTerm(mirNoSpan()))
    let mut intToByte = lirTestFunction("intToByte", "Byte")
    let itbEntry = lirTestEntryBlock(intToByte)
    mirFunctionAppend(intToByte, itbEntry, mirIntrinsicInstr(true, mirPlace(intToByte.returnLocal), MirIntrinsicIntToByte, [mirOperandConst(mirConstInt(7, "Int"))], mirNoSpan()))
    mirFunctionTerminate(intToByte, itbEntry, mirReturnTerm(mirNoSpan()))
    let mut intToChar = lirTestFunction("intToChar", "Char")
    let itcEntry = lirTestEntryBlock(intToChar)
    mirFunctionAppend(intToChar, itcEntry, mirIntrinsicInstr(true, mirPlace(intToChar.returnLocal), MirIntrinsicIntToChar, [mirOperandConst(mirConstInt(65, "Int"))], mirNoSpan()))
    mirFunctionTerminate(intToChar, itcEntry, mirReturnTerm(mirNoSpan()))
    let mut byteToChar = lirTestFunction("byteToChar", "Char")
    let btcEntry = lirTestEntryBlock(byteToChar)
    mirFunctionAppend(byteToChar, btcEntry, mirIntrinsicInstr(true, mirPlace(byteToChar.returnLocal), MirIntrinsicByteToChar, [mirOperandConst(mirConstByte(7))], mirNoSpan()))
    mirFunctionTerminate(byteToChar, btcEntry, mirReturnTerm(mirNoSpan()))
    let mut charToByte = lirTestFunction("charToByte", "Byte")
    let ctbEntry = lirTestEntryBlock(charToByte)
    mirFunctionAppend(charToByte, ctbEntry, mirIntrinsicInstr(true, mirPlace(charToByte.returnLocal), MirIntrinsicCharToByte, [mirOperandConst(mirConstChar(65))], mirNoSpan()))
    mirFunctionTerminate(charToByte, ctbEntry, mirReturnTerm(mirNoSpan()))
    assertLirLoweredContains(lirTestModule([byteToInt, charToInt, intToByte, intToChar, byteToChar, charToByte]), ["define i64 @byteToInt() \{", "zext i8 7 to i64", "define i64 @charToInt() \{", "zext i32 65 to i64", "define i8 @intToByte() \{", "trunc i64 7 to i8", "define i32 @intToChar() \{", "trunc i64 65 to i32", "define i32 @byteToChar() \{", "zext i8 7 to i32", "define i8 @charToByte() \{", "trunc i32 65 to i8"])
}
fn testLirProtoLowerMirDirectCallArgCoercionOstyOwned() {
    let mut id = lirTestFunction("id", "Int")
