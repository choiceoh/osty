use std.strings as strings
use std.testing
fn assertLirContains(text: String, needle: String) {
    testing.assert(strings.contains(text, needle))
}
fn testLirProtoRendersSimpleModuleOstyOwned() {
    let i64 = lirIntType(64)
    let i32 = lirIntType(32)
    let ptr = lirPtrType()
    let mut decls = lirRuntimeDecls()
    testing.assert(lirRuntimeDeclsDeclare(decls, lirRuntimeDecl("printf", i32, [ptr], true)))
    testing.assert(!(lirRuntimeDeclsDeclare(decls, lirRuntimeDecl("printf", i32, [ptr], true))))
    let mut pool = lirStringPool()
    testing.assertEq(lirStringPoolInternKnown(pool, "hello\n", "hello\\0A\\00", 7), "@.str.0")
    testing.assertEq(lirStringPoolInternKnown(pool, "hello\n", "hello\\0A\\00", 7), "@.str.0")
    let mut fn_ = lirFunction("add", i64)
    fn_.params.push(lirParam("%a", i64))
    fn_.params.push(lirParam("%b", i64))
    let mut block = lirBlock("entry", lirRetValue(i64, "%t0"))
    block.instrs.push(lirBinary("%t0", "add", i64, "%a", "%b"))
    fn_.blocks.push(block)
    let mut m = lirModule("main", "/tmp/main.osty", "x86_64-unknown-linux-gnu")
    m.typeDefs.push(lirTypeDef("%Pair", "\{ i64, ptr \}"))
    m.globals.push(lirGlobal("@counter", i64, "0"))
    m.runtimeDecls = decls
    m.stringPool = pool
    m.functions.push(fn_)
    m.metadata.push("; metadata sentinel")
    let ir = lirRenderModule(m)
    assertLirContains(ir, "; Code generated by osty LIR Proto. DO NOT EDIT.")
    assertLirContains(ir, "source_filename = \"/tmp/main.osty\"")
    assertLirContains(ir, "target triple = \"x86_64-unknown-linux-gnu\"")
    assertLirContains(ir, "%Pair = type \{ i64, ptr \}")
    assertLirContains(ir, "@counter = global i64 0")
    assertLirContains(ir, "@.str.0 = private unnamed_addr constant [7 x i8] c\"hello\\0A\\00\"")
    assertLirContains(ir, "declare i32 @printf(ptr, ...)")
    assertLirContains(ir, "define i64 @add(i64 %a, i64 %b) \{")
    assertLirContains(ir, "%t0 = add i64 %a, %b")
    assertLirContains(ir, "ret i64 %t0")
    assertLirContains(ir, "; metadata sentinel")
    testing.assertEq(lirValidateModule(m).len(), 0)
}
fn testLirProtoRendersTypedInstructionSurface() {
    let i1 = lirIntType(1)
    let i64 = lirIntType(64)
    let i128 = lirIntType(128)
    let ptr = lirPtrType()
    let pair = lirAggregateType("%Pair")
    let mut fn_ = lirFunction("typed", lirVoidType())
    fn_.params.push(lirParam("%p", ptr))
    fn_.params.push(lirParam("%cond", i1))
    let mut entry = lirBlock("entry", lirCondBr("%cond", "then", "else"))
    entry.instrs.push(lirComment("typed body"))
    entry.instrs.push(lirAlloca("%slot", i64, 8))
    entry.instrs.push(lirStore(lirOperand(i64, "7"), "%slot", 8))
    entry.instrs.push(lirLoad("%v", i64, "%slot", 8))
    entry.instrs.push(lirBinary("%sum", "add", i64, "%v", "1"))
    entry.instrs.push(lirCast("%wide", "sext", lirOperand(i64, "%sum"), i128))
    entry.instrs.push(lirInsertValue("%pair", pair, "undef", lirOperand(i64, "%v"), [0]))
    entry.instrs.push(lirExtractValue("%field", pair, "%pair", [0]))
    entry.instrs.push(lirGep("%elem", i64, "%p", [lirOperand(i64, "%field")], true))
    entry.instrs.push(lirCall("", lirVoidType(), "@side", [lirOperand(ptr, "%elem"), lirOperand(i128, "%wide")]))
    fn_.blocks.push(entry)
    fn_.blocks.push(lirBlock("then", lirBr("done")))
    fn_.blocks.push(lirBlock("else", lirUnreachable()))
    fn_.blocks.push(lirBlock("done", lirRetVoid()))
    let mut m = lirModule("main", "/tmp/typed.osty", "")
    m.typeDefs.push(lirTypeDef("%Pair", "\{ i64, i64 \}"))
    m.functions.push(fn_)
    let ir = lirRenderModule(m)
    assertLirContains(ir, "; typed body")
    assertLirContains(ir, "%slot = alloca i64, align 8")
    assertLirContains(ir, "store i64 7, ptr %slot, align 8")
    assertLirContains(ir, "%v = load i64, ptr %slot, align 8")
    assertLirContains(ir, "%wide = sext i64 %sum to i128")
    assertLirContains(ir, "%pair = insertvalue %Pair undef, i64 %v, 0")
    assertLirContains(ir, "%field = extractvalue %Pair %pair, 0")
    assertLirContains(ir, "%elem = getelementptr inbounds i64, ptr %p, i64 %field")
    assertLirContains(ir, "call void @side(ptr %elem, i128 %wide)")
    assertLirContains(ir, "br i1 %cond, label %then, label %else")
    assertLirContains(ir, "br label %done")
    assertLirContains(ir, "unreachable")
    assertLirContains(ir, "ret void")
    testing.assertEq(lirValidateModule(m).len(), 0)
}
fn testLirProtoValidationFindsMalformedPlan() {
    let mut fn_ = lirFunction("", lirVoidType())
    let mut entry = lirBlock("entry", lirTermInvalid())
    entry.instrs.push(lirAlloca("", lirVoidType(), -1))
    fn_.blocks.push(entry)
    fn_.blocks.push(lirBlock("entry", lirRetVoid()))
    let mut m = lirModule("main", "", "")
    m.typeDefs.push(lirTypeDef("", ""))
    m.functions.push(fn_)
    let diags = lirValidateModule(m)
    testing.assert(diags.len() >= 5)
    let rendered = lirDiagnosticRender(diags[0])
    assertLirContains(rendered, "validation")
}
fn testLirProtoScalarPlanningHelpers() {
    testing.assertEq(lirLowerPrimitiveTypeName("Int").llvm, "i64")
    testing.assertEq(lirLowerPrimitiveTypeName("Bool").llvm, "i1")
    testing.assertEq(lirLowerPrimitiveTypeName("Float32").llvm, "float")
    testing.assertEq(lirLowerPrimitiveTypeName("String").llvm, "ptr")
    testing.assert(lirPrimitiveTypeIsUnsigned("Byte"))
    testing.assert(!(lirPrimitiveTypeIsUnsigned("Int")))
    testing.assertEq(lirPlanScalarCastOpcode(lirIntType(32), lirIntType(64), false), "sext")
    testing.assertEq(lirPlanScalarCastOpcode(lirIntType(32), lirIntType(64), true), "zext")
    testing.assertEq(lirPlanScalarCastOpcode(lirIntType(64), lirIntType(8), false), "trunc")
    testing.assertEq(lirPlanScalarCastOpcode(lirIntType(64), lirFloatType("double"), false), "sitofp")
    testing.assertEq(lirPlanScalarCastOpcode(lirFloatType("double"), lirIntType(64), false), "fptosi")
    testing.assertEq(lirPlanScalarCastOpcode(lirFloatType("double"), lirFloatType("float"), false), "fptrunc")
    testing.assertEq(lirPlanSameFamilyCoercionOpcode(lirIntType(32), lirFloatType("double"), false), "")
}
fn testLirProtoAggregateProjectionHelpers() {
    let types = [lirIntType(64), lirPtrType()]
    testing.assertEq(lirTupleTypeNameFromTypes(types), "%osty.tuple.i64.ptr")
    testing.assertEq(lirTupleTypeBody(types), "\{ i64, ptr \}")
    testing.assertEq(lirNamedTypeLayoutKey("main", false, "Pair"), "main.Pair")
    testing.assertEq(lirNamedTypeLayoutKey("", true, "String"), "builtin:String")
    let steps = [lirFieldProjection(1, "inner", lirAggregateType("%Inner")), lirTupleProjection(0, lirIntType(64))]
    testing.assertEq(lirProjectionPathText(steps), ".inner.0")
    testing.assertEq(lirRenderIndices(lirProjectionPathIndices(steps)), "1, 0")
}
