    let idEntry = lirTestEntryBlock(id)
    mirFunctionAppend(id, idEntry, mirAssignInstr(mirPlace(id.returnLocal), mirRVUse(mirOperandCopy(mirPlace(x), "Int")), mirNoSpan()))
    mirFunctionTerminate(id, idEntry, mirReturnTerm(mirNoSpan()))
    let mut caller = lirTestFunction("main", "Int")
    let callerEntry = lirTestEntryBlock(caller)
    mirFunctionAppend(caller, callerEntry, mirCallInstr(true, mirPlace(caller.returnLocal), "id", "(Int)->Int", [mirOperandConst(mirConstInt(41, "Int32"))], mirNoSpan()))
    mirFunctionTerminate(caller, callerEntry, mirReturnTerm(mirNoSpan()))
    assertLirLoweredContains(lirTestModule([id, caller]), ["define i64 @main() \{", "sext i32 41 to i64", "call i64 @id(i64", "store i64"])
}
fn testLirProtoLowerMirTupleLiteralAndElementReadOstyOwned() {
    let tupleName = "Tuple.i64.i64"
    let mut fn_ = lirTestFunction("pack", "Int")
    let tupleLocal = lirTestAddLocal(fn_, "t", tupleName)
    let entry = lirTestEntryBlock(fn_)
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(tupleLocal), mirRVAggregate(MirAggTuple, [mirOperandConst(mirConstInt(1, "Int")), mirOperandConst(mirConstInt(2, "Int"))], tupleName), mirNoSpan()))
    let left = mirOperandCopy(mirPlaceProject(mirPlace(tupleLocal), mirTupleProj(0, "Int")), "Int")
    let right = mirOperandCopy(mirPlaceProject(mirPlace(tupleLocal), mirTupleProj(1, "Int")), "Int")
    mirFunctionAppend(fn_, entry, mirAssignInstr(mirPlace(fn_.returnLocal), mirRVBinary(MirBinAdd, left, right, "Int"), mirNoSpan()))
    mirFunctionTerminate(fn_, entry, mirReturnTerm(mirNoSpan()))
    let mut m = lirTestModule([fn_])
    m.layouts.tuples.push(lirTestTupleLayout(tupleName, [lirTestField(0, "0", "Int"), lirTestField(1, "1", "Int")]))
    assertLirLoweredContains(m, ["%Tuple.i64.i64 = type \{ i64, i64 \}", "insertvalue %Tuple.i64.i64 undef, i64 1, 0", "insertvalue %Tuple.i64.i64", "extractvalue %Tuple.i64.i64", "add i64"])
}
