    l.currentBlockLabel = endLabel
    let merged = lirFresh(l)
    l.instrs.push(lirLoad(merged, destType, mergeSlot, 0))
    lirStoreMirResult(l, instr.dest, lirOperand(destType, merged), loc.typ, label + " result")
