// `lirLowerMirEnumVariantAggregate` builds the canonical
// `{ i64 disc, i64 payload }` aggregate for an enum variant. Disc is
// the variant index (e.g. 0 for None / Err, 1 for Some / Ok). Payload
// is i64-encoded via `lirParseResultPayloadAsI64` (the boxing helper
// already used by IndexOf and List.first/last). Bare 0-arity variants
// fill the slot with literal 0. Mirrors production `emitEnumVariant`
// (mir_generator.go:9148).
fn lirLowerMirEnumVariantAggregate(l: LirMirFunctionLowerer, rv: MirRValue, hintName: String, hint: LirType) -> LirOperand {
    let typeName = lirAggTypeNameFromRV(rv, hintName)
    let aggType = if typeName != "" {
        lirLowerMirType(l, typeName)
    } else {
        hint
    }
    if lirTypeIsZero(aggType) {
        lirLowerError(l, LirDiagUnsupported, "enum variant aggregate has no target type — `" + typeName + "`", "aggregate.enum")
        return lirOperandInvalid()
    }
    let discText = lirIntToString(rv.aggVariantIdx)
    let step1 = lirFresh(l)
    l.instrs.push(lirInsertValue(step1, aggType, "undef", lirOperand(lirIntType(64), discText), [0]))
    let payloadI64 = if rv.aggFields.len() == 0 {
        "0"
    } else if rv.aggFields.len() == 1 {
        let arg = rv.aggFields[0]
        let argHint = lirLowerMirType(l, arg.typ)
        let value = lirLowerMirOperand(l, arg, arg.typ, argHint)
        if value.value == "" {
            return lirOperandInvalid()
        }
        lirParseResultPayloadAsI64(l, value.value, value.typ)
    } else {
        lirLowerError(l, LirDiagUnsupported, "enum variant with " + lirIntToString(rv.aggFields.len()) + " payload fields (only scalar / 0-arity supported)", "aggregate.enum")
        return lirOperandInvalid()
    }
    let value = lirFresh(l)
    l.instrs.push(lirInsertValue(value, aggType, step1, lirOperand(lirIntType(64), payloadI64), [1]))
    lirOperand(aggType, value)
}
fn lirLowerMirTupleAggregate(l: LirMirFunctionLowerer, rv: MirRValue, hintName: String, hint: LirType) -> LirOperand {
    let tupleName = lirAggTypeNameFromRV(rv, hintName)
    let layout = lirFindMirTupleLayout(l, tupleName)
    if layout.key == "" && layout.mangled == "" {
        lirLowerError(l, LirDiagUnsupported, "tuple aggregate type `" + tupleName + "` has no MIR layout", "aggregate.tuple")
        return lirOperandInvalid()
    }
    if rv.aggFields.len() != layout.fields.len() {
        lirLowerError(l, LirDiagInvalidInput, "tuple aggregate field count does not match layout", "aggregate.tuple")
        return lirOperandInvalid()
    }
    let aggregateType = if lirTypeIsZero(hint) {
        lirLowerMirType(l, tupleName)
    } else {
        hint
    }
    let mut current = lirOperand(aggregateType, "undef")
    let mut i = 0
    for field in rv.aggFields {
        let fieldLayout = layout.fields[i]
        let fieldType = lirLowerMirType(l, fieldLayout.typ)
        if lirTypeIsZero(fieldType) || lirTypeIsVoid(fieldType) {
            lirLowerError(l, LirDiagUnsupported, "tuple field type `" + fieldLayout.typ + "` is not implemented", "aggregate.tuple")
            return lirOperandInvalid()
        }
        let mut value = lirLowerMirOperand(l, field, fieldLayout.typ, fieldType)
        if value.typ.llvm != fieldType.llvm {
            value = lirCoerceMirOperand(l, value, field.typ, fieldType, "tuple field")
            if value.value == "" {
                return lirOperandInvalid()
            }
        }
        let dest = lirFresh(l)
        l.instrs.push(lirInsertValue(dest, aggregateType, current.value, value, [fieldLayout.index]))
        current = lirOperand(aggregateType, dest)
        i = i + 1
    }
