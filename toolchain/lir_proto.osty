// lir_proto.osty - self-hosted LIR Proto model, renderer, and planning helpers.
//
// This file is the Osty-owned source for the LIR Proto surface. New shape
// should be described here first so the backend can move toward the
// self-hosted toolchain without a second porting pass.
//
// Scope:
//   - renderable LLVM-aware low-level plan
//   - shallow structural validation
//   - runtime declaration/string pool ordering helpers
//   - scalar type/cast/coercion planning helpers
//   - aggregate projection planning records
//   - scalar/control/call/intrinsic/aggregate MIR lowering surface
//
// Non-scope:
//   - production backend dispatch
//   - full MIR semantic coverage
//   - SSA/dominance verification
//   - target data-layout reasoning
use std.strings as strings
// ====================================================================
// Enum kinds
// ====================================================================
pub enum LirTypeClass {
    LirTypeUnknown,
    LirTypeVoid,
    LirTypeInt,
    LirTypeFloat,
    LirTypePtr,
    LirTypeAggregate,
    LirTypeFunction,
}
pub enum LirInstrKind {
    LirInstrInvalid,
    LirInstrAlloca,
    LirInstrLoad,
    LirInstrStore,
    LirInstrBinary,
    LirInstrUnary,
    LirInstrCall,
    LirInstrCast,
    LirInstrInsertValue,
    LirInstrExtractValue,
    LirInstrGep,
    LirInstrComment,
}
pub enum LirTermKind {
    LirTermInvalid,
    LirTermRet,
    LirTermBr,
    LirTermCondBr,
    LirTermSwitch,
    LirTermUnreachable,
}
pub enum LirDiagnosticKind {
    LirDiagInvalidInput,
    LirDiagUnsupported,
    LirDiagValidation,
    LirDiagLoweringBug,
}
pub enum LirSeverity {
    LirSeverityInfo,
    LirSeverityWarning,
    LirSeverityError,
}
pub enum LirProjectionKind {
    LirProjInvalid,
    LirProjField,
    LirProjTuple,
    LirProjVariant,
    LirProjIndex,
    LirProjDeref,
}
// ====================================================================
// Types and operands
// ====================================================================
/// LirType is deliberately hybrid: `llvm` remains the exact renderer
/// spelling, while `className` gives validation/lowering a small semantic
/// bucket without inventing a full second type system.
pub struct LirType {
    pub llvm: String,
    pub className: LirTypeClass,
}
pub fn lirTypeInvalid() -> LirType {
    LirType {llvm: "", className: LirTypeUnknown}
}
pub fn lirRawType(llvm: String) -> LirType {
    LirType {llvm, className: LirTypeUnknown}
}
pub fn lirVoidType() -> LirType {
    LirType {llvm: "void", className: LirTypeVoid}
}
pub fn lirIntType(bits: Int) -> LirType {
    LirType {llvm: "i" + lirIntToString(bits), className: LirTypeInt}
}
pub fn lirFloatType(llvm: String) -> LirType {
    LirType {llvm, className: LirTypeFloat}
}
pub fn lirPtrType() -> LirType {
    LirType {llvm: "ptr", className: LirTypePtr}
}
pub fn lirAggregateType(llvm: String) -> LirType {
    LirType {llvm, className: LirTypeAggregate}
}
pub fn lirFunctionType(llvm: String) -> LirType {
    LirType {llvm, className: LirTypeFunction}
}
pub fn lirTypeString(t: LirType) -> String {
    t.llvm
}
pub fn lirTypeIsZero(t: LirType) -> Bool {
    t.llvm == "" && t.className == LirTypeUnknown
}
pub fn lirTypeIsVoid(t: LirType) -> Bool {
    t.className == LirTypeVoid || t.llvm == "void"
}
pub fn lirTypeSame(a: LirType, b: LirType) -> Bool {
    a.llvm == b.llvm && a.className == b.className
}
// B2 demo: `match` rewritten as if-else chain so this function fits
// the stage0 P0–P15 emitter's coverage. Shape preserved exactly —
// callers and ToString output are unchanged. See
// `docs/osty_self_b2_audit.md` for the wider rewrite scope.
pub fn lirTypeClassName(c: LirTypeClass) -> String {
    if c == LirTypeVoid {
        return "void"
    }
    if c == LirTypeInt {
        return "int"
    }
    if c == LirTypeFloat {
        return "float"
    }
    if c == LirTypePtr {
        return "ptr"
    }
    if c == LirTypeAggregate {
        return "aggregate"
    }
    if c == LirTypeFunction {
        return "function"
    }
    "unknown"
}
pub struct LirOperand {
    pub typ: LirType,
    pub value: String,
}
pub fn lirOperand(typ: LirType, value: String) -> LirOperand {
    LirOperand {typ, value}
}
pub fn lirOperandInvalid() -> LirOperand {
    LirOperand {typ: lirTypeInvalid(), value: ""}
}
pub fn lirOperandString(op: LirOperand) -> String {
    lirTypeString(op.typ) + " " + op.value
}
// ====================================================================
// Module model
// ====================================================================
pub struct LirTypeDef {
    pub name: String,
    pub body: String,
}
pub fn lirTypeDef(name: String, body: String) -> LirTypeDef {
    LirTypeDef {name, body}
}
pub struct LirGlobal {
    pub name: String,
    pub typ: LirType,
    pub init: String,
    pub attrs: List<String>,
    pub linkage: String,
    pub constant: Bool,
}
// `linkage` slot is rendered between `=` and `global` when set.
// Used for `appending` (e.g. `@llvm.global_ctors`), `private`,
// `external`, etc.
pub fn lirGlobal(name: String, typ: LirType, init: String) -> LirGlobal {
    LirGlobal {name, typ, init, attrs: [], linkage: "", constant: false}
}
pub fn lirGlobalWithLinkage(name: String, typ: LirType, init: String, linkage: String) -> LirGlobal {
    LirGlobal {name, typ, init, attrs: [], linkage, constant: false}
}
pub fn lirGlobalConstant(name: String, typ: LirType, init: String) -> LirGlobal {
    LirGlobal {name, typ, init, attrs: [], linkage: "", constant: true}
}
pub struct LirParam {
    pub name: String,
    pub typ: LirType,
    pub attrs: List<String>,
}
pub fn lirParam(name: String, typ: LirType) -> LirParam {
    LirParam {name, typ, attrs: []}
}
pub fn lirParamWithAttrs(name: String, typ: LirType, attrs: List<String>) -> LirParam {
    LirParam {name, typ, attrs}
}
/// LirInstr is a sealed-by-convention flat variant. The `kind` field selects
/// which payload fields are live. Keeping this as one struct mirrors the rest
/// of the self-hosted toolchain and avoids interface-shaped bridge work later.
pub struct LirInstr {
    pub kind: LirInstrKind,
    pub dest: String,
    pub typ: LirType,
    pub align: Int,
    pub ptr: String,
    pub value: LirOperand,
    pub op: String,
    pub left: String,
    pub right: String,
    pub from: LirOperand,
    pub toType: LirType,
    pub returnType: LirType,
    pub callee: String,
    pub args: List<LirOperand>,
    pub callingConv: String,
    pub attrs: List<String>,
    pub aggregate: String,
    pub indices: List<Int>,
    pub elemType: LirType,
    pub gepIndices: List<LirOperand>,
    pub inbounds: Bool,
    pub text: String,
    pub metadata: List<String>,
}
// Per-instruction LLVM metadata trailers — currently `, !llvm.access.group !N`
// attached to load/store inside `#[parallel]` functions
// (LANG_SPEC A6). Each entry is the full trailer text after
// the comma, e.g. `!llvm.access.group !3`. Empty list = no trailer.
// Common result/value fields.
// Binary/unary/cast fields.
// Call fields.
// Aggregate/GEP fields.
// Comment payload.
// Metadata trailer.
pub fn lirInstrInvalid() -> LirInstr {
    LirInstr {kind: LirInstrInvalid, dest: "", typ: lirTypeInvalid(), align: 0, ptr: "", value: lirOperandInvalid(), op: "", left: "", right: "", from: lirOperandInvalid(), toType: lirTypeInvalid(), returnType: lirTypeInvalid(), callee: "", args: [], callingConv: "", attrs: [], aggregate: "", indices: [], elemType: lirTypeInvalid(), gepIndices: [], inbounds: false, text: "", metadata: []}
}
pub fn lirAlloca(dest: String, typ: LirType, align: Int) -> LirInstr {
    let mut i = lirInstrInvalid()
    i.kind = LirInstrAlloca
    i.dest = dest
    i.typ = typ
    i.align = align
    i
}
pub fn lirLoad(dest: String, typ: LirType, ptr: String, align: Int) -> LirInstr {
    let mut i = lirInstrInvalid()
    i.kind = LirInstrLoad
    i.dest = dest
    i.typ = typ
    i.ptr = ptr
    i.align = align
    i
}
pub fn lirStore(value: LirOperand, ptr: String, align: Int) -> LirInstr {
    let mut i = lirInstrInvalid()
    i.kind = LirInstrStore
    i.value = value
    i.ptr = ptr
    i.align = align
    i
}
pub fn lirBinary(dest: String, op: String, typ: LirType, left: String, right: String) -> LirInstr {
    let mut i = lirInstrInvalid()
    i.kind = LirInstrBinary
    i.dest = dest
    i.op = op
    i.typ = typ
    i.left = left
    i.right = right
    i
}
pub fn lirUnary(dest: String, op: String, typ: LirType, value: String) -> LirInstr {
    let mut i = lirInstrInvalid()
    i.kind = LirInstrUnary
    i.dest = dest
    i.op = op
    i.typ = typ
    i.left = value
    i
}
pub fn lirCall(dest: String, returnType: LirType, callee: String, args: List<LirOperand>) -> LirInstr {
    let mut i = lirInstrInvalid()
    i.kind = LirInstrCall
    i.dest = dest
    i.returnType = returnType
    i.callee = callee
    i.args = args
    i
}
pub fn lirCallWithAttrs(dest: String, returnType: LirType, callee: String, args: List<LirOperand>, callingConv: String, attrs: List<String>) -> LirInstr {
    let mut i = lirCall(dest, returnType, callee, args)
    i.callingConv = callingConv
    i.attrs = attrs
    i
}
pub fn lirCast(dest: String, op: String, from: LirOperand, toType: LirType) -> LirInstr {
    let mut i = lirInstrInvalid()
    i.kind = LirInstrCast
    i.dest = dest
    i.op = op
    i.from = from
    i.toType = toType
    i
}
pub fn lirInsertValue(dest: String, typ: LirType, aggregate: String, value: LirOperand, indices: List<Int>) -> LirInstr {
    let mut i = lirInstrInvalid()
    i.kind = LirInstrInsertValue
    i.dest = dest
    i.typ = typ
    i.aggregate = aggregate
    i.value = value
    i.indices = indices
    i
}
pub fn lirExtractValue(dest: String, typ: LirType, aggregate: String, indices: List<Int>) -> LirInstr {
    let mut i = lirInstrInvalid()
    i.kind = LirInstrExtractValue
    i.dest = dest
    i.typ = typ
    i.aggregate = aggregate
    i.indices = indices
    i
}
pub fn lirGep(dest: String, elemType: LirType, ptr: String, indices: List<LirOperand>, inbounds: Bool) -> LirInstr {
    let mut i = lirInstrInvalid()
    i.kind = LirInstrGep
    i.dest = dest
    i.elemType = elemType
    i.ptr = ptr
    i.gepIndices = indices
    i.inbounds = inbounds
    i
}
pub fn lirComment(text: String) -> LirInstr {
    let mut i = lirInstrInvalid()
    i.kind = LirInstrComment
    i.text = text
    i
}
pub struct LirSwitchCase {
    pub value: String,
    pub label: String,
}
pub fn lirSwitchCase(value: String, label: String) -> LirSwitchCase {
    LirSwitchCase {value, label}
}
pub struct LirTerm {
    pub kind: LirTermKind,
    pub retType: LirType,
    pub retValue: String,
    pub target: String,
    pub cond: String,
    pub thenLabel: String,
    pub elseLabel: String,
    pub switchType: LirType,
    pub switchScrutinee: String,
    pub switchDefault: String,
    pub cases: List<LirSwitchCase>,
    pub loopMDRef: String,
}
// `loopMDRef` is the `!N` metadata reference attached to this
// terminator's `br` instruction. Empty when no loop metadata
// applies. Populated by the lowerer when a MIR back-edge
// terminator coincides with an active `#[vectorize]` /
// `#[unroll]` / `#[parallel]` annotation on the enclosing
// function (LANG_SPEC A5/A6/A7).
pub fn lirTermInvalid() -> LirTerm {
    LirTerm {kind: LirTermInvalid, retType: lirTypeInvalid(), retValue: "", target: "", cond: "", thenLabel: "", elseLabel: "", switchType: lirTypeInvalid(), switchScrutinee: "", switchDefault: "", cases: [], loopMDRef: ""}
}
pub fn lirRetVoid() -> LirTerm {
    let mut t = lirTermInvalid()
    t.kind = LirTermRet
    t
}
pub fn lirRetValue(typ: LirType, value: String) -> LirTerm {
    let mut t = lirTermInvalid()
    t.kind = LirTermRet
    t.retType = typ
    t.retValue = value
    t
}
pub fn lirBr(target: String) -> LirTerm {
    let mut t = lirTermInvalid()
    t.kind = LirTermBr
    t.target = target
    t
}
pub fn lirCondBr(cond: String, thenLabel: String, elseLabel: String) -> LirTerm {
    let mut t = lirTermInvalid()
    t.kind = LirTermCondBr
    t.cond = cond
    t.thenLabel = thenLabel
    t.elseLabel = elseLabel
    t
}
pub fn lirSwitch(typ: LirType, scrutinee: String, defaultLabel: String, cases: List<LirSwitchCase>) -> LirTerm {
    let mut t = lirTermInvalid()
    t.kind = LirTermSwitch
    t.switchType = typ
    t.switchScrutinee = scrutinee
    t.switchDefault = defaultLabel
    t.cases = cases
    t
}
pub fn lirUnreachable() -> LirTerm {
    let mut t = lirTermInvalid()
    t.kind = LirTermUnreachable
    t
}
pub struct LirBlock {
    pub label: String,
    pub instrs: List<LirInstr>,
    pub term: LirTerm,
}
pub fn lirBlock(label: String, term: LirTerm) -> LirBlock {
    LirBlock {label, instrs: [], term}
}
pub fn lirBlockAppend(block: LirBlock, instr: LirInstr) {
    block.instrs.push(instr)
}
pub struct LirFunction {
    pub name: String,
    pub returnType: LirType,
    pub params: List<LirParam>,
    pub blocks: List<LirBlock>,
    pub linkage: String,
    pub callingConv: String,
    pub attrs: List<String>,
}
pub fn lirFunction(name: String, returnType: LirType) -> LirFunction {
    LirFunction {name, returnType, params: [], blocks: [], linkage: "", callingConv: "", attrs: []}
}
pub struct LirRuntimeDecl {
    pub symbol: String,
    pub returnType: LirType,
    pub params: List<LirType>,
    pub vararg: Bool,
}
pub fn lirRuntimeDecl(symbol: String, returnType: LirType, params: List<LirType>, vararg: Bool) -> LirRuntimeDecl {
    LirRuntimeDecl {symbol, returnType, params, vararg}
}
pub struct LirRuntimeDecls {
    pub decls: List<LirRuntimeDecl>,
}
pub fn lirRuntimeDecls() -> LirRuntimeDecls {
    LirRuntimeDecls {decls: []}
}
/// lirRuntimeDeclsDeclare records the first declaration for a runtime symbol.
/// It returns false for empty or duplicate symbols.
pub fn lirRuntimeDeclsDeclare(decls: LirRuntimeDecls, decl: LirRuntimeDecl) -> Bool {
    if decl.symbol == "" {
        return false
    }
    for existing in decls.decls {
        if existing.symbol == decl.symbol {
            return false
        }
    }
    decls.decls.push(decl)
    true
}
pub fn lirRuntimeDeclsOrdered(decls: LirRuntimeDecls) -> List<LirRuntimeDecl> {
    let mut out: List<LirRuntimeDecl> = []
    for decl in decls.decls {
        out.push(decl)
    }
    out
}
pub fn lirRuntimeDeclsIsEmpty(decls: LirRuntimeDecls) -> Bool {
    decls.decls.len() == 0
}
pub struct LirStringGlobal {
    pub symbol: String,
    pub content: String,
    pub encoded: String,
    pub byteLen: Int,
}
pub fn lirStringGlobal(symbol: String, content: String, encoded: String, byteLen: Int) -> LirStringGlobal {
    LirStringGlobal {symbol, content, encoded, byteLen}
}
pub struct LirStringPool {
    pub entries: List<LirStringGlobal>,
}
pub fn lirStringPool() -> LirStringPool {
    LirStringPool {entries: []}
}
pub fn lirStringPoolIntern(pool: LirStringPool, content: String) -> String {
    lirStringPoolInternKnown(pool, content, lirCStringEncodeBasic(content), content.len() + 1)
}
/// lirStringPoolInternKnown interns a string when the caller already knows
/// the LLVM C-string encoding and byte length. Full byte escaping belongs in a
/// later runtime/text utility; this keeps the pool deterministic now.
pub fn lirStringPoolInternKnown(pool: LirStringPool, content: String, encoded: String, byteLen: Int) -> String {
    for existing in pool.entries {
        if existing.content == content {
            return existing.symbol
        }
    }
    let symbol = "@.str." + lirIntToString(pool.entries.len())
    pool.entries.push(lirStringGlobal(symbol, content, encoded, byteLen))
    symbol
}
pub fn lirStringPoolSymbol(pool: LirStringPool, content: String) -> String {
    for existing in pool.entries {
        if existing.content == content {
            return existing.symbol
        }
    }
    ""
}
pub fn lirStringPoolOrdered(pool: LirStringPool) -> List<LirStringGlobal> {
    let mut out: List<LirStringGlobal> = []
    for entry in pool.entries {
        out.push(entry)
    }
    out
}
pub fn lirStringPoolIsEmpty(pool: LirStringPool) -> Bool {
    pool.entries.len() == 0
}
pub struct LirModule {
    pub packageName: String,
    pub sourcePath: String,
    pub target: String,
    pub typeDefs: List<LirTypeDef>,
    pub globals: List<LirGlobal>,
    pub functions: List<LirFunction>,
    pub runtimeDecls: LirRuntimeDecls,
    pub stringPool: LirStringPool,
    pub metadata: List<String>,
}
pub fn lirModule(packageName: String, sourcePath: String, target: String) -> LirModule {
    LirModule {packageName, sourcePath, target, typeDefs: [], globals: [], functions: [], runtimeDecls: lirRuntimeDecls(), stringPool: lirStringPool(), metadata: []}
}
// ====================================================================
// Diagnostics and lowerer shell
// ====================================================================
pub struct LirDiagnostic {
    pub kind: LirDiagnosticKind,
    pub severity: LirSeverity,
    pub message: String,
    pub path: String,
}
pub fn lirDiagnostic(kind: LirDiagnosticKind, severity: LirSeverity, message: String, path: String) -> LirDiagnostic {
    LirDiagnostic {kind, severity, message, path}
}
pub fn lirDiagnosticError(kind: LirDiagnosticKind, message: String, path: String) -> LirDiagnostic {
    lirDiagnostic(kind, LirSeverityError, message, path)
}
pub fn lirDiagnosticKindName(kind: LirDiagnosticKind) -> String {
    if kind == LirDiagInvalidInput {
        return "invalid_input"
    }
    if kind == LirDiagUnsupported {
        return "unsupported"
    }
    if kind == LirDiagValidation {
        return "validation"
    }
    if kind == LirDiagLoweringBug {
        return "lowering_bug"
    }
    unreachable()
}
// B2: payload-less enum dispatch as if-else chain (stage0 P0–P15).
pub fn lirDiagnosticRender(d: LirDiagnostic) -> String {
    let mut prefix = lirDiagnosticKindName(d.kind)
    if d.path != "" {
        prefix = prefix + " " + d.path
    }
    prefix + ": " + d.message
}
pub struct LirLowerConfig {
    pub packageName: String,
    pub sourcePath: String,
    pub target: String,
    pub emitGC: Bool,
    pub featureGates: List<String>,
}
pub fn lirLowerConfig(packageName: String, sourcePath: String, target: String) -> LirLowerConfig {
    LirLowerConfig {packageName, sourcePath, target, emitGC: false, featureGates: []}
}
pub fn lirLowerConfigCopy(cfg: LirLowerConfig) -> LirLowerConfig {
    let mut gates: List<String> = []
    for gate in cfg.featureGates {
        gates.push(gate)
    }
    LirLowerConfig {packageName: cfg.packageName, sourcePath: cfg.sourcePath, target: cfg.target, emitGC: cfg.emitGC, featureGates: gates}
}
pub fn lirLowerConfigHasFeatureGate(cfg: LirLowerConfig, gate: String) -> Bool {
    for existing in cfg.featureGates {
        if existing == gate {
            return true
        }
    }
    false
}
pub fn lirLowerConfigAddFeatureGate(cfg: LirLowerConfig, gate: String) -> Bool {
    if gate == "" {
        return false
    }
    if lirLowerConfigHasFeatureGate(cfg, gate) {
        return false
    }
    cfg.featureGates.push(gate)
    true
}
pub struct LirLowerResult {
    pub module: LirModule,
    pub diagnostics: List<LirDiagnostic>,
}
pub fn lirLowerResultOk(module: LirModule) -> LirLowerResult {
    LirLowerResult {module, diagnostics: []}
}
pub fn lirLowerUnsupported(cfg: LirLowerConfig, message: String) -> LirLowerResult {
    let mut diags: List<LirDiagnostic> = []
    diags.push(lirDiagnosticError(LirDiagUnsupported, message, ""))
    LirLowerResult {module: lirModule(cfg.packageName, cfg.sourcePath, cfg.target), diagnostics: diags}
}
pub fn lirLowerHasErrors(result: LirLowerResult) -> Bool {
    for d in result.diagnostics {
        if d.severity == LirSeverityError {
            return true
        }
    }
    false
}
pub fn lirLowerOK(result: LirLowerResult) -> Bool {
    !(lirLowerHasErrors(result))
}
pub fn lirLowerHasUnsupported(result: LirLowerResult) -> Bool {
    for d in result.diagnostics {
        if d.kind == LirDiagUnsupported {
            return true
        }
    }
    false
}
pub struct LirLowerer {
    pub cfg: LirLowerConfig,
}
pub fn lirNewLowerer(cfg: LirLowerConfig) -> LirLowerer {
    LirLowerer {cfg: lirLowerConfigCopy(cfg)}
}
pub fn lirLowererConfig(l: LirLowerer) -> LirLowerConfig {
    lirLowerConfigCopy(l.cfg)
}
pub fn lirLowererLowerMIR(l: LirLowerer, mir: MirModule) -> LirLowerResult {
    lirLowerMirModule(l.cfg, mir)
}
// ====================================================================
// Renderer
// ====================================================================
pub fn lirGeneratedHeader() -> String {
    "; Code generated by osty LIR Proto. DO NOT EDIT."
}
pub fn lirRenderModule(m: LirModule) -> String {
    let mut lines: List<String> = []
    let source = if m.sourcePath == "" {
        "<unknown>"
    } else {
        m.sourcePath
    }
    lines.push(lirGeneratedHeader())
    lines.push("; Osty: " + source)
    lines.push("source_filename = \"" + source + "\"")
    if m.target != "" {
        lines.push("target triple = \"" + m.target + "\"")
    }
    lines.push("")
    for td in m.typeDefs {
        lines.push(lirRenderTypeDef(td))
    }
    if m.typeDefs.len() > 0 {
        lines.push("")
    }
    for g in m.globals {
        lines.push(lirRenderGlobal(g))
    }
    for sg in lirStringPoolOrdered(m.stringPool) {
        lines.push(lirRenderStringGlobal(sg))
    }
    if m.globals.len() > 0 || !(lirStringPoolIsEmpty(m.stringPool)) {
        lines.push("")
    }
    for decl in lirRuntimeDeclsOrdered(m.runtimeDecls) {
        lines.push(lirRenderRuntimeDecl(decl))
    }
    if !(lirRuntimeDeclsIsEmpty(m.runtimeDecls)) {
        lines.push("")
    }
    let mut i = 0
    for fn_ in m.functions {
        if i > 0 {
            lines.push("")
        }
        lines.push(lirRenderFunction(fn_))
        i = i + 1
    }
    if m.metadata.len() > 0 {
        if m.functions.len() > 0 {
            lines.push("")
        }
        for md in m.metadata {
            lines.push(md)
        }
    }
    strings.join(lirTrimTrailingBlank(lines), "\n")
}
pub fn lirRenderTypeDef(td: LirTypeDef) -> String {
    td.name + " = type " + td.body
}
pub fn lirRenderGlobal(g: LirGlobal) -> String {
    let init = if g.init == "" {
        "zeroinitializer"
    } else {
        g.init
    }
    let mut parts: List<String> = [g.name, "="]
    if g.linkage != "" {
        parts.push(g.linkage)
    }
    if g.constant {
        parts.push("constant")
    } else {
        parts.push("global")
    }
    parts.push(lirTypeString(g.typ))
    parts.push(init)
    for attr in g.attrs {
        parts.push(attr)
    }
    strings.join(parts, " ")
}
pub fn lirRenderStringGlobal(g: LirStringGlobal) -> String {
    g.symbol + " = private unnamed_addr constant [" + lirIntToString(g.byteLen) + " x i8] c\"" + g.encoded + "\""
}
pub fn lirRenderRuntimeDecl(d: LirRuntimeDecl) -> String {
    let mut params: List<String> = []
    for p in d.params {
        params.push(lirTypeString(p))
    }
    if d.vararg {
        params.push("...")
    }
    "declare " + lirTypeString(d.returnType) + " @" + d.symbol + "(" + strings.join(params, ", ") + ")"
}
pub fn lirRenderFunction(fn_: LirFunction) -> String {
    let ret = if lirTypeIsZero(fn_.returnType) {
        lirVoidType()
    } else {
        fn_.returnType
    }
    let linkage = if fn_.linkage == "" {
        "define"
    } else {
        fn_.linkage
    }
    let mut head: List<String> = [linkage]
    if fn_.callingConv != "" {
        head.push(fn_.callingConv)
    }
    head.push(lirTypeString(ret))
    head.push("@" + fn_.name + "(" + lirRenderParams(fn_.params) + ")")
    for attr in fn_.attrs {
        head.push(attr)
    }
    let mut lines: List<String> = []
    lines.push(strings.join(head, " ") + " \{")
    for block in fn_.blocks {
        let label = if block.label == "" {
            "entry"
        } else {
            block.label
        }
        lines.push(label + ":")
        for instr in block.instrs {
            let text = lirRenderInstr(instr)
            if text != "" {
                lines.push("  " + text)
            }
        }
        let term = lirRenderTerm(block.term)
        if term != "" {
            lines.push("  " + term)
        }
    }
    lines.push("\}")
    strings.join(lines, "\n")
}
pub fn lirRenderParams(params: List<LirParam>) -> String {
    let mut out: List<String> = []
    for p in params {
        let mut head = lirTypeString(p.typ)
        for attr in p.attrs {
            head = head + " " + attr
        }
        if p.name == "" {
            out.push(head)
        } else {
            out.push(head + " " + p.name)
        }
    }
    strings.join(out, ", ")
}
pub fn lirRenderInstr(i: LirInstr) -> String {
    let base = match i.kind {
        LirInstrAlloca -> lirAppendAlign(i.dest + " = alloca " + lirTypeString(i.typ), i.align),
        LirInstrLoad -> lirAppendAlign(i.dest + " = load " + lirTypeString(i.typ) + ", ptr " + i.ptr, i.align),
        LirInstrStore -> lirAppendAlign("store " + lirOperandString(i.value) + ", ptr " + i.ptr, i.align),
        LirInstrBinary -> i.dest + " = " + i.op + " " + lirTypeString(i.typ) + " " + i.left + ", " + i.right,
        LirInstrUnary -> i.dest + " = " + i.op + " " + lirTypeString(i.typ) + " " + i.left,
        LirInstrCall -> lirRenderCallInstr(i),
        LirInstrCast -> i.dest + " = " + i.op + " " + lirOperandString(i.from) + " to " + lirTypeString(i.toType),
        LirInstrInsertValue -> i.dest + " = insertvalue " + lirTypeString(i.typ) + " " + i.aggregate + ", " + lirOperandString(i.value) + ", " + lirRenderIndices(i.indices),
        LirInstrExtractValue -> i.dest + " = extractvalue " + lirTypeString(i.typ) + " " + i.aggregate + ", " + lirRenderIndices(i.indices),
        LirInstrGep -> lirRenderGepInstr(i),
        LirInstrComment -> lirRenderComment(i.text),
        _ -> "",
    }
    if base == "" || i.metadata.len() == 0 {
        return base
    }
    let mut out = base
    for md in i.metadata {
        out = out + ", " + md
    }
    out
}
fn lirRenderCallInstr(i: LirInstr) -> String {
    let ret = if lirTypeIsZero(i.returnType) {
        lirVoidType()
    } else {
        i.returnType
    }
    let mut parts: List<String> = []
    if i.dest != "" {
        parts.push(i.dest)
        parts.push("=")
    }
    parts.push("call")
    if i.callingConv != "" {
        parts.push(i.callingConv)
    }
    parts.push(lirTypeString(ret))
    parts.push(i.callee + "(" + lirRenderOperands(i.args) + ")")
    for attr in i.attrs {
        parts.push(attr)
    }
    strings.join(parts, " ")
}
fn lirRenderGepInstr(i: LirInstr) -> String {
    let op = if i.inbounds {
        "getelementptr inbounds"
    } else {
        "getelementptr"
    }
    i.dest + " = " + op + " " + lirTypeString(i.elemType) + ", ptr " + i.ptr + ", " + lirRenderOperands(i.gepIndices)
}
fn lirRenderComment(text: String) -> String {
    if text == "" {
        return ""
    }
    if strings.slice(text, 0, 1) == ";" {
        return text
    }
    "; " + text
}
pub fn lirRenderTerm(t: LirTerm) -> String {
    let base = match t.kind {
        LirTermRet -> {
            if lirTypeIsZero(t.retType) && t.retValue == "" {
                "ret void"
            } else if lirTypeIsVoid(t.retType) && t.retValue == "" {
                "ret void"
            } else {
                "ret " + lirTypeString(t.retType) + " " + t.retValue
            }
        },
        LirTermBr -> "br label %" + lirTrimLabelPercent(t.target),
        LirTermCondBr -> "br i1 " + t.cond + ", label %" + lirTrimLabelPercent(t.thenLabel) + ", label %" + lirTrimLabelPercent(t.elseLabel),
        LirTermSwitch -> lirRenderSwitchTerm(t),
        LirTermUnreachable -> "unreachable",
        _ -> "",
    }
    if t.loopMDRef != "" {
        return base + ", !llvm.loop " + t.loopMDRef
    }
    base
}
fn lirRenderSwitchTerm(t: LirTerm) -> String {
    let typ = lirTypeString(t.switchType)
    let mut out = "switch " + typ + " " + t.switchScrutinee + ", label %" + lirTrimLabelPercent(t.switchDefault) + " ["
    for c in t.cases {
        out = out + "\n    " + typ + " " + c.value + ", label %" + lirTrimLabelPercent(c.label)
    }
    if t.cases.len() > 0 {
        out = out + "\n  "
    }
    out + "]"
}
pub fn lirRenderOperands(args: List<LirOperand>) -> String {
    let mut out: List<String> = []
    for arg in args {
        out.push(lirOperandString(arg))
    }
    strings.join(out, ", ")
}
pub fn lirRenderIndices(indices: List<Int>) -> String {
    let mut out: List<String> = []
    for idx in indices {
        out.push(lirIntToString(idx))
    }
    strings.join(out, ", ")
}
pub fn lirAppendAlign(line: String, align: Int) -> String {
    if align <= 0 {
        return line
    }
    line + ", align " + lirIntToString(align)
}
pub fn lirTrimTrailingBlank(lines: List<String>) -> List<String> {
    let mut out: List<String> = []
    let mut last = lines.len() - 1
    for _i in 0..lines.len() {
        if last < 0 {
            break
        }
        if lines[last] != "" {
            break
        }
        last = last - 1
    }
    let mut i = 0
    for line in lines {
        if i <= last {
            out.push(line)
        }
        i = i + 1
    }
    out
}
pub fn lirTrimLabelPercent(label: String) -> String {
    if label.len() > 0 && strings.slice(label, 0, 1) == "%" {
        return strings.slice(label, 1, label.len())
    }
    label
}
// ====================================================================
// Validation
// ====================================================================
pub fn lirValidateModule(m: LirModule) -> List<LirDiagnostic> {
    let mut diags: List<LirDiagnostic> = []
    let mut tdIndex = 0
    for td in m.typeDefs {
        let path = "typeDefs[" + lirIntToString(tdIndex) + "]"
        if td.name == "" {
            lirDiagPush(diags, "missing name", path)
        }
        if td.body == "" {
            lirDiagPush(diags, "missing body", path)
        }
        tdIndex = tdIndex + 1
    }
    let mut globIndex = 0
    for g in m.globals {
        let path = "globals[" + lirIntToString(globIndex) + "]"
        if g.name == "" {
            lirDiagPush(diags, "missing name", path)
        }
        lirValidateNonVoidType(diags, g.typ, path + ".typ")
        globIndex = globIndex + 1
    }
    let mut declIndex = 0
    for decl in m.runtimeDecls.decls {
        lirValidateRuntimeDecl(diags, decl, "runtimeDecls[" + lirIntToString(declIndex) + "]")
        declIndex = declIndex + 1
    }
    let mut fnIndex = 0
    for fn_ in m.functions {
        lirValidateFunction(diags, fn_, "functions[" + lirIntToString(fnIndex) + "]")
        fnIndex = fnIndex + 1
    }
    diags
}
fn lirDiagPush(diags: List<LirDiagnostic>, message: String, path: String) {
    diags.push(lirDiagnosticError(LirDiagValidation, message, path))
}
fn lirValidateRuntimeDecl(diags: List<LirDiagnostic>, decl: LirRuntimeDecl, path: String) {
    if decl.symbol == "" {
        lirDiagPush(diags, "missing symbol", path)
    }
    lirValidateType(diags, decl.returnType, true, path + ".return")
    let mut i = 0
    for p in decl.params {
        lirValidateNonVoidType(diags, p, path + ".params[" + lirIntToString(i) + "]")
        i = i + 1
    }
}
fn lirValidateFunction(diags: List<LirDiagnostic>, fn_: LirFunction, path: String) {
    if fn_.name == "" {
        lirDiagPush(diags, "missing name", path)
    }
    if !(lirTypeIsZero(fn_.returnType)) {
        lirValidateType(diags, fn_.returnType, true, path + ".return")
    }
    let mut paramIndex = 0
    for p in fn_.params {
        lirValidateNonVoidType(diags, p.typ, path + ".params[" + lirIntToString(paramIndex) + "]")
        paramIndex = paramIndex + 1
    }
    if fn_.blocks.len() == 0 {
        lirDiagPush(diags, "missing blocks", path)
        return
    }
    lirValidateDuplicateBlockLabels(diags, fn_, path)
    let mut blockIndex = 0
    for block in fn_.blocks {
        lirValidateBlock(diags, block, path + ".blocks[" + lirIntToString(blockIndex) + "]")
        blockIndex = blockIndex + 1
    }
}
fn lirValidateDuplicateBlockLabels(diags: List<LirDiagnostic>, fn_: LirFunction, path: String) {
    let mut i = 0
    for a in fn_.blocks {
        let aLabel = if a.label == "" {
            "entry"
        } else {
            a.label
        }
        let mut j = 0
        for b in fn_.blocks {
            if j > i {
                let bLabel = if b.label == "" {
                    "entry"
                } else {
                    b.label
                }
                if aLabel == bLabel {
                    lirDiagPush(diags, "duplicate block label `" + aLabel + "`", path + ".blocks[" + lirIntToString(j) + "]")
                }
            }
            j = j + 1
        }
        i = i + 1
    }
}
fn lirValidateBlock(diags: List<LirDiagnostic>, block: LirBlock, path: String) {
    let mut instrIndex = 0
    for instr in block.instrs {
        lirValidateInstr(diags, instr, path + ".instrs[" + lirIntToString(instrIndex) + "]")
        instrIndex = instrIndex + 1
    }
    if block.term.kind == LirTermInvalid {
        lirDiagPush(diags, "missing terminator", path)
    } else {
        lirValidateTerm(diags, block.term, path + ".term")
    }
}
fn lirValidateInstr(diags: List<LirDiagnostic>, i: LirInstr, path: String) {
    if i.kind == LirInstrAlloca {
        lirValidateName(diags, i.dest, "missing dest", path + ".dest")
        lirValidateNonVoidType(diags, i.typ, path + ".typ")
        lirValidateAlign(diags, i.align, path + ".align")
        return
    }
    if i.kind == LirInstrLoad {
        lirValidateName(diags, i.dest, "missing dest", path + ".dest")
        lirValidateNonVoidType(diags, i.typ, path + ".typ")
        lirValidateName(diags, i.ptr, "missing ptr", path + ".ptr")
        lirValidateAlign(diags, i.align, path + ".align")
        return
    }
    if i.kind == LirInstrStore {
        lirValidateOperand(diags, i.value, path + ".value")
        lirValidateName(diags, i.ptr, "missing ptr", path + ".ptr")
        lirValidateAlign(diags, i.align, path + ".align")
        return
    }
    if i.kind == LirInstrBinary {
        lirValidateName(diags, i.dest, "missing dest", path + ".dest")
        lirValidateName(diags, i.op, "missing op", path + ".op")
        lirValidateNonVoidType(diags, i.typ, path + ".typ")
        lirValidateName(diags, i.left, "missing left operand", path + ".left")
        lirValidateName(diags, i.right, "missing right operand", path + ".right")
        return
    }
    if i.kind == LirInstrUnary {
        lirValidateName(diags, i.dest, "missing dest", path + ".dest")
        lirValidateName(diags, i.op, "missing op", path + ".op")
        lirValidateNonVoidType(diags, i.typ, path + ".typ")
        lirValidateName(diags, i.left, "missing value", path + ".value")
        return
    }
    if i.kind == LirInstrCall {
        if !(lirTypeIsZero(i.returnType)) {
            lirValidateType(diags, i.returnType, true, path + ".return")
        }
        lirValidateName(diags, i.callee, "missing callee", path + ".callee")
        let mut ai = 0
        for arg in i.args {
            lirValidateOperand(diags, arg, path + ".args[" + lirIntToString(ai) + "]")
            ai = ai + 1
        }
        return
    }
    if i.kind == LirInstrCast {
        lirValidateName(diags, i.dest, "missing dest", path + ".dest")
        lirValidateName(diags, i.op, "missing op", path + ".op")
        lirValidateOperand(diags, i.from, path + ".from")
        lirValidateNonVoidType(diags, i.toType, path + ".to")
        return
    }
    if i.kind == LirInstrInsertValue {
        lirValidateName(diags, i.dest, "missing dest", path + ".dest")
        lirValidateNonVoidType(diags, i.typ, path + ".typ")
        lirValidateName(diags, i.aggregate, "missing aggregate", path + ".aggregate")
        lirValidateOperand(diags, i.value, path + ".value")
        lirValidateIndices(diags, i.indices, path + ".indices")
        return
    }
    if i.kind == LirInstrExtractValue {
        lirValidateName(diags, i.dest, "missing dest", path + ".dest")
        lirValidateNonVoidType(diags, i.typ, path + ".typ")
        lirValidateName(diags, i.aggregate, "missing aggregate", path + ".aggregate")
        lirValidateIndices(diags, i.indices, path + ".indices")
        return
    }
    if i.kind == LirInstrGep {
        lirValidateName(diags, i.dest, "missing dest", path + ".dest")
        lirValidateNonVoidType(diags, i.elemType, path + ".elemType")
        lirValidateName(diags, i.ptr, "missing ptr", path + ".ptr")
        if i.gepIndices.len() == 0 {
            lirDiagPush(diags, "missing GEP indices", path + ".gepIndices")
        }
        let mut gi = 0
        for idx in i.gepIndices {
            lirValidateOperand(diags, idx, path + ".gepIndices[" + lirIntToString(gi) + "]")
            gi = gi + 1
        }
        return
    }
    if i.kind == LirInstrComment {
        return
    }
    lirDiagPush(diags, "invalid instruction kind", path)
}
// B2: payload-less enum dispatch as if-else chain (stage0 P0–P15).
fn lirValidateTerm(diags: List<LirDiagnostic>, t: LirTerm, path: String) {
    if t.kind == LirTermRet {
        if lirTypeIsZero(t.retType) {
            if t.retValue != "" {
                lirDiagPush(diags, "return value without return type", path + ".retValue")
            }
        } else {
            lirValidateType(diags, t.retType, false, path + ".retType")
            lirValidateName(diags, t.retValue, "missing return value", path + ".retValue")
        }
        return
    }
    if t.kind == LirTermBr {
        lirValidateName(diags, t.target, "missing target", path + ".target")
        return
    }
    if t.kind == LirTermCondBr {
        lirValidateName(diags, t.cond, "missing condition", path + ".cond")
        lirValidateName(diags, t.thenLabel, "missing then target", path + ".then")
        lirValidateName(diags, t.elseLabel, "missing else target", path + ".else")
        return
    }
    if t.kind == LirTermSwitch {
        lirValidateNonVoidType(diags, t.switchType, path + ".type")
        lirValidateName(diags, t.switchScrutinee, "missing scrutinee", path + ".scrutinee")
        lirValidateName(diags, t.switchDefault, "missing default", path + ".default")
        let mut i = 0
        for c in t.cases {
            if c.value == "" {
                lirDiagPush(diags, "missing case value", path + ".cases[" + lirIntToString(i) + "].value")
            }
            if c.label == "" {
                lirDiagPush(diags, "missing case label", path + ".cases[" + lirIntToString(i) + "].label")
            }
            i = i + 1
        }
        return
    }
    if t.kind == LirTermUnreachable {
        return
    }
    lirDiagPush(diags, "invalid terminator kind", path)
}
// B2: payload-less enum dispatch as if-else chain (stage0 P0–P15).
fn lirValidateOperand(diags: List<LirDiagnostic>, op: LirOperand, path: String) {
    lirValidateNonVoidType(diags, op.typ, path + ".typ")
    lirValidateName(diags, op.value, "missing value", path + ".value")
}
fn lirValidateType(diags: List<LirDiagnostic>, typ: LirType, allowVoid: Bool, path: String) {
    if lirTypeIsZero(typ) {
        lirDiagPush(diags, "missing type", path)
        return
    }
    if typ.llvm == "" {
        lirDiagPush(diags, "missing LLVM spelling", path)
        return
    }
    if typ.className == LirTypeUnknown {
        return
    }
    if typ.className == LirTypeVoid {
        if typ.llvm != "void" {
            lirDiagPush(diags, "class void has LLVM spelling `" + typ.llvm + "`", path)
        }
        if !(allowVoid) {
            lirDiagPush(diags, "void is not allowed here", path)
        }
        return
    }
    if typ.className == LirTypeInt {
        if !(lirIsIntegerLLVMType(typ.llvm)) {
            lirDiagPush(diags, "class int has LLVM spelling `" + typ.llvm + "`", path)
        }
        return
    }
    if typ.className == LirTypeFloat {
        if !(lirIsFloatLLVMType(typ.llvm)) {
            lirDiagPush(diags, "class float has LLVM spelling `" + typ.llvm + "`", path)
        }
        return
    }
    if typ.className == LirTypePtr {
        if typ.llvm != "ptr" {
            lirDiagPush(diags, "class ptr has LLVM spelling `" + typ.llvm + "`", path)
        }
        return
    }
    if typ.className == LirTypeAggregate {
        if !(lirIsAggregateLLVMType(typ.llvm)) {
            lirDiagPush(diags, "class aggregate has LLVM spelling `" + typ.llvm + "`", path)
        }
        return
    }
    if typ.className == LirTypeFunction {
        if !(strings.contains(typ.llvm, "(")) {
            lirDiagPush(diags, "class function has LLVM spelling `" + typ.llvm + "`", path)
        }
    }
}
// B2: payload-less enum dispatch as if-else chain (stage0 P0–P15).
fn lirValidateNonVoidType(diags: List<LirDiagnostic>, typ: LirType, path: String) {
    lirValidateType(diags, typ, false, path)
}
fn lirValidateName(diags: List<LirDiagnostic>, text: String, message: String, path: String) {
    if text == "" {
        lirDiagPush(diags, message, path)
    }
}
fn lirValidateAlign(diags: List<LirDiagnostic>, align: Int, path: String) {
    if align < 0 {
        lirDiagPush(diags, "negative alignment", path)
    }
}
fn lirValidateIndices(diags: List<LirDiagnostic>, indices: List<Int>, path: String) {
    if indices.len() == 0 {
        lirDiagPush(diags, "missing indices", path)
        return
    }
    let mut i = 0
    for idx in indices {
        if idx < 0 {
            lirDiagPush(diags, "negative index", path + "[" + lirIntToString(i) + "]")
        }
        i = i + 1
    }
}
// ====================================================================
// Type and ABI planning helpers
// ====================================================================
pub fn lirLowerPrimitiveTypeName(name: String) -> LirType {
    if name == "Int" {
        return lirIntType(64)
    }
    if name == "Int8" {
        return lirIntType(8)
    }
    if name == "Int16" {
        return lirIntType(16)
    }
    if name == "Int32" {
        return lirIntType(32)
    }
    if name == "Int64" {
        return lirIntType(64)
    }
    if name == "UInt8" {
        return lirIntType(8)
    }
    if name == "UInt16" {
        return lirIntType(16)
    }
    if name == "UInt32" {
        return lirIntType(32)
    }
    if name == "UInt64" {
        return lirIntType(64)
    }
    if name == "Byte" {
        return lirIntType(8)
    }
    if name == "Bool" {
        return lirIntType(1)
    }
    if name == "Char" {
        return lirIntType(32)
    }
    if name == "Float" {
        return lirFloatType("double")
    }
    if name == "Float32" {
        return lirFloatType("float")
    }
    if name == "Float64" {
        return lirFloatType("double")
    }
    if name == "String" {
        return lirPtrType()
    }
    if name == "Bytes" {
        return lirPtrType()
    }
    if name == "RawPtr" {
        return lirPtrType()
    }
    if name == "Unit" {
        return lirVoidType()
    }
    if name == "()" {
        return lirVoidType()
    }
    if name == "Never" {
        return lirVoidType()
    }
    lirTypeInvalid()
}
pub fn lirPrimitiveTypeSupported(name: String) -> Bool {
    !(lirTypeIsZero(lirLowerPrimitiveTypeName(name)))
}
pub fn lirIsRefBuiltinTypeName(name: String) -> Bool {
    name == "TaskGroup" || name == "Select" || strings.startsWith(name, "List<") || strings.startsWith(name, "Map<") || strings.startsWith(name, "Set<") || strings.startsWith(name, "Channel<") || strings.startsWith(name, "Handle<") || strings.startsWith(name, "Box<") || strings.startsWith(name, "TaskGroup<") || strings.startsWith(name, "Select<")
}
pub fn lirPrimitiveTypeIsUnsigned(name: String) -> Bool {
    name == "UInt8" || name == "UInt16" || name == "UInt32" || name == "UInt64" || name == "Byte"
}
pub fn lirPrimitiveTypeIsScalarByValue(name: String) -> Bool {
    let typ = lirLowerPrimitiveTypeName(name)
    if typ.className == LirTypeInt {
        return true
    }
    if typ.className == LirTypeFloat {
        return true
    }
    if typ.className == LirTypePtr {
        return true
    }
    false
}
pub fn lirIsCanonicalScalarLLVMType(llvm: String) -> Bool {
    if llvm == "ptr" {
        return true
    }
    if lirIsIntegerLLVMType(llvm) {
        return true
    }
    if lirIsFloatLLVMType(llvm) {
        return true
    }
    false
}
pub fn lirIsIntegerLLVMType(llvm: String) -> Bool {
    if llvm == "i1" {
        return true
    }
    if llvm == "i8" {
        return true
    }
    if llvm == "i16" {
        return true
    }
    if llvm == "i32" {
        return true
    }
    if llvm == "i64" {
        return true
    }
    if llvm == "i128" {
        return true
    }
    false
}
pub fn lirIntegerBitWidth(llvm: String) -> Int {
    if llvm == "i1" {
        return 1
    }
    if llvm == "i8" {
        return 8
    }
    if llvm == "i16" {
        return 16
    }
    if llvm == "i32" {
        return 32
    }
    if llvm == "i64" {
        return 64
    }
    if llvm == "i128" {
        return 128
    }
    0
}
pub fn lirIsFloatLLVMType(llvm: String) -> Bool {
    if llvm == "float" {
        return true
    }
    if llvm == "double" {
        return true
    }
    if llvm == "fp128" {
        return true
    }
    false
}
pub fn lirFloatBitWidth(llvm: String) -> Int {
    if llvm == "float" {
        return 32
    }
    if llvm == "double" {
        return 64
    }
    if llvm == "fp128" {
        return 128
    }
    0
}
pub fn lirIsAggregateLLVMType(llvm: String) -> Bool {
    if llvm == "" {
        return false
    }
    if strings.slice(llvm, 0, 1) == "%" {
        return true
    }
    if strings.slice(llvm, 0, 1) == "\{" {
        return true
    }
    if strings.slice(llvm, 0, 1) == "[" {
        return true
    }
    false
}
/// lirPlanScalarCastOpcode returns the LLVM opcode needed to convert between
/// scalar LLVM types. Empty means either no conversion is needed or the pair is
/// unsupported by this scalar-only planner.
pub fn lirPlanScalarCastOpcode(from: LirType, to: LirType, unsigned: Bool) -> String {
    if from.llvm == to.llvm {
        return ""
    }
    if from.className == LirTypeInt && to.className == LirTypeInt {
        let fb = lirIntegerBitWidth(from.llvm)
        let tb = lirIntegerBitWidth(to.llvm)
        if fb == 0 || tb == 0 {
            return ""
        }
        if fb < tb {
            if unsigned {
                return "zext"
            }
            return "sext"
        }
        if fb > tb {
            return "trunc"
        }
        return ""
    }
    if from.className == LirTypeInt && to.className == LirTypeFloat {
        if unsigned {
            return "uitofp"
        }
        return "sitofp"
    }
    if from.className == LirTypeFloat && to.className == LirTypeInt {
        if unsigned {
            return "fptoui"
        }
        return "fptosi"
    }
    if from.className == LirTypeFloat && to.className == LirTypeFloat {
        let fb = lirFloatBitWidth(from.llvm)
        let tb = lirFloatBitWidth(to.llvm)
        if fb == 0 || tb == 0 {
            return ""
        }
        if fb < tb {
            return "fpext"
        }
        if fb > tb {
            return "fptrunc"
        }
        return ""
    }
    if from.className == LirTypePtr && to.className == LirTypePtr {
        return "bitcast"
    }
    ""
}
/// lirPlanSameFamilyCoercionOpcode is narrower than explicit casts: it only
/// permits integer resize and float resize. Cross-family conversion must come
/// from MIR as an explicit cast node.
pub fn lirPlanSameFamilyCoercionOpcode(from: LirType, to: LirType, unsigned: Bool) -> String {
    if from.llvm == to.llvm {
        return ""
    }
    if from.className == LirTypeInt && to.className == LirTypeInt {
        return lirPlanScalarCastOpcode(from, to, unsigned)
    }
    if from.className == LirTypeFloat && to.className == LirTypeFloat {
        return lirPlanScalarCastOpcode(from, to, unsigned)
    }
    ""
}
pub fn lirCastInstrForCoercion(dest: String, from: LirOperand, to: LirType, unsigned: Bool) -> LirInstr {
    let op = lirPlanSameFamilyCoercionOpcode(from.typ, to, unsigned)
    if op == "" {
        return lirInstrInvalid()
    }
    lirCast(dest, op, from, to)
}
pub fn lirRuntimeIOWriteDecl() -> LirRuntimeDecl {
    lirRuntimeDecl("osty_rt_io_write", lirVoidType(), [lirPtrType(), lirIntType(1), lirIntType(1)], false)
}
pub fn lirRuntimeToStringDecl(symbol: String, argType: LirType) -> LirRuntimeDecl {
    lirRuntimeDecl(symbol, lirPtrType(), [argType], false)
}
pub fn lirRuntimeToStringSymbolForType(typ: LirType) -> String {
    if typ.llvm == "i64" {
        return "osty_rt_int_to_string"
    }
    if typ.llvm == "double" {
        return "osty_rt_float_to_string"
    }
    if typ.llvm == "i1" {
        return "osty_rt_bool_to_string"
    }
    if typ.llvm == "i32" {
        return "osty_rt_char_to_string"
    }
    if typ.llvm == "i8" {
        return "osty_rt_byte_to_string"
    }
    ""
}
// Two LirRuntimeDecl shapes are reused beyond their single Phase-4 emit
// site (StringIsEmpty's ByteLen + StringConcatBinary's Concat); inline
// `lirRuntimeDecl(symbol, retType, paramTypes, false)` is used directly
// for one-off shapes so the dispatch table at lirLowerMirIntrinsic stays
// the only catalog of Phase-4 ABI signatures.
pub fn lirRuntimeDeclI64FromPtr(symbol: String) -> LirRuntimeDecl {
    lirRuntimeDecl(symbol, lirIntType(64), [lirPtrType()], false)
}
pub fn lirRuntimeDeclPtrFromTwoPtr(symbol: String) -> LirRuntimeDecl {
    lirRuntimeDecl(symbol, lirPtrType(), [lirPtrType(), lirPtrType()], false)
}
// Map an LIR scalar return type back to the canonical MIR type name so
// `lirStoreMirResult` can run its same-family coercion path. Pointers
// and aggregates map to "" so the storer treats them as opaque ptr
// (no further coercion). Driven by `LirTypeClass` + bit-width rather
// than raw `t.llvm` strings so changes to LIR type spelling do not silently
// drop runtime-result coercion.
pub fn lirRuntimeReturnTypeName(t: LirType) -> String {
    if t.className == LirTypeInt {
        if t.llvm == "i1" {
            return "Bool"
        }
        if t.llvm == "i8" {
            return "Byte"
        }
        if t.llvm == "i32" {
            return "Char"
        }
        return "Int"
    }
    if t.className == LirTypeFloat {
        if t.llvm == "float" {
            return "Float32"
        }
        return "Float"
    }
    ""
}
// B2: payload-less enum dispatch as if-else chain (stage0 P0–P15).
// ====================================================================
// Aggregate and projection planning helpers
// ====================================================================
pub struct LirProjectionStep {
    pub kind: LirProjectionKind,
    pub index: Int,
    pub name: String,
    pub typ: LirType,
}
pub fn lirFieldProjection(index: Int, name: String, typ: LirType) -> LirProjectionStep {
    LirProjectionStep {kind: LirProjField, index, name, typ}
}
pub fn lirTupleProjection(index: Int, typ: LirType) -> LirProjectionStep {
    LirProjectionStep {kind: LirProjTuple, index, name: "", typ}
}
pub fn lirVariantProjection(index: Int, name: String, typ: LirType) -> LirProjectionStep {
    LirProjectionStep {kind: LirProjVariant, index, name, typ}
}
pub fn lirIndexProjection(index: Int, typ: LirType) -> LirProjectionStep {
    LirProjectionStep {kind: LirProjIndex, index, name: "", typ}
}
pub struct LirProjectedStorePlan {
    pub rootPtr: String,
    pub rootType: LirType,
    pub leafValue: LirOperand,
    pub steps: List<LirProjectionStep>,
}
pub fn lirProjectedStorePlan(rootPtr: String, rootType: LirType, leafValue: LirOperand, steps: List<LirProjectionStep>) -> LirProjectedStorePlan {
    LirProjectedStorePlan {rootPtr, rootType, leafValue, steps}
}
pub fn lirProjectionStepIndex(step: LirProjectionStep) -> Int {
    step.index
}
pub fn lirProjectionPathIndices(steps: List<LirProjectionStep>) -> List<Int> {
    let mut out: List<Int> = []
    for step in steps {
        out.push(lirProjectionStepIndex(step))
    }
    out
}
pub fn lirProjectionPathText(steps: List<LirProjectionStep>) -> String {
    let mut parts: List<String> = []
    for step in steps {
        if step.kind == LirProjField {
            if step.name == "" {
                parts.push(".field" + lirIntToString(step.index))
            } else {
                parts.push("." + step.name)
            }
        } else if step.kind == LirProjTuple {
            parts.push("." + lirIntToString(step.index))
        } else if step.kind == LirProjVariant {
            parts.push("@" + step.name)
        } else if step.kind == LirProjIndex {
            parts.push("[" + lirIntToString(step.index) + "]")
        } else if step.kind == LirProjDeref {
            parts.push(".*")
        } else {
            parts.push(".?")
        }
    }
    strings.join(parts, "")
}
// B2: payload-less enum dispatch as if-else chain (stage0 P0–P15).
pub struct LirProjectionFrame {
    pub aggregate: LirOperand,
    pub index: Int,
}
pub fn lirProjectionFrame(aggregate: LirOperand, index: Int) -> LirProjectionFrame {
    LirProjectionFrame {aggregate, index}
}
pub fn lirTupleTypeNameFromTypes(types: List<LirType>) -> String {
    let mut tags: List<String> = []
    for typ in types {
        tags.push(lirLLVMTypeTag(typ.llvm))
    }
    "%osty.tuple." + strings.join(tags, ".")
}
pub fn lirTupleTypeBody(types: List<LirType>) -> String {
    let mut parts: List<String> = []
    for typ in types {
        parts.push(lirTypeString(typ))
    }
    "\{ " + strings.join(parts, ", ") + " \}"
}
pub fn lirNamedTypeLayoutKey(packageName: String, builtin: Bool, name: String) -> String {
    if builtin {
        return "builtin:" + name
    }
    if packageName == "" {
        return name
    }
    packageName + "." + name
}
pub fn lirLLVMTypeTag(llvm: String) -> String {
    let mut out = llvm
    out = strings.replaceAll(out, "%", "named_")
    out = strings.replaceAll(out, " ", "_")
    out = strings.replaceAll(out, "*", "ptr")
    out = strings.replaceAll(out, ",", "_")
    out = strings.replaceAll(out, "\{", "struct_")
    out = strings.replaceAll(out, "\}", "")
    out = strings.replaceAll(out, "[", "array_")
    out = strings.replaceAll(out, "]", "")
    if out == "" {
        return "unknown"
    }
    out
}
// ====================================================================
// MIR -> LIR Proto lowering, self-host surface
// ====================================================================
pub struct LirLocalSlot {
    pub id: Int,
    pub slot: String,
    pub typ: LirType,
}
pub struct LirBlockLabel {
    pub id: Int,
    pub label: String,
}
pub struct LirMirFunctionLowerer {
    pub cfg: LirLowerConfig,
    pub mirModule: MirModule,
    pub fn_: MirFunction,
    pub out: LirModule,
    pub diagnostics: List<LirDiagnostic>,
    pub prologue: List<LirInstr>,
    pub instrs: List<LirInstr>,
    pub slots: List<LirLocalSlot>,
    pub labels: List<LirBlockLabel>,
    pub temp: Int,
    pub safepointSerial: Int,
    pub currentBlockLabel: String,
    pub extraBlocks: List<LirBlock>,
    pub auxLabel: Int,
    pub gcRootSlots: List<String>,
    pub parallelAccessGroupRef: String,
}
// `parallelAccessGroupRef` lazily caches the `!N` access-group
// metadata reference for the current function. Populated on first
// demand inside `#[parallel]` functions and reused by both the
// per-loop `parallel_accesses` property and the per-instruction
// `!llvm.access.group` trailers.
// `lirEmitMirGlobals` mirrors production `emitGlobalVars`
// (mir_generator.go:1508). Pushes:
//   1. `@<name> = global <T> zeroinitializer` for each MIR global.
//   2. A synthetic `define private void @__osty_init_globals()` ctor
//      that calls each init fn and stores its return into the global.
//      Skipped if no global has an init.
//   3. `@llvm.global_ctors = appending global [...]` registration so
//      the ctor runs before main.
// When `mir.globals` is empty nothing is emitted — same as production.
fn lirEmitMirGlobals(out: LirModule, mir: MirModule, diags: List<LirDiagnostic>) {
    if mir.globals.len() == 0 {
        return
    }
    for glob in mir.globals {
        let typ = lirLowerMirType_module(out, mir, glob.typ, "global." + glob.name, diags)
        if lirTypeIsZero(typ) || lirTypeIsVoid(typ) {
            continue
        }
        out.globals.push(lirGlobal("@" + glob.name, typ, ""))
    }
    let mut hasInit = false
    for glob in mir.globals {
        if glob.hasInit && glob.initSymbol != "" && lirModuleHasGlobal(out, "@" + glob.name) {
            hasInit = true
        }
    }
    if !(hasInit) {
        return
    }
    let ctor = lirBuildInitGlobalsCtor(out, mir, diags)
    out.functions.push(ctor)
    out.globals.push(lirGlobalWithLinkage("@llvm.global_ctors", lirRawType("[1 x \{ i32, ptr, ptr \}]"), "[\{ i32, ptr, ptr \} \{ i32 65535, ptr @__osty_init_globals, ptr null \}]", "appending"))
}
// No init functions: skip ctor + global_ctors registration.
// Programs whose globals are zero-initialised are correct
// without a ctor (LLVM zeros them at module load).
// Module-context type lowering for a top-level type name. The normal
// `lirLowerMirType` requires a `LirMirFunctionLowerer`; for
// module-level globals we don't have one. Reproduce the relevant
// portion (primitives + Option/Result/struct/tuple shape).
//
// On fall-through (no resolution path matched), the diagnostic enumerates
// *which checks were attempted* so the root cause of an "unsupported param
// type"/"unsupported local type" upstream failure can be traced without
// reading the source. GAP-TYP-004 (LLVM_BACKEND_GAP_PLAN.md A1).
//
// Option/Result with struct payload (C1, GAP-TYP-004 part 2): when the
// payload is a registered struct in `mir.layouts.structs`, the aggregate
// type is `{i64, %StructTy}` rather than the default `{i64, i64}` so the
// payload field can hold the full struct value (>8 bytes). The struct type
// must be looked up in the same layout table so the named struct typedef
// is emitted before the Option/Result typedef references it.
fn lirLowerMirType_module(out: LirModule, mir: MirModule, name: String, path: String, diags: List<LirDiagnostic>) -> LirType {
    let primitive = lirLowerPrimitiveTypeName(name)
    if !(lirTypeIsZero(primitive)) {
        return primitive
    }
    if lirIsRefBuiltinTypeName(name) {
        return lirPtrType()
    }
    if lirMirModuleHasInterfaceLayout(mir, name) {
        lirDeclareIfaceType(out)
        return lirAggregateType(lirIfaceTypeName())
    }
    if lirIsOptionTypeName(name) || lirIsResultTypeName(name) {
        let typeName = "%" + lirMangleAlgebraicTypeName(name)
        let bodyText = lirAlgebraicAggregateBody_module(out, mir, name)
        lirModuleDeclareTypeDef(out, lirTypeDef(typeName, bodyText))
        return lirAggregateType(typeName)
    }
    for layout in mir.layouts.structs {
        if lirMirStructLayoutMatches(layout, name) {
            let typeName = "%" + if layout.mangled == "" {
                layout.name
            } else {
                layout.mangled
            }
            return lirAggregateType(typeName)
        }
    }
    let layoutCount = mir.layouts.structs.len()
    let interfaceCount = mir.layouts.interfaces.len()
    let trace = "primitive miss; ref-builtin miss; option/result miss; " + lirIntToString(interfaceCount) + " interface layout(s) checked, no match; " + lirIntToString(layoutCount) + " struct layout(s) checked, no match"
    diags.push(lirDiagnosticError(LirDiagUnsupported, "unsupported module type `" + name + "` (" + trace + ")", path))
    lirTypeInvalid()
}
// Composite layout — only resolve those already in the MIR module.
// Trace: enumerate every check that ran so root-cause is visible without
// reading the source. Each "no match" branch above is a candidate; we
// report the cumulative attempt + struct-layout coverage size.
fn lirIfaceTypeName() -> String {
    "%osty.iface"
}
fn lirDeclareIfaceType(out: LirModule) {
    lirModuleDeclareTypeDef(out, lirTypeDef(lirIfaceTypeName(), "\{ ptr, ptr \}"))
}
fn lirMirModuleHasInterfaceLayout(mir: MirModule, name: String) -> Bool {
    for layout in mir.layouts.interfaces {
        if lirMirInterfaceLayoutMatches(layout, name) {
            return true
        }
    }
    false
}
// `lirAlgebraicAggregateBody_module` builds the LLVM type body string for an
// `Option<T>` / `Result<T, E>` aggregate. Default shape is `{ i64, i64 }`
// (tag + i64-sized payload), but when the payload type is a registered
// struct in `mir.layouts.structs` the payload slot widens to the full
// `%StructName` aggregate so values >8 bytes fit (C1, GAP-TYP-004 part 2).
//
// `Result<T, E>` widens for whichever side is a struct — the tag layout
// keeps both Ok and Err slots in the *same* aggregate so we widen to the
// max size of {Ok struct, Err struct} when either is a struct. For the
// initial baseline we widen the *Ok side only* (Err is typically the
// `Error` interface = ptr-sized or an enum-typed sum), but Err side is
// covered by the same fallback when `lirOptionResultStructPayload` finds a
// match.
//
// Struct typedef must already be emitted (via the composite layout pass);
// the aggregate body references it by `%StructMangled`. Recurse into
// `lirLowerMirType_module` would loop, so we look up the struct directly
// in `mir.layouts.structs` and reuse the mangled name.
fn lirAlgebraicAggregateBody_module(out: LirModule, mir: MirModule, name: String) -> String {
    let payloadInner = lirOptionResultPayloadInner(name)
    if payloadInner == "" {
        return "\{ i64, i64 \}"
    }
    let structRef = lirMirStructTypeRefByName(mir, payloadInner)
    if structRef == "" {
        return "\{ i64, i64 \}"
    }
    "\{ i64, " + structRef + " \}"
}
// Ensure the struct typedef is forward-declared at the top of the
// module so this Option<S> typedef can reference it. The composite
// pass below also emits it; declaring twice is a no-op for a typedef
// module table keyed by name (lirModuleDeclareTypeDef is idempotent).
// `lirOptionResultPayloadInner` extracts the *payload type name* from a
// canonical `Option<T>` / `Result<T, E>` spelling. Returns "" when the
// shape does not match (caller falls back to the default `{i64, i64}`).
//
// For `Result<T, E>` the payload that may be a struct is conventionally
// `T` (the Ok side); the Err side is typically `Error` (ptr) or a small
// enum. We return the first generic argument — extending to a wider Err
// payload is a follow-up.
fn lirOptionResultPayloadInner(name: String) -> String {
    if lirIsOptionTypeName(name) {
        if strings.startsWith(name, "Option<") {
            return lirContainerInnerArg(name, "Option<")
        }
        if strings.startsWith(name, "Maybe<") {
            return lirContainerInnerArg(name, "Maybe<")
        }
        return ""
    }
    if lirIsResultTypeName(name) {
        let inner = lirContainerInnerArg(name, "Result<")
        if inner == "" {
            return ""
        }
        return lirSplitFirstGenericArg(inner)
    }
    ""
}
// "Option<X>" or "Maybe<X>"
// "Result<T, E>" — split the first comma-separated arg (T).
// `lirSplitFirstGenericArg` returns the first comma-separated top-level
// argument from a generic argument list ("T, E" -> "T"). Tracks angle
// bracket depth so nested generics are not split mid-arg
// ("Map<K, V>, Error" -> "Map<K, V>").
fn lirSplitFirstGenericArg(args: String) -> String {
    let mut depth = 0
    let mut out = ""
    let chars = strings.chars(args)
    for ch in chars {
        if ch == '<' {
            depth = depth + 1
            out = out + strings.fromChar(ch)
        } else if ch == '>' {
            depth = depth - 1
            out = out + strings.fromChar(ch)
        } else if ch == ',' && depth == 0 {
            return strings.trim(out)
        } else {
            out = out + strings.fromChar(ch)
        }
    }
    strings.trim(out)
}
// `lirMirStructTypeRefByName` returns the LLVM type reference (`%Mangled`)
// for a named struct in `mir.layouts.structs`, or "" when not found. Used
// by Option/Result aggregate widening so we don't recurse through
// `lirLowerMirType_module`.
fn lirMirStructTypeRefByName(mir: MirModule, name: String) -> String {
    for layout in mir.layouts.structs {
        if lirMirStructLayoutMatches(layout, name) {
            let identifier = if layout.mangled == "" {
                layout.name
            } else {
                layout.mangled
            }
            return "%" + identifier
        }
    }
    ""
}
// `lirBuildInitGlobalsCtor` synthesises the
// `define private void @__osty_init_globals()` function that, for
// each global with `hasInit`, calls the init fn and stores into the
// global. Mirrors production `mirInitGlobalsCtorHeader / Footer /
// StoreSequence` (mir_generator_snapshot.go).
fn lirBuildInitGlobalsCtor(out: LirModule, mir: MirModule, diags: List<LirDiagnostic>) -> LirFunction {
    let mut fn_ = lirFunction("__osty_init_globals", lirVoidType())
    fn_.linkage = "private"
    let mut entry = lirBlock("entry", lirRetVoid())
    for glob in mir.globals {
        if !(glob.hasInit) || glob.initSymbol == "" {
            continue
        }
        if !(lirModuleHasGlobal(out, "@" + glob.name)) {
            continue
        }
        let initRet = lirLowerMirType_module(out, mir, glob.typ, "global." + glob.name + ".init", diags)
        if lirTypeIsZero(initRet) || lirTypeIsVoid(initRet) {
            continue
        }
        let tmp = "%v" + glob.name
        entry.instrs.push(lirCall(tmp, initRet, "@" + glob.initSymbol, []))
        entry.instrs.push(lirStore(lirOperand(initRet, tmp), "@" + glob.name, 0))
    }
    fn_.blocks.push(entry)
    fn_
}
fn lirModuleHasGlobal(m: LirModule, name: String) -> Bool {
    for g in m.globals {
        if g.name == name {
            return true
        }
    }
    false
}
fn lirEmitInterfaceVTables(out: LirModule, mir: MirModule, diags: List<LirDiagnostic>) {
    for layout in mir.layouts.interfaces {
        if layout.name == "" {
            continue
        }
        for impl in layout.impls {
            if impl.implName == "" {
                continue
            }
            let vtableSym = lirInterfaceVTableSymbol(layout, impl)
            let mut entries: List<String> = []
            for method in layout.methods {
                if lirEmitInterfaceShim(out, mir, layout, impl, method, diags) {
                    entries.push("ptr @" + lirInterfaceShimSymbol(impl.implName, layout.name, method.name))
                } else {
                    entries.push("ptr null")
                }
            }
            let count = layout.methods.len()
            let init = if entries.len() == 0 {
                "zeroinitializer"
            } else {
                "[" + strings.join(entries, ", ") + "]"
            }
            out.globals.push(lirGlobalConstant(vtableSym, lirRawType("[" + lirIntToString(count) + " x ptr]"), init))
        }
    }
}
fn lirInterfaceVTableSymbol(layout: MirInterfaceLayout, impl: MirInterfaceImpl) -> String {
    if impl.vtableSym != "" {
        return impl.vtableSym
    }
    "@osty.vtable." + impl.implName + "__" + layout.name
}
fn lirInterfaceShimSymbol(implName: String, ifaceName: String, methodName: String) -> String {
    "osty.shim." + implName + "__" + ifaceName + "__" + methodName
}
fn lirInterfaceConcreteMethodSymbol(implName: String, methodName: String) -> String {
    implName + "__" + methodName
}
fn lirEmitInterfaceShim(out: LirModule, mir: MirModule, layout: MirInterfaceLayout, impl: MirInterfaceImpl, method: MirInterfaceMethod, diags: List<LirDiagnostic>) -> Bool {
    if method.name == "" {
        return false
    }
    let concreteSymbol = lirInterfaceConcreteMethodSymbol(impl.implName, method.name)
    let concrete = lirLookupMirFunction(mir, concreteSymbol)
    if concrete.name == "" {
        diags.push(lirDiagnosticError(LirDiagUnsupported, "interface `" + layout.name + "` impl `" + impl.implName + "` has no concrete method `" + concreteSymbol + "`", "interface." + layout.name))
        return false
    }
    if concrete.params.len() == 0 {
        diags.push(lirDiagnosticError(LirDiagUnsupported, "interface shim `" + concreteSymbol + "` has no receiver parameter", "interface." + layout.name + "." + method.name))
        return false
    }
    let selfLocal = mirFunctionLocal(concrete, concrete.params[0])
    if selfLocal.id < 0 {
        diags.push(lirDiagnosticError(LirDiagInvalidInput, "interface shim `" + concreteSymbol + "` receiver local is out of range", "interface." + layout.name + "." + method.name))
        return false
    }
    let selfType = lirLowerMirType_module(out, mir, selfLocal.typ, "interface." + layout.name + "." + method.name + ".self", diags)
    let retType = lirLowerMirType_module(out, mir, concrete.returnType, "interface." + layout.name + "." + method.name + ".return", diags)
    if lirTypeIsZero(selfType) || lirTypeIsVoid(selfType) || lirTypeIsZero(retType) {
        return false
    }
    let mut fn_ = lirFunction(lirInterfaceShimSymbol(impl.implName, layout.name, method.name), retType)
    fn_.params.push(lirParam("%self_data", lirPtrType()))
    let mut args: List<LirOperand> = []
    let mut entry = lirBlock("entry", if lirTypeIsVoid(retType) {
        lirRetVoid()
    } else {
        lirRetValue(retType, "%res")
    })
    entry.instrs.push(lirLoad("%self", selfType, "%self_data", 8))
    args.push(lirOperand(selfType, "%self"))
    let mut skipSelf = true
    let mut argIndex = 0
    for id in concrete.params {
        if skipSelf {
            skipSelf = false
            continue
        }
        let loc = mirFunctionLocal(concrete, id)
        if loc.id < 0 {
            diags.push(lirDiagnosticError(LirDiagInvalidInput, "interface shim `" + concreteSymbol + "` parameter local is out of range", "interface." + layout.name + "." + method.name))
            return false
        }
        let paramType = lirLowerMirType_module(out, mir, loc.typ, "interface." + layout.name + "." + method.name + ".arg", diags)
        if lirTypeIsZero(paramType) || lirTypeIsVoid(paramType) {
            return false
        }
        let paramName = "%a" + lirIntToString(argIndex)
        fn_.params.push(lirParam(paramName, paramType))
        args.push(lirOperand(paramType, paramName))
        argIndex = argIndex + 1
    }
    if lirTypeIsVoid(retType) {
        entry.instrs.push(lirCall("", retType, "@" + lirRenderedMirFunctionName(concrete), args))
    } else {
        entry.instrs.push(lirCall("%res", retType, "@" + lirRenderedMirFunctionName(concrete), args))
    }
    fn_.blocks.push(entry)
    out.functions.push(fn_)
    true
}
pub fn lirLowerMirModule(cfg: LirLowerConfig, mir: MirModule) -> LirLowerResult {
    let packageName = if cfg.packageName == "" {
        mir.packageName
    } else {
        cfg.packageName
    }
    let mut out = lirModule(packageName, cfg.sourcePath, cfg.target)
    let mut diags: List<LirDiagnostic> = []
    lirEmitMirGlobals(out, mir, diags)
    lirLowerMirUses(out, mir)
    lirEmitInterfaceVTables(out, mir, diags)
    for fn_ in mir.functions {
        let lowered = lirLowerMirFunction(cfg, mir, out, fn_)
        for d in lowered.diagnostics {
            diags.push(d)
        }
        if !(lirLowerHasErrors(lowered)) {
            if lowered.module.functions.len() > 0 {
                out.functions.push(lowered.module.functions[0])
            }
            for td in lowered.module.typeDefs {
                lirModuleDeclareTypeDef(out, td)
            }
            for decl in lowered.module.runtimeDecls.decls {
                lirRuntimeDeclsDeclare(out.runtimeDecls, decl)
            }
            for sg in lowered.module.stringPool.entries {
                lirStringPoolInternKnown(out.stringPool, sg.content, sg.encoded, sg.byteLen)
            }
        }
    }
    for d in lirValidateModule(out) {
        diags.push(d)
    }
    LirLowerResult {module: out, diagnostics: diags}
}
// Module-level globals: emit `@<name> = global <T> zeroinitializer`,
// build a `@__osty_init_globals` ctor that calls each init fn and
// stores into the global, and register the ctor via
// `@llvm.global_ctors`. Mirrors production `emitGlobalVars`
// (mir_generator.go:1508). When MIR has no globals nothing is
// emitted — same as production.
// MIR `use` declarations are already resolved before MIR reaches this
// lowerer. Non-FFI package imports therefore need no LLVM artifact, while
// FFI surfaces arrive as external MIR functions and are declared by the
// normal call/function lowering path. Keep the edges visible as comments
// for traceability but do not decline the module.
fn lirLowerMirUses(out: LirModule, mir: MirModule) {
    for u in mir.uses {
        let mut text = "; MIR use "
        if u.isGoFFI {
            text = text + "go \"" + u.goPath + "\""
        } else if u.isRuntimeFFI {
            text = text + "runtime \"" + u.runtimePath + "\""
        } else {
            text = text + u.rawPath
        }
        if u.alias != "" {
            text = text + " as " + u.alias
        }
        out.metadata.push(text)
    }
}
pub fn lirLowerMirFunction(cfg: LirLowerConfig, mir: MirModule, module: LirModule, fn_: MirFunction) -> LirLowerResult {
    let mut l = LirMirFunctionLowerer {cfg, mirModule: mir, fn_, out: lirModule(module.packageName, module.sourcePath, module.target), diagnostics: [], prologue: [], instrs: [], slots: [], labels: [], temp: 0, safepointSerial: 0, currentBlockLabel: "", extraBlocks: [], auxLabel: 0, gcRootSlots: [], parallelAccessGroupRef: ""}
    l.out.typeDefs = module.typeDefs
    l.out.runtimeDecls = module.runtimeDecls
    l.out.stringPool = module.stringPool
    let name = lirRenderedMirFunctionName(fn_)
    if name == "" {
        lirLowerError(l, LirDiagInvalidInput, "MIR function has empty name", "function.name")
    }
    if fn_.isExternal || fn_.isIntrinsic {
        let externRet = lirLowerMirType(l, fn_.returnType)
        let mut externParams: List<LirType> = []
        for id in fn_.params {
            let loc = mirFunctionLocal(fn_, id)
            if loc.id < 0 {
                continue
            }
            externParams.push(lirLowerMirType(l, loc.typ))
        }
        lirRuntimeDeclsDeclare(l.out.runtimeDecls, lirRuntimeDecl(name, externRet, externParams, false))
        return LirLowerResult {module: l.out, diagnostics: l.diagnostics}
    }
    if fn_.blocks.len() == 0 {
        lirLowerError(l, LirDiagUnsupported, "MIR function has no blocks", name)
    }
    lirInitMirBlockLabels(l)
    let ret = lirLowerMirType(l, fn_.returnType)
    let mut params: List<LirParam> = []
    for id in fn_.params {
        let loc = mirFunctionLocal(fn_, id)
        if loc.id < 0 {
            lirLowerError(l, LirDiagInvalidInput, "param local out of range: " + lirIntToString(id), name)
            continue
        }
        let typ = lirLowerMirType(l, loc.typ)
        if lirTypeIsZero(typ) || lirTypeIsVoid(typ) {
            lirLowerError(l, LirDiagUnsupported, "unsupported param type `" + loc.typ + "`", name)
            continue
        }
        let attrs = lirParamAttrsFromMir(fn_, typ)
        params.push(lirParamWithAttrs(lirMirParamName(id), typ, attrs))
    }
    lirLowerMirLocals(l)
    let mut entryPrologue: List<LirInstr> = []
    let savedInstrs = l.instrs
    l.instrs = entryPrologue
    lirEmitGcSafepointEntry(l)
    entryPrologue = l.instrs
    l.instrs = savedInstrs
    let mut blocks: List<LirBlock> = []
    for bb in lirOrderedMirBlocks(fn_) {
        l.instrs = []
        l.extraBlocks = []
        l.currentBlockLabel = lirLabelForMirBlock(l, bb.id)
        if bb.id == fn_.entry {
            for s in entryPrologue {
                l.instrs.push(s)
            }
            for p in l.prologue {
                l.instrs.push(p)
            }
        }
        for instr in bb.instrs {
            lirLowerMirInstr(l, instr)
        }
        let term = lirLowerMirTerm(l, bb.term, ret)
        for extra in l.extraBlocks {
            blocks.push(extra)
        }
        blocks.push(LirBlock {label: l.currentBlockLabel, instrs: l.instrs, term})
    }
    if l.diagnostics.len() == 0 {
        lirAttachParallelAccessGroup(l, blocks)
        let mut outFn = lirFunction(name, ret)
        outFn.params = params
        outFn.blocks = blocks
        outFn.attrs = lirFnAttrsFromMir(fn_)
        if fn_.cAbi {
            outFn.callingConv = "ccc"
        }
        l.out.functions.push(outFn)
    }
    LirLowerResult {module: l.out, diagnostics: l.diagnostics}
}
// External / intrinsic MIR functions: emit `declare <ret> @<name>(<params>)`
// and skip body. These are FFI imports (`use go "..."`), declared
// intrinsics, or stdlib stubs whose body lives outside the local
// MIR module. Mirrors production `emitDirectCall` runtime FFI path
// — production declares the symbol on first call site.
// `#[parallel]` attaches `!llvm.access.group !N` to every
// load/store after all blocks are assembled. Post-processing
// here (rather than at each push site) keeps every existing
// intrinsic lowering ignorant of the per-instruction MD
// surface — they only ever push raw load/store instrs.
// Splice in any sub-blocks an instr lowering created (Option/Result
// wrapping, safe-form intrinsics, etc.) before pushing the final
// block. The MIR block's terminator always lives on the last
// sub-block since `currentBlockLabel` advances each time a cut
// happens.
// Function-entry safepoint sits at the very front of the prologue so
// every entered function gets one poll regardless of which MIR block
// is `fn_.entry`. Production runs the same emit order
// (LANG_SPEC §3.8.6 + RUNTIME_GC_DELTA §10.1).
fn lirLowerError(l: LirMirFunctionLowerer, kind: LirDiagnosticKind, message: String, path: String) {
    l.diagnostics.push(lirDiagnosticError(kind, message, path))
}
fn lirRenderedMirFunctionName(fn_: MirFunction) -> String {
    if fn_.exportSymbol != "" {
        return fn_.exportSymbol
    }
    fn_.name
}
fn lirInitMirBlockLabels(l: LirMirFunctionLowerer) {
    let mut seenEntry = false
    for bb in l.fn_.blocks {
        for existing in l.labels {
            if existing.id == bb.id {
                lirLowerError(l, LirDiagInvalidInput, "duplicate MIR block id " + lirIntToString(bb.id), "block")
            }
        }
        let label = if bb.id == l.fn_.entry {
            seenEntry = true
            "entry"
        } else {
            "bb" + lirIntToString(bb.id)
        }
        l.labels.push(LirBlockLabel {id: bb.id, label})
    }
    if !(seenEntry) {
        lirLowerError(l, LirDiagInvalidInput, "entry block " + lirIntToString(l.fn_.entry) + " is not present", "function.entry")
    }
}
fn lirLabelForMirBlock(l: LirMirFunctionLowerer, id: Int) -> String {
    for label in l.labels {
        if label.id == id {
            return label.label
        }
    }
    lirLowerError(l, LirDiagInvalidInput, "target block " + lirIntToString(id) + " is not present", "block.target")
    ""
}
fn lirOrderedMirBlocks(fn_: MirFunction) -> List<MirBasicBlock> {
    let mut out: List<MirBasicBlock> = []
    for bb in fn_.blocks {
        if bb.id == fn_.entry {
            out.push(bb)
            break
        }
    }
    for bb in fn_.blocks {
        if bb.id != fn_.entry {
            out.push(bb)
        }
    }
    out
}
fn lirLowerMirLocals(l: LirMirFunctionLowerer) {
    for loc in l.fn_.locals {
        let typ = lirLowerMirType(l, loc.typ)
        if lirTypeIsZero(typ) {
            lirLowerError(l, LirDiagUnsupported, "unsupported local type `" + loc.typ + "`", "local." + loc.name)
            continue
        }
        if lirTypeIsVoid(typ) {
            continue
        }
        let slot = lirMirLocalSlotName(loc.id)
        l.slots.push(LirLocalSlot {id: loc.id, slot, typ})
        l.prologue.push(lirAlloca(slot, typ, 0))
        if loc.isParam {
            l.prologue.push(lirStore(lirOperand(typ, lirMirParamName(loc.id)), slot, 0))
        }
        if lirTypeNameIsGCManaged(loc.typ) {
            lirRuntimeDeclsDeclare(l.out.runtimeDecls, lirGcRootBindDecl())
            l.prologue.push(lirCall("", lirVoidType(), "@" + lirGcRootBindSymbol(), [lirOperand(lirPtrType(), slot)]))
            l.gcRootSlots.push(slot)
        }
    }
}
// GC root binding: slots holding managed reference values
// (List/Map/Set/Channel/Handle/Box/String/Bytes/TaskGroup/
// Select) get registered with the runtime so the safepoint
// collector can scan them. Production binds at slot
// initialization (generator.go::bindGCRootIfManagedPointer).
// The release pair is emitted before each `ret` terminator.
// `lirTypeNameIsGCManaged` reports whether a local with this MIR
// type name needs the runtime root-binding pair around its slot.
// Mirrors production's `gcManaged` flag: anything reference-shaped
// (List<T>, Map<K,V>, Set<T>, Channel<T>, Handle<T>, Box<T>,
// TaskGroup, Select) plus the runtime-allocated String / Bytes
// surfaces. RawPtr is intentionally excluded — it's the user's
// escape hatch for unmanaged pointers and binding it would attribute
// foreign memory to the GC.
fn lirTypeNameIsGCManaged(name: String) -> Bool {
    if name == "String" || name == "Bytes" {
        return true
    }
    lirIsRefBuiltinTypeName(name)
}
fn lirGcRootBindSymbol() -> String {
    "osty.gc.root_bind_v1"
}
fn lirGcRootReleaseSymbol() -> String {
    "osty.gc.root_release_v1"
}
fn lirGcRootBindDecl() -> LirRuntimeDecl {
    lirRuntimeDecl(lirGcRootBindSymbol(), lirVoidType(), [lirPtrType()], false)
}
fn lirGcRootReleaseDecl() -> LirRuntimeDecl {
    lirRuntimeDecl(lirGcRootReleaseSymbol(), lirVoidType(), [lirPtrType()], false)
}
// Emit `osty.gc.root_release_v1(slot)` for every recorded root slot in
// reverse insertion order. Called immediately before each `ret`
// terminator so the collector frees roots in the inverse of the
// binding order — the same LIFO discipline production uses
// (generator.go::releaseGCRoots).
fn lirEmitGcRootReleases(l: LirMirFunctionLowerer) {
    if l.gcRootSlots.len() == 0 {
        return
    }
    lirRuntimeDeclsDeclare(l.out.runtimeDecls, lirGcRootReleaseDecl())
    let mut i = l.gcRootSlots.len() - 1
    for _ in 0..l.gcRootSlots.len() {
        let slot = l.gcRootSlots[i]
        l.instrs.push(lirCall("", lirVoidType(), "@" + lirGcRootReleaseSymbol(), [lirOperand(lirPtrType(), slot)]))
        i = i - 1
    }
}
fn lirMirLocalSlot(l: LirMirFunctionLowerer, id: Int) -> LirLocalSlot {
    for slot in l.slots {
        if slot.id == id {
            return slot
        }
    }
    LirLocalSlot {id: -1, slot: "", typ: lirTypeInvalid()}
}
fn lirMirLocalSlotName(id: Int) -> String {
    "%l" + lirIntToString(id)
}
fn lirMirParamName(id: Int) -> String {
    "%p" + lirIntToString(id)
}
fn lirFresh(l: LirMirFunctionLowerer) -> String {
    let name = "%t" + lirIntToString(l.temp)
    l.temp = l.temp + 1
    name
}
fn lirLowerMirInstr(l: LirMirFunctionLowerer, instr: MirInstr) {
    if instr.kind == MirInstrAssign {
        return lirLowerMirAssign(l, instr)
    }
    if instr.kind == MirInstrCall {
        return lirLowerMirCall(l, instr)
    }
    if instr.kind == MirInstrIntrinsic {
        return lirLowerMirIntrinsic(l, instr)
    }
    if instr.kind == MirInstrStorageLive {
        return
    }
    if instr.kind == MirInstrStorageDead {
        return
    }
    lirLowerError(l, LirDiagUnsupported, "unsupported MIR instruction kind `" + mirInstrKindName(instr.kind) + "`", "instr." + mirInstrKindName(instr.kind))
}
// B2: payload-less enum dispatch as if-else chain (stage0 P0–P15).
fn lirLowerMirAssign(l: LirMirFunctionLowerer, instr: MirInstr) {
    let destLoc = mirFunctionLocal(l.fn_, instr.dest.local)
    if destLoc.id < 0 {
        lirLowerError(l, LirDiagInvalidInput, "assign destination local out of range", "assign.dest")
        return
    }
    let destType = lirLowerMirType(l, destLoc.typ)
    if lirTypeIsZero(destType) {
        lirLowerError(l, LirDiagUnsupported, "unsupported assign destination type `" + destLoc.typ + "`", "assign.dest")
        return
    }
    if mirPlaceHasProjections(instr.dest) {
        let leafTypeName = lirMirProjectionLeafType(instr.dest.projections)
        let leafType = lirLowerMirType(l, leafTypeName)
        let value = lirLowerMirRValue(l, instr.src, leafTypeName, leafType)
        lirStoreProjectedMirValue(l, instr.dest, destLoc, destType, value, instr.src.typ, "projected assign")
        return
    }
    let mut value = lirLowerMirRValue(l, instr.src, destLoc.typ, destType)
    if lirTypeIsVoid(destType) {
        return
    }
    if value.typ.llvm != destType.llvm {
        value = lirCoerceMirOperandToName(l, value, instr.src.typ, destLoc.typ, destType, "assign")
        if value.value == "" {
            return
        }
    }
    let slot = lirMirLocalSlot(l, destLoc.id)
    if slot.slot == "" {
        lirLowerError(l, LirDiagLoweringBug, "destination local has no LIR slot", "assign.dest")
        return
    }
    l.instrs.push(lirStore(value, slot.slot, 0))
}
fn lirStoreProjectedMirValue(l: LirMirFunctionLowerer, place: MirPlace, root: MirLocal, rootType: LirType, value: LirOperand, valueMirType: String, context: String) {
    if rootType.className != LirTypeAggregate {
        lirLowerError(l, LirDiagUnsupported, context + " requires aggregate root", context)
        return
    }
    let leafTypeName = lirMirProjectionLeafType(place.projections)
    let leafType = lirLowerMirType(l, leafTypeName)
    let mut stored = value
    if stored.typ.llvm != leafType.llvm {
        stored = lirCoerceMirOperandToName(l, stored, valueMirType, leafTypeName, leafType, context)
        if stored.value == "" {
            return
        }
    }
    let slot = lirMirLocalSlot(l, root.id)
    if slot.slot == "" {
        lirLowerError(l, LirDiagLoweringBug, "projected root local has no LIR slot", context)
        return
    }
    let base = lirFresh(l)
    l.instrs.push(lirLoad(base, rootType, slot.slot, 0))
    let mut frames: List<LirProjectionFrame> = []
    let mut current = lirOperand(rootType, base)
    let mut idx = 0
    for proj in place.projections {
        if current.typ.className != LirTypeAggregate {
            lirLowerError(l, LirDiagUnsupported, context + " projection on non-aggregate type", context)
            return
        }
        let step = lirProjectionStepFromMir(l, proj)
        if step.kind == LirProjInvalid {
            lirLowerError(l, LirDiagUnsupported, context + " unsupported projection", context)
            return
        }
        frames.push(lirProjectionFrame(current, step.index))
        if idx < place.projections.len() - 1 {
            let next = lirFresh(l)
            l.instrs.push(lirExtractValue(next, current.typ, current.value, [step.index]))
            current = lirOperand(step.typ, next)
        }
        idx = idx + 1
    }
    let mut rebuilt = stored
    let mut i = frames.len() - 1
    for _j in 0..frames.len() {
        if i < 0 {
            break
        }
        let fr = frames[i]
        let dest = lirFresh(l)
        l.instrs.push(lirInsertValue(dest, fr.aggregate.typ, fr.aggregate.value, rebuilt, [fr.index]))
        rebuilt = lirOperand(fr.aggregate.typ, dest)
        i = i - 1
    }
    l.instrs.push(lirStore(rebuilt, slot.slot, 0))
}
fn lirProjectionStepFromMir(l: LirMirFunctionLowerer, proj: MirProjection) -> LirProjectionStep {
    let typ = lirLowerMirType(l, proj.typ)
    if proj.kind == MirProjField {
        return lirFieldProjection(proj.index, proj.name, typ)
    }
    if proj.kind == MirProjTuple {
        return lirTupleProjection(proj.index, typ)
    }
    if proj.kind == MirProjVariant {
        return lirVariantProjection(proj.index, proj.name, typ)
    }
    if proj.kind == MirProjIndex {
        return lirIndexProjection(proj.indexConst, typ)
    }
    LirProjectionStep {kind: LirProjInvalid, index: 0, name: "", typ: lirTypeInvalid()}
}
// B2: payload-less enum dispatch as if-else chain (stage0 P0–P15).
fn lirMirProjectionLeafType(projections: List<MirProjection>) -> String {
    if projections.len() == 0 {
        return ""
    }
    projections[projections.len() - 1].typ
}
fn lirLowerMirCall(l: LirMirFunctionLowerer, instr: MirInstr) {
    if instr.calleeKind == MirCalleeIndirect {
        lirLowerMirIndirectCall(l, instr)
        return
    }
    if instr.calleeKind != MirCalleeFn {
        lirLowerError(l, LirDiagUnsupported, "unsupported MIR callee kind `" + mirCalleeKindName(instr.calleeKind) + "`", "call." + mirCalleeKindName(instr.calleeKind))
        return
    }
    if instr.calleeSymbol == "" {
        lirLowerError(l, LirDiagInvalidInput, "direct call has empty symbol", "call")
        return
    }
    let callee = lirLookupMirFunction(l.mirModule, instr.calleeSymbol)
    if callee.name == "" {
        // Interface method-call indirect dispatch (E4).
        // When the callee symbol matches `<iface>__<method>` and the
        // first argument's type is that interface, emit extractvalue /
        // GEP / load / indirect-call instead of a cross-module direct
        // call. This lets the Go MIR lowerer (which emits the same
        // CallInstr for both concrete and interface receivers) avoid
        // adding a new MIR callee kind.
        if lirTryLowerMirInterfaceCall(l, instr) {
            return
        }
        lirLowerMirCrossModuleCall(l, instr)
        return
    }
    let retType = lirLowerMirType(l, callee.returnType)
    let args = lirLowerMirCallArgs(l, instr.args, callee)
    if lirLowerHasErrorDiagnostics(l.diagnostics) {
        return
    }
    if lirTypeIsVoid(retType) {
        l.instrs.push(lirCall("", retType, "@" + lirRenderedMirFunctionName(callee), args))
        lirCheckVoidMirDestination(l, instr.hasDest, instr.dest, "void call `" + instr.calleeSymbol + "`")
        return
    }
    let destName = if instr.hasDest {
        lirFresh(l)
    } else {
        ""
    }
    l.instrs.push(lirCall(destName, retType, "@" + lirRenderedMirFunctionName(callee), args))
    if instr.hasDest {
        lirStoreMirResult(l, instr.dest, lirOperand(retType, destName), callee.returnType, "call result")
    }
}
// Cross-module direct call: callee body is in another module
// (FFI extern, stdlib helper, separately-compiled package).
// Infer signature from operand types + dest local type, then
// emit a `declare` line and the call. Production does the same
// via `runtimeDecls`-style declares for any callee not in the
// local module.
// `lirLowerMirCrossModuleCall` handles direct calls whose target is
// not in the local MIR module. Signature comes from the call site:
// return type from `instr.dest` local (or void if no dest), param
// types from each arg's declared type. Declares the symbol via
// runtimeDecls so the renderer emits a top-level `declare` line.
fn lirLowerMirCrossModuleCall(l: LirMirFunctionLowerer, instr: MirInstr) {
    let retType = if instr.hasDest {
        let loc = mirFunctionLocal(l.fn_, instr.dest.local)
        if loc.id < 0 {
            lirLowerError(l, LirDiagInvalidInput, "cross-module call destination local out of range", "call.cross")
            return
        }
        lirLowerMirType(l, loc.typ)
    } else {
        lirVoidType()
    }
    let mut paramTypes: List<LirType> = []
    let mut args: List<LirOperand> = []
    for arg in instr.args {
        let paramType = lirLowerMirType(l, arg.typ)
        if lirTypeIsZero(paramType) {
            lirLowerError(l, LirDiagUnsupported, "cross-module call arg type `" + arg.typ + "` is not implemented", "call.cross")
            return
        }
        let value = lirLowerMirOperand(l, arg, arg.typ, paramType)
        if value.value == "" {
            return
        }
        paramTypes.push(paramType)
        args.push(lirOperand(paramType, value.value))
    }
    lirRuntimeDeclsDeclare(l.out.runtimeDecls, lirRuntimeDecl(instr.calleeSymbol, retType, paramTypes, false))
    if lirTypeIsVoid(retType) {
        l.instrs.push(lirCall("", retType, "@" + instr.calleeSymbol, args))
        lirCheckVoidMirDestination(l, instr.hasDest, instr.dest, "void call `" + instr.calleeSymbol + "`")
        return
    }
    let destName = if instr.hasDest {
        lirFresh(l)
    } else {
        ""
    }
    l.instrs.push(lirCall(destName, retType, "@" + instr.calleeSymbol, args))
    if instr.hasDest {
        let loc = mirFunctionLocal(l.fn_, instr.dest.local)
        lirStoreMirResult(l, instr.dest, lirOperand(retType, destName), loc.typ, "cross-module call result")
    }
}
/// `lirTryLowerMirInterfaceCall` detects a CallInstr whose callee
/// symbol has shape `<iface>__<method>` and whose first argument is
/// the interface type, then emits the canonical vtable indirect-
/// dispatch sequence:
///
///   %vt   = extractvalue %osty.iface %recv, 1
///   %slot = getelementptr inbounds ptr, ptr %vt, i64 <methodSlot>
///   %fn   = load ptr, ptr %slot
///   %data = extractvalue %osty.iface %recv, 0
///   %res  = call <ret> %fn(ptr %data, ...)
///
/// Returns true when the call was recognised and lowered.
fn lirTryLowerMirInterfaceCall(l: LirMirFunctionLowerer, instr: MirInstr) -> Bool {
    if instr.args.len() == 0 {
        return false
    }
    let recvType = instr.args[0].typ
    for layout in l.mirModule.layouts.interfaces {
        let prefix = layout.name + "__"
        if !(strings.hasPrefix(instr.calleeSymbol, prefix)) {
            continue
        }
        let methodName = strings.slice(instr.calleeSymbol, prefix.len(), instr.calleeSymbol.len())
        let slot = lirFindInterfaceMethodSlot(layout, methodName)
        if slot < 0 {
            continue
        }
        // Verify receiver type matches interface (allow bare name or %prefixed).
        if recvType != layout.name && recvType != ("%" + layout.name) {
            continue
        }
        // Lower the interface fat-pointer operand.
        let ifaceType = lirAggregateType(lirIfaceTypeName())
        let recvValue = lirLowerMirOperand(l, instr.args[0], recvType, ifaceType)
        if recvValue.value == "" {
            return true
        }
        // Extract vtable (index 1) and method slot.
        let vtReg = lirFresh(l)
        l.instrs.push(lirExtractValue(vtReg, ifaceType, recvValue.value, [1]))
        let slotReg = lirFresh(l)
        l.instrs.push(lirGep(slotReg, lirPtrType(), vtReg, [lirOperand(lirIntType(64), lirIntToString(slot))], true))
        let fnReg = lirFresh(l)
        l.instrs.push(lirLoad(fnReg, lirPtrType(), slotReg, 0))
        // Extract data pointer (index 0) — becomes the shim's self arg.
        let dataReg = lirFresh(l)
        l.instrs.push(lirExtractValue(dataReg, ifaceType, recvValue.value, [0]))
        // Build argument list: data ptr + remaining args.
        let mut args: List<LirOperand> = []
        args.push(lirOperand(lirPtrType(), dataReg))
        let mut i = 1
        for i < instr.args.len() {
            let arg = instr.args[i]
            let argType = lirLowerMirType(l, arg.typ)
            if lirTypeIsZero(argType) {
                lirLowerError(l, LirDiagUnsupported, "interface call arg type `" + arg.typ + "` is not implemented", "call.interface")
                return true
            }
            let value = lirLowerMirOperand(l, arg, arg.typ, argType)
            if value.value == "" {
                return true
            }
            args.push(lirOperand(argType, value.value))
            i = i + 1
        }
        // Return type from destination local, same as cross-module call.
        let retType = if instr.hasDest {
            let loc = mirFunctionLocal(l.fn_, instr.dest.local)
            if loc.id < 0 {
                lirLowerError(l, LirDiagInvalidInput, "interface call destination local out of range", "call.interface")
                return true
            }
            lirLowerMirType(l, loc.typ)
        } else {
            lirVoidType()
        }
        if lirTypeIsVoid(retType) {
            l.instrs.push(lirCall("", retType, fnReg, args))
            lirCheckVoidMirDestination(l, instr.hasDest, instr.dest, "void interface call `" + instr.calleeSymbol + "`")
            return true
        }
        let destName = if instr.hasDest {
            lirFresh(l)
        } else {
            ""
        }
        l.instrs.push(lirCall(destName, retType, fnReg, args))
        if instr.hasDest {
            let loc = mirFunctionLocal(l.fn_, instr.dest.local)
            lirStoreMirResult(l, instr.dest, lirOperand(retType, destName), loc.typ, "interface call result")
        }
        return true
    }
    false
}
/// `lirFindInterfaceMethodSlot` returns the vtable slot index for
/// `methodName` inside `layout`, or -1 when not found.
fn lirFindInterfaceMethodSlot(layout: MirInterfaceLayout, methodName: String) -> Int {
    for method in layout.methods {
        if method.name == methodName {
            return method.slot
        }
    }
    -1
}
// `lirLowerMirIndirectCall` handles a call through a function-value
// operand. The MIR shape: `instr.calleeOperand` evaluates to a
// closure env ptr (slot 0 = lifted fn ptr, slots 1..N = captures).
// We load env[0] to get the fn ptr, then call it with env as the
// implicit first arg. Mirrors production `emitIndirectCall`
// (mir_generator.go:3995).
fn lirLowerMirIndirectCall(l: LirMirFunctionLowerer, instr: MirInstr) {
    let envValue = lirLowerMirOperand(l, instr.calleeOperand, instr.calleeOperand.typ, lirPtrType())
    if envValue.value == "" {
        return
    }
    let fnPtrReg = lirFresh(l)
    l.instrs.push(lirLoad(fnPtrReg, lirPtrType(), envValue.value, 0))
    let retType = if instr.hasDest {
        let loc = mirFunctionLocal(l.fn_, instr.dest.local)
        if loc.id < 0 {
            lirLowerError(l, LirDiagInvalidInput, "indirect call destination local out of range", "call.indirect")
            return
        }
        lirLowerMirType(l, loc.typ)
    } else {
        lirVoidType()
    }
    let mut args: List<LirOperand> = []
    args.push(lirOperand(lirPtrType(), envValue.value))
    for arg in instr.args {
        let paramType = lirLowerMirType(l, arg.typ)
        if lirTypeIsZero(paramType) {
            lirLowerError(l, LirDiagUnsupported, "indirect call arg type `" + arg.typ + "` is not implemented", "call.indirect")
            return
        }
        let value = lirLowerMirOperand(l, arg, arg.typ, paramType)
        if value.value == "" {
            return
        }
        args.push(lirOperand(paramType, value.value))
    }
    if lirTypeIsVoid(retType) {
        l.instrs.push(lirCall("", retType, fnPtrReg, args))
        lirCheckVoidMirDestination(l, instr.hasDest, instr.dest, "void indirect call")
        return
    }
    let destName = if instr.hasDest {
        lirFresh(l)
    } else {
        ""
    }
    l.instrs.push(lirCall(destName, retType, fnPtrReg, args))
    if instr.hasDest {
        let loc = mirFunctionLocal(l.fn_, instr.dest.local)
        lirStoreMirResult(l, instr.dest, lirOperand(retType, destName), loc.typ, "indirect call result")
    }
}
fn lirLowerMirCallArgs(l: LirMirFunctionLowerer, args: List<MirOperand>, callee: MirFunction) -> List<LirOperand> {
    let mut out: List<LirOperand> = []
    if args.len() != callee.params.len() {
        lirLowerError(l, LirDiagInvalidInput, "direct call argument count mismatch", "call.args")
        return out
    }
    let mut i = 0
    for arg in args {
        let paramLocal = mirFunctionLocal(callee, callee.params[i])
        let paramType = lirLowerMirType(l, paramLocal.typ)
        let mut value = lirLowerMirOperand(l, arg, paramLocal.typ, paramType)
        if value.typ.llvm != paramType.llvm {
            value = lirCoerceMirOperandToName(l, value, arg.typ, paramLocal.typ, paramType, "direct call arg")
            if value.value == "" {
                return out
            }
        }
        out.push(lirOperand(paramType, value.value))
        i = i + 1
    }
    out
}
fn lirStoreMirResult(l: LirMirFunctionLowerer, dest: MirPlace, result: LirOperand, resultTypeName: String, context: String) {
    let loc = mirFunctionLocal(l.fn_, dest.local)
    if loc.id < 0 {
        lirLowerError(l, LirDiagInvalidInput, context + " destination local out of range", context)
        return
    }
    let destType = lirLowerMirType(l, loc.typ)
    if lirTypeIsVoid(destType) {
        return
    }
    if mirPlaceHasProjections(dest) {
        lirStoreProjectedMirValue(l, dest, loc, destType, result, resultTypeName, context)
        return
    }
    let mut stored = result
    if stored.typ.llvm != destType.llvm {
        stored = lirCoerceMirOperandToName(l, stored, resultTypeName, loc.typ, destType, context)
        if stored.value == "" {
            return
        }
    }
    let slot = lirMirLocalSlot(l, loc.id)
    if slot.slot == "" {
        lirLowerError(l, LirDiagLoweringBug, context + " destination has no LIR slot", context)
        return
    }
    l.instrs.push(lirStore(stored, slot.slot, 0))
}
fn lirLowerMirIntrinsic(l: LirMirFunctionLowerer, instr: MirInstr) {
