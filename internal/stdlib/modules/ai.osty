    opts
}

pub fn withResponseFormat(mut opts: ChatOptions, format: String) -> ChatOptions {
    opts.responseFormat = format
    opts
}

pub fn withUser(mut opts: ChatOptions, user: String) -> ChatOptions {
    opts.user = user
    opts
