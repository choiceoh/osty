// std.os - process, environment, and signals.
//
// Lexical path manipulation lives in std.path. The process-control
// entries here are body-less; the backend lowers each call to the
// host-OS runtime.

pub struct Output {
    pub exitCode: Int,
    pub stdout: String,
    pub stderr: String,
}

pub struct ExecOutput {
    pub exitCode: Int,
    pub stdout: String,
    pub stderr: String,
    pub timedOut: Bool,
}

pub enum Signal {
    Interrupt,
    Terminate,
    Hangup,
}

pub fn exec(cmd: String, args: List<String> = []) -> Result<Output, Error>

pub fn execShell(cmd: String) -> Result<Output, Error>

pub fn execWith(cmd: String, args: List<String>, cwd: String, env: Map<String, String>, timeoutMillis: Int) -> Result<ExecOutput, Error>

pub fn execShellWith(cmd: String, cwd: String, env: Map<String, String>, timeoutMillis: Int) -> Result<ExecOutput, Error>

pub fn exit(code: Int) -> Never

pub fn pid() -> Int

pub fn hostname() -> Result<String, Error>

pub fn onSignal(signal: Signal, handler: fn(Signal) -> ())
