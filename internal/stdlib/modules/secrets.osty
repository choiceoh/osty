// std.secrets - small convenience facade over std.keychain.
//
// Use this module when a program just needs to persist API keys or tokens and
// does not care which OS credential store backs the value.

pub fn backend() -> String

pub fn isAvailable() -> Bool

pub fn get(name: String) -> Result<String, Error>

pub fn set(name: String, secret: String) -> Result<(), Error>

pub fn delete(name: String) -> Result<(), Error>

pub fn getApiKey(provider: String) -> Result<String, Error>

pub fn setApiKey(provider: String, secret: String) -> Result<(), Error>

pub fn deleteApiKey(provider: String) -> Result<(), Error>
