}

pub fn headers(client: Client) -> Headers {
    let mut out: Headers = {:}
    out.insert("Accept", "application/vnd.github+json")
    if !strings.trimSpace(client.apiVersion).isEmpty() {
        out.insert("X-GitHub-Api-Version", strings.trimSpace(client.apiVersion))
    }
    if !strings.trimSpace(client.userAgent).isEmpty() {
        out.insert("User-Agent", strings.trimSpace(client.userAgent))
    }
    if !strings.trimSpace(client.token).isEmpty() {
        out.insert("Authorization", "Bearer {strings.trimSpace(client.token)}")
    }
    for (name, value) in client.extraHeaders {
        out.insert(name, value)
    }
    out
}

pub fn apiUrl(client: Client, path: String) -> Result<String, Error> {
    validateClient(client)?
    Ok(joinUrl(client.baseUrl, cleanApiPath(path)?))
}

pub fn uploadUrl(client: Client, path: String) -> Result<String, Error> {
    validateClient(client)?
    Ok(joinUrl(client.uploadBaseUrl, cleanApiPath(path)?))
}

pub fn repoUrl(client: Client, repository: Repository) -> Result<String, Error> {
    apiUrl(client, repository.apiPath())
}

pub fn issuesUrl(client: Client, repository: Repository) -> Result<String, Error> {
    apiUrl(client, "{repository.apiPath()}/issues")
}

pub fn issueUrl(client: Client, repository: Repository, number: Int) -> Result<String, Error> {
    let base = issuesUrl(client, repository)?
    let n = positiveNumber("issue", number)?
    Ok("{base}/{n}")
}

pub fn issueCommentsUrl(client: Client, repository: Repository, number: Int) -> Result<String, Error> {
    Ok("{issueUrl(client, repository, number)?}/comments")
}

pub fn pullsUrl(client: Client, repository: Repository) -> Result<String, Error> {
    apiUrl(client, "{repository.apiPath()}/pulls")
}

pub fn pullUrl(client: Client, repository: Repository, number: Int) -> Result<String, Error> {
    let base = pullsUrl(client, repository)?
    let n = positiveNumber("pull request", number)?
    Ok("{base}/{n}")
}

pub fn pullFilesUrl(client: Client, repository: Repository, number: Int) -> Result<String, Error> {
    Ok("{pullUrl(client, repository, number)?}/files")
}

pub fn pullReviewsUrl(client: Client, repository: Repository, number: Int) -> Result<String, Error> {
    Ok("{pullUrl(client, repository, number)?}/reviews")
}

pub fn actionsRunsUrl(client: Client, repository: Repository) -> Result<String, Error> {
    apiUrl(client, "{repository.apiPath()}/actions/runs")
}

pub fn workflowRunsUrl(client: Client, repository: Repository, workflowId: String) -> Result<String, Error> {
    let workflow = encodePathSegment(cleanPathSegment("workflow", workflowId)?)
    apiUrl(client, "{repository.apiPath()}/actions/workflows/{workflow}/runs")
}

pub fn releasesUrl(client: Client, repository: Repository) -> Result<String, Error> {
    apiUrl(client, "{repository.apiPath()}/releases")
}

pub fn releaseUrl(client: Client, repository: Repository, releaseId: Int) -> Result<String, Error> {
    let base = releasesUrl(client, repository)?
    let id = positiveNumber("release", releaseId)?
    Ok("{base}/{id}")
}

