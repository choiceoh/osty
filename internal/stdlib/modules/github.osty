pub fn workflowDispatchHttpRequest(client: Client, repository: Repository, workflowId: String, dispatch: WorkflowDispatch) -> Result<http.Request, Error> {
    let cleanRef = strings.trimSpace(dispatch.ref)
    if cleanRef.isEmpty() {
        return Err(error.new("github: workflow dispatch ref is empty"))
    }
    let workflow = encodePathSegment(cleanPathSegment("workflow", workflowId)?)
    githubJsonRequest(
        client,
        http.Post,
        "{repository.apiPath()}/actions/workflows/{workflow}/dispatches",
        object([
            prop("ref", quote(cleanRef)),
            prop("inputs", normalizedJsonObject(dispatch.inputsJson)),
        ]),
    )
}

