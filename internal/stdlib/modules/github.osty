// std.github - GitHub REST request builders and webhook helpers.
//
// The module stays transport-light: it builds ready-to-send std.http requests
// for issues, pull requests, Actions, releases, and webhook verification. Hosts
// still own token storage, network execution, and webhook routing.

use std.bytes
use std.crypto
use std.encoding
use std.error
use std.http
use std.json
use std.strings

pub type Headers = http.Headers
pub type QueryValues = http.QueryValues

pub enum IssueState {
    IssueOpen,
    IssueClosed,
    IssueAll,

    pub fn toString(self) -> String {
        match self {
            IssueOpen   -> "open",
            IssueClosed -> "closed",
            IssueAll    -> "all",
        }
    }
}

pub enum PullState {
    PullOpen,
    PullClosed,
    PullAll,

    pub fn toString(self) -> String {
        match self {
            PullOpen   -> "open",
            PullClosed -> "closed",
            PullAll    -> "all",
        }
    }
}

pub enum ReviewEvent {
    ReviewComment,
    ReviewApprove,
    ReviewRequestChanges,

    pub fn toString(self) -> String {
        match self {
            ReviewComment        -> "COMMENT",
            ReviewApprove        -> "APPROVE",
            ReviewRequestChanges -> "REQUEST_CHANGES",
        }
    }
}

pub enum MergeMethod {
    MergeCommit,
    MergeSquash,
    MergeRebase,

    pub fn toString(self) -> String {
        match self {
            MergeCommit -> "merge",
            MergeSquash -> "squash",
            MergeRebase -> "rebase",
        }
    }
}

pub struct Client {
    pub baseUrl: String = "https://api.github.com",
    pub uploadBaseUrl: String = "https://uploads.github.com",
    pub token: String = "",
    pub apiVersion: String = "2022-11-28",
    pub userAgent: String = "osty-stdlib-github",
    pub extraHeaders: Headers = {:},

    pub fn withToken(mut self, token: String) -> Client {
        self.token = strings.trimSpace(token)
        self
    }

    pub fn withApiVersion(mut self, version: String) -> Client {
        self.apiVersion = strings.trimSpace(version)
        self
    }

    pub fn withUserAgent(mut self, value: String) -> Client {
        self.userAgent = strings.trimSpace(value)
        self
    }

    pub fn withHeader(mut self, name: String, value: String) -> Client {
        self.extraHeaders.insert(name, value)
        self
    }
}

pub struct Repository {
    pub owner: String,
    pub name: String,

    pub fn fullName(self) -> String {
        "{self.owner}/{self.name}"
    }

    pub fn apiPath(self) -> String {
        "/repos/{encodePathSegment(self.owner)}/{encodePathSegment(self.name)}"
    }
}

pub struct Pagination {
    pub perPage: Int = 30,
    pub page: Int = 1,
}

pub struct IssueQuery {
    pub state: IssueState,
    pub labels: List<String> = [],
    pub assignee: String = "",
    pub creator: String = "",
    pub mentioned: String = "",
    pub milestone: String = "",
    pub since: String = "",
    pub sort: String = "",
    pub direction: String = "",
    pub pagination: Pagination,
}

pub struct IssueDraft {
    pub title: String,
    pub body: String = "",
    pub labels: List<String> = [],
    pub assignees: List<String> = [],
    pub milestone: Int? = None,
}

pub struct IssuePatch {
    pub title: String? = None,
    pub body: String? = None,
    pub state: IssueState? = None,
    pub labels: List<String> = [],
    pub assignees: List<String> = [],
    pub milestone: Int? = None,
}

pub struct PullRequestQuery {
    pub state: PullState,
    pub head: String = "",
    pub base: String = "",
    pub sort: String = "",
    pub direction: String = "",
    pub pagination: Pagination,
}

pub struct PullRequestDraft {
    pub title: String,
    pub head: String,
    pub base: String,
    pub body: String = "",
    pub draft: Bool = false,
    pub maintainerCanModify: Bool = true,
}

pub struct PullRequestPatch {
    pub title: String? = None,
    pub body: String? = None,
    pub state: PullState? = None,
    pub base: String? = None,
    pub maintainerCanModify: Bool? = None,
}

pub struct ReviewDraft {
    pub event: ReviewEvent,
    pub body: String = "",
    pub commitId: String = "",
}

pub struct MergeOptions {
    pub commitTitle: String = "",
    pub commitMessage: String = "",
    pub sha: String = "",
    pub method: MergeMethod,
}

pub struct WorkflowRunQuery {
    pub branch: String = "",
    pub event: String = "",
    pub status: String = "",
    pub actor: String = "",
    pub created: String = "",
    pub headSha: String = "",
    pub pagination: Pagination,
}

pub struct WorkflowDispatch {
    pub ref: String,
    pub inputsJson: String = "",
}

pub struct ReleaseDraft {
    pub tagName: String,
    pub targetCommitish: String = "",
    pub name: String = "",
    pub body: String = "",
    pub draft: Bool = false,
    pub prerelease: Bool = false,
    pub generateReleaseNotes: Bool = false,
    pub makeLatest: String = "",
}

pub struct ReleaseNotesOptions {
    pub tagName: String,
    pub targetCommitish: String = "",
    pub previousTagName: String = "",
}

pub struct WebhookDelivery {
    pub event: String,
    pub deliveryId: String,
    pub hookId: String,
    pub signature256: String,
    pub body: Bytes,
}

pub struct WebhookDecision {
    pub valid: Bool,
    pub event: String,
    pub deliveryId: String,
    pub reason: String,
}

pub struct ApiError {
    pub status: Int,
    pub message: String = "",
    pub documentationUrl: String = "",
    pub rawJson: String = "",

    pub fn summary(self) -> String {
        let msg = if strings.trimSpace(self.message).isEmpty() { "request failed" } else { strings.trimSpace(self.message) }
        let doc = if strings.trimSpace(self.documentationUrl).isEmpty() { "" } else { ": {strings.trimSpace(self.documentationUrl)}" }
        "github: HTTP {self.status}: {msg}{doc}"
    }
}

pub fn anonymous() -> Client {
    Client {}
}

pub fn client(token: String) -> Client {
    Client {
        token: strings.trimSpace(token),
    }
}

pub fn enterprise(baseUrl: String, uploadBaseUrl: String, token: String) -> Result<Client, Error> {
    let api = stripTrailingSlash(strings.trimSpace(baseUrl))
    let upload = stripTrailingSlash(strings.trimSpace(uploadBaseUrl))
    if api.isEmpty() {
        return Err(error.new("github: base URL is empty"))
    }
    if upload.isEmpty() {
        return Err(error.new("github: upload base URL is empty"))
    }
    Ok(Client {
        baseUrl: api,
        uploadBaseUrl: upload,
        token: strings.trimSpace(token),
    })
}

pub fn repo(owner: String, name: String) -> Result<Repository, Error> {
    Ok(Repository {
        owner: cleanPathSegment("owner", owner)?,
        name: cleanPathSegment("repo", name)?,
    })
}

pub fn parseRepo(fullName: String) -> Result<Repository, Error> {
    let parts = strings.split(strings.trimSpace(fullName), "/")
    if parts.len() != 2 {
        return Err(error.new("github: repository must be owner/name: {fullName}"))
    }
    repo(parts[0], parts[1])
}

pub fn pagination() -> Pagination {
    Pagination { perPage: 30, page: 1 }
}

pub fn page(perPage: Int, pageNumber: Int) -> Pagination {
    Pagination { perPage: perPage, page: pageNumber }
}

