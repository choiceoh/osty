pub fn uploadReleaseAssetHttpRequest(client: Client, repository: Repository, releaseId: Int, name: String, body: Bytes, contentType: String = "application/octet-stream") -> Result<http.Request, Error> {
    let cleanName = cleanAssetName(name)?
    let id = positiveNumber("release", releaseId)?
    let path = "{repository.apiPath()}/releases/{id}/assets"
    let encodedName = encoding.url.encode(cleanName)
    let url = "{uploadUrl(client, path)?}?name={encodedName}"
    Ok(http.newRequest(http.Post, url)
        .withHeaders(headers(client))
        .withContentType(if strings.trimSpace(contentType).isEmpty() { "application/octet-stream" } else { strings.trimSpace(contentType) })
        .withBody(body))
}

pub fn execute(req: http.Request) -> Result<http.Response, Error> {
    requireSuccess(http.request(req)?)
}

pub fn executeJson<T>(req: http.Request) -> Result<T, Error> {
    execute(req)?.json::<T>()
}

pub fn parseApiError(response: http.Response) -> ApiError {
    let text = response.text() ?? ""
    let mut out = ApiError {
        status: response.status,
        rawJson: text,
    }
    match json.parseValue(text) {
        Ok(value) -> match json.asObject(value) {
            Ok(obj) -> {
                out.message = stringField(obj, "message")
                out.documentationUrl = stringField(obj, "documentation_url")
            },
            Err(_) -> {},
        },
        Err(_) -> {
            out.message = strings.trimSpace(text)
        },
    }
    out
}

pub fn requireSuccess(response: http.Response) -> Result<http.Response, Error> {
    if response.isSuccess() {
        return Ok(response)
    }
    Err(error.new(parseApiError(response).summary()))
}

pub fn webhookSignature(secret: String, body: Bytes) -> String {
    let digest = crypto.hmac.sha256(bytes.fromString(secret), body)
    "sha256={encoding.hex.encode(digest)}"
}

pub fn verifyWebhookSignature(secret: String, body: Bytes, signatureHeader: String) -> Bool {
    let clean = strings.trimSpace(signatureHeader)
    if strings.trimSpace(secret).isEmpty() || clean.isEmpty() || !strings.startsWith(clean, "sha256=") {
        return false
    }
    crypto.constantTimeEq(bytes.fromString(webhookSignature(secret, body)), bytes.fromString(clean))
}

pub fn webhookDelivery(request: http.Request) -> WebhookDelivery {
    WebhookDelivery {
        event: request.headerOr("X-GitHub-Event", ""),
        deliveryId: request.headerOr("X-GitHub-Delivery", ""),
        hookId: request.headerOr("X-GitHub-Hook-ID", ""),
        signature256: request.headerOr("X-Hub-Signature-256", ""),
        body: request.body,
    }
}

pub fn verifyWebhookRequest(request: http.Request, secret: String) -> WebhookDecision {
    let delivery = webhookDelivery(request)
    if delivery.deliveryId.isEmpty() {
        return WebhookDecision { valid: false, event: delivery.event, deliveryId: delivery.deliveryId, reason: "missing X-GitHub-Delivery" }
    }
    if delivery.signature256.isEmpty() {
        return WebhookDecision { valid: false, event: delivery.event, deliveryId: delivery.deliveryId, reason: "missing X-Hub-Signature-256" }
    }
    if verifyWebhookSignature(secret, delivery.body, delivery.signature256) {
        WebhookDecision { valid: true, event: delivery.event, deliveryId: delivery.deliveryId, reason: "ok" }
    } else {
        WebhookDecision { valid: false, event: delivery.event, deliveryId: delivery.deliveryId, reason: "signature mismatch" }
    }
}

pub fn parseWebhookPayload(request: http.Request) -> Result<json.Json, Error> {
    json.parseValue(request.text()?)
}

pub fn webhookAction(body: Bytes) -> String? {
    match bytes.toString(body) {
        Ok(text) -> match json.parseValue(text) {
            Ok(value) -> match json.asObject(value) {
                Ok(obj) -> {
                    let action = stringField(obj, "action")
                    if action.isEmpty() { None } else { Some(action) }
                },
                Err(_) -> None,
            },
            Err(_) -> None,
        },
        Err(_) -> None,
    }
}

pub fn isWebhookEvent(request: http.Request, eventName: String) -> Bool {
    request.headerOr("X-GitHub-Event", "") == strings.trimSpace(eventName)
}

pub fn webhookAck(message: String = "ok") -> http.Response {
    http.okText(message)
}

fn githubRequest(client: Client, method: http.Method, path: String) -> Result<http.Request, Error> {
    Ok(http.newRequest(method, apiUrl(client, path)?)
        .withHeaders(headers(client)))
}

fn githubJsonRequest(client: Client, method: http.Method, path: String, body: String) -> Result<http.Request, Error> {
    Ok(http.newRequest(method, apiUrl(client, path)?)
        .withHeaders(headers(client))
        .withText(body)
        .withContentType("application/json"))
}

fn withQuery(request: http.Request, values: QueryValues) -> http.Request {
    if values.keys().isEmpty() {
        return request
    }
    request.withQuery(values)
}

fn issueQueryValues(query: IssueQuery) -> Result<QueryValues, Error> {
    let mut out = paginationQueryValues(query.pagination)?
    out.insert("state", [query.state.toString()])
    addStringParam(out, "assignee", query.assignee)
    addStringParam(out, "creator", query.creator)
    addStringParam(out, "mentioned", query.mentioned)
    addStringParam(out, "milestone", query.milestone)
    addStringParam(out, "since", query.since)
    addStringParam(out, "sort", query.sort)
    addStringParam(out, "direction", query.direction)
    if !query.labels.isEmpty() {
        out.insert("labels", [strings.join(query.labels, ",")])
    }
    Ok(out)
}

fn pullRequestQueryValues(query: PullRequestQuery) -> Result<QueryValues, Error> {
    let mut out = paginationQueryValues(query.pagination)?
    out.insert("state", [query.state.toString()])
    addStringParam(out, "head", query.head)
    addStringParam(out, "base", query.base)
    addStringParam(out, "sort", query.sort)
    addStringParam(out, "direction", query.direction)
    Ok(out)
}

fn workflowRunQueryValues(query: WorkflowRunQuery) -> Result<QueryValues, Error> {
    let mut out = paginationQueryValues(query.pagination)?
    addStringParam(out, "branch", query.branch)
    addStringParam(out, "event", query.event)
    addStringParam(out, "status", query.status)
    addStringParam(out, "actor", query.actor)
    addStringParam(out, "created", query.created)
    addStringParam(out, "head_sha", query.headSha)
    Ok(out)
}

fn paginationQueryValues(pagination: Pagination) -> Result<QueryValues, Error> {
    let mut out: QueryValues = {:}
    if pagination.perPage < 0 || pagination.perPage > 100 {
        return Err(error.new("github: per_page must be between 0 and 100"))
    }
    if pagination.page < 0 {
        return Err(error.new("github: page must not be negative"))
    }
    if pagination.perPage > 0 {
        out.insert("per_page", [pagination.perPage.toString()])
    }
    if pagination.page > 0 {
        out.insert("page", [pagination.page.toString()])
    }
    Ok(out)
}

fn addStringParam(values: QueryValues, key: String, value: String) {
    let clean = strings.trimSpace(value)
    if !clean.isEmpty() {
        values.insert(key, [clean])
    }
}

fn renderIssueDraft(draft: IssueDraft) -> Result<String, Error> {
    let title = requiredText("issue title", draft.title)?
    let mut props = [prop("title", quote(title))]
    addOptionalStringProp(props, "body", draft.body)
    addStringArrayProp(props, "labels", draft.labels)
    addStringArrayProp(props, "assignees", draft.assignees)
    match draft.milestone {
        Some(value) -> props.push(prop("milestone", value.toString())),
        None        -> {},
    }
    Ok(object(props))
}

fn renderIssuePatch(patch: IssuePatch) -> Result<String, Error> {
    let mut props: List<String> = []
    match patch.title {
        Some(value) -> props.push(prop("title", quote(requiredText("issue title", value)?))),
        None        -> {},
    }
    match patch.body {
        Some(value) -> props.push(prop("body", quote(value))),
        None        -> {},
    }
    match patch.state {
        Some(state) -> {
            if state == IssueAll {
                return Err(error.new("github: IssueAll cannot be used as an update state"))
            }
            props.push(prop("state", quote(state.toString())))
        },
        None -> {},
    }
    addStringArrayProp(props, "labels", patch.labels)
    addStringArrayProp(props, "assignees", patch.assignees)
    match patch.milestone {
        Some(value) -> props.push(prop("milestone", value.toString())),
        None        -> {},
    }
    if props.isEmpty() {
        return Err(error.new("github: issue patch is empty"))
    }
    Ok(object(props))
}

fn renderPullRequestDraft(draft: PullRequestDraft) -> Result<String, Error> {
    let mut props = [
        prop("title", quote(requiredText("pull request title", draft.title)?)),
        prop("head", quote(requiredText("pull request head", draft.head)?)),
        prop("base", quote(requiredText("pull request base", draft.base)?)),
        prop("draft", boolValue(draft.draft)),
        prop("maintainer_can_modify", boolValue(draft.maintainerCanModify)),
    ]
    addOptionalStringProp(props, "body", draft.body)
    Ok(object(props))
}

fn renderPullRequestPatch(patch: PullRequestPatch) -> Result<String, Error> {
    let mut props: List<String> = []
    match patch.title {
        Some(value) -> props.push(prop("title", quote(requiredText("pull request title", value)?))),
        None        -> {},
    }
    match patch.body {
        Some(value) -> props.push(prop("body", quote(value))),
        None        -> {},
    }
    match patch.state {
        Some(state) -> {
            if state == PullAll {
                return Err(error.new("github: PullAll cannot be used as an update state"))
            }
            props.push(prop("state", quote(state.toString())))
        },
        None -> {},
    }
    match patch.base {
        Some(value) -> props.push(prop("base", quote(requiredText("pull request base", value)?))),
        None        -> {},
    }
    match patch.maintainerCanModify {
        Some(value) -> props.push(prop("maintainer_can_modify", boolValue(value))),
        None        -> {},
    }
    if props.isEmpty() {
        return Err(error.new("github: pull request patch is empty"))
    }
    Ok(object(props))
}

fn renderReviewDraft(review: ReviewDraft) -> String {
    let mut props = [prop("event", quote(review.event.toString()))]
    addOptionalStringProp(props, "body", review.body)
    addOptionalStringProp(props, "commit_id", review.commitId)
    object(props)
}

fn renderMergeOptions(options: MergeOptions) -> String {
    let mut props = [prop("merge_method", quote(options.method.toString()))]
    addOptionalStringProp(props, "commit_title", options.commitTitle)
    addOptionalStringProp(props, "commit_message", options.commitMessage)
    addOptionalStringProp(props, "sha", options.sha)
    object(props)
}

fn renderReleaseDraft(draft: ReleaseDraft) -> Result<String, Error> {
    let mut props = [
        prop("tag_name", quote(requiredText("release tag", draft.tagName)?)),
        prop("draft", boolValue(draft.draft)),
        prop("prerelease", boolValue(draft.prerelease)),
        prop("generate_release_notes", boolValue(draft.generateReleaseNotes)),
    ]
    addOptionalStringProp(props, "target_commitish", draft.targetCommitish)
    addOptionalStringProp(props, "name", draft.name)
    addOptionalStringProp(props, "body", draft.body)
    addOptionalStringProp(props, "make_latest", draft.makeLatest)
    Ok(object(props))
}

fn renderReleaseNotesOptions(options: ReleaseNotesOptions) -> Result<String, Error> {
    let mut props = [prop("tag_name", quote(requiredText("release tag", options.tagName)?))]
    addOptionalStringProp(props, "target_commitish", options.targetCommitish)
    addOptionalStringProp(props, "previous_tag_name", options.previousTagName)
    Ok(object(props))
}

fn addOptionalStringProp(props: List<String>, name: String, value: String) {
    let clean = strings.trimSpace(value)
    if !clean.isEmpty() {
        props.push(prop(name, quote(clean)))
    }
}

fn addStringArrayProp(props: List<String>, name: String, values: List<String>) {
    if !values.isEmpty() {
        props.push(prop(name, stringArray(values)))
    }
}

fn stringArray(values: List<String>) -> String {
    let mut items: List<String> = []
    for value in values {
        let clean = strings.trimSpace(value)
        if !clean.isEmpty() {
            items.push(quote(clean))
        }
    }
    array(items)
}

fn requiredText(kind: String, value: String) -> Result<String, Error> {
    let clean = strings.trimSpace(value)
    if clean.isEmpty() {
        return Err(error.new("github: {kind} is empty"))
    }
    Ok(clean)
}

fn validateClient(client: Client) -> Result<(), Error> {
    if strings.trimSpace(client.baseUrl).isEmpty() {
        return Err(error.new("github: base URL is empty"))
    }
    if strings.trimSpace(client.uploadBaseUrl).isEmpty() {
        return Err(error.new("github: upload base URL is empty"))
    }
    Ok(())
}

fn cleanApiPath(value: String) -> Result<String, Error> {
    let clean = strings.trimSpace(value)
    if clean.isEmpty() {
        return Err(error.new("github: API path is empty"))
    }
    if strings.contains(clean, "?") || strings.contains(clean, "#") || strings.contains(clean, "..") {
        return Err(error.new("github: unsafe API path: {value}"))
    }
    if strings.startsWith(clean, "/") {
        return Ok(clean)
    }
    Ok("/{clean}")
}

fn cleanPathSegment(kind: String, value: String) -> Result<String, Error> {
    let clean = strings.trimSpace(value)
    if clean.isEmpty() {
        return Err(error.new("github: {kind} is empty"))
    }
    if strings.contains(clean, "/") || strings.contains(clean, "?") || strings.contains(clean, "#") {
        return Err(error.new("github: invalid {kind}: {value}"))
    }
    Ok(clean)
}

fn cleanAssetName(value: String) -> Result<String, Error> {
    let clean = cleanPathSegment("asset name", value)?
    if strings.contains(clean, "\\") {
        return Err(error.new("github: invalid asset name: {value}"))
    }
    Ok(clean)
}

fn positiveNumber(kind: String, value: Int) -> Result<Int, Error> {
    if value <= 0 {
        return Err(error.new("github: {kind} number must be positive"))
    }
    Ok(value)
}

fn encodePathSegment(segment: String) -> String {
    encoding.url.encode(segment)
}

fn stripTrailingSlash(value: String) -> String {
    let mut out = strings.trimSpace(value)
    for strings.endsWith(out, "/") {
        out = strings.trimSuffix(out, "/")
    }
    out
}

fn joinUrl(base: String, path: String) -> String {
    let cleanBase = stripTrailingSlash(base)
    if strings.startsWith(path, "/") {
        "{cleanBase}{path}"
    } else {
        "{cleanBase}/{path}"
    }
}

fn normalizedJsonObject(text: String) -> String {
    let raw = strings.trimSpace(text)
    if raw.isEmpty() {
        return "\{\}"
    }
    match json.parseValue(raw) {
        Ok(value) -> match json.asObject(value) {
            Ok(_)  -> json.stringifyValue(value),
            Err(_) -> "\{\}",
        },
        Err(_) -> "\{\}",
    }
}

fn stringField(obj: json.JsonObject, key: String) -> String {
    match obj.get(key) {
        Some(value) -> match json.asString(value) {
            Ok(text) -> text,
            Err(_)   -> "",
        },
        None -> "",
    }
}

fn object(props: List<String>) -> String {
    let open = 123.toChar()
    let close = 125.toChar()
    let joined = strings.join(props, ",")
    "{open}{joined}{close}"
}

fn array(items: List<String>) -> String {
    let joined = strings.join(items, ",")
    "[{joined}]"
}

fn prop(name: String, value: String) -> String {
    "{quote(name)}:{value}"
}

fn quote(text: String) -> String {
    json.stringifyValue(json.string(text))
}

fn boolValue(value: Bool) -> String {
    if value { "true" } else { "false" }
}
