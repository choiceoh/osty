pub fn requestPullRequestReviewersHttpRequest(client: Client, repository: Repository, number: Int, reviewers: List<String>, teamReviewers: List<String> = []) -> Result<http.Request, Error> {
    if reviewers.isEmpty() && teamReviewers.isEmpty() {
        return Err(error.new("github: reviewer request is empty"))
    }
    let n = positiveNumber("pull request", number)?
    githubJsonRequest(
        client,
        http.Post,
        "{repository.apiPath()}/pulls/{n}/requested_reviewers",
        object([
            prop("reviewers", stringArray(reviewers)),
            prop("team_reviewers", stringArray(teamReviewers)),
        ]),
    )
}

