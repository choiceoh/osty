pub fn llvmListRuntimePushSymbolFor(elemTyp: String, isString: Bool) -> String {
    if elemTyp == "ptr" && isString {
        return "osty_rt_list_push_string"
    }
    llvmListRuntimePushSymbol(llvmListElementSuffix(elemTyp))
}

