pub fn llvmMapKeySuffix(typ: String, isString: Bool) -> String {
    if isString {
        return "string"
    }
    if typ == "i64" {
        return "i64"
    }
    if typ == "i1" {
        return "i1"
    }
    if typ == "double" {
        return "f64"
    }
    if typ == "ptr" {
        return "ptr"
    }
    "bytes"
}

pub fn llvmMapRuntimeContainsSymbol(keyTyp: String, isString: Bool) -> String {
    "osty_rt_map_contains_" + llvmMapKeySuffix(keyTyp, isString)
}

