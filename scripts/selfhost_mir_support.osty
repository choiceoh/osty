pub fn mirMapValueSizeBytes(llvmTyp: String) -> Int {
    if llvmTyp == "i64" || llvmTyp == "double" || llvmTyp == "ptr" {
        return 8
    }
    if llvmTyp == "i32" {
        return 4
    }
    if llvmTyp == "i8" || llvmTyp == "i1" {
        return 1
    }
    0
}

