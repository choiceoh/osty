// Negative corpus — one file per rejected construct would explode the
// corpus count, so this file bundles representative "must reject" cases.
// The integration test invokes the parser+resolver on each subsection
// and asserts the expected diagnostic code. Subsections are delimited
// by `// === CASE: <Code> === <hint>` lines and terminated by `// === END`.

// === CASE: E0001 === unterminated string literal
fn f() { let s = "hello
}
// === END

// === CASE: E0002 === uppercase base prefix
fn f() { let n = 0X1F }
// === END

// === CASE: E0003 === surrogate code point in escape
fn f() { let c = '\u{D800}' }
// === END

// === CASE: E0005 === illegal (non-ASCII) character outside strings
fn f() { let x = 1 ⚡ 2 }
// === END

// === CASE: E0006 === triple-quoted string without leading newline
fn f() { let s = """oops""" }
// === END

// === CASE: E0007 === fat-arrow removed
fn f() -> Int { match 0 { 0 => 1, _ => 2 } }
// === END

// === CASE: E0008 === numeric separator placement
fn f() { let a = 1_; let b = 0x_FF; let c = 1__000 }
// === END

// === CASE: E0009 === empty char / byte literal
fn f() { let a = ''; let b = b'' }
// === END

// === CASE: E0101 === `use go` fn with body
use go "net/http" { fn Get(u: String) -> String { "x" } }
// === END

// === CASE: E0104 === mixed dot/slash in use path
use a/b.c
// === END

// ---- follow-on recovery diagnostics matrix (E0105 / E0100) ----
// Standard template:
//   1. include one primary malformed construct that triggers recovery
//   2. pin the *second-order* parser fallout we care about
//   3. keep the tail minimal so declaration/script drift stays obvious
//   4. name CASE hints `<Axis><Ordinal> ...` and helper fns `rf<Axis><Ordinal>...`
//
// Axis A — newline-else fallout.

// === CASE: E0105 === A1 `} else` across newline
fn rfA1ElseNewlinePrimary() -> Int {
    if rfA1Cond() {
        1
    }
    else {
        2
    }
}
fn rfA1Cond() -> Bool { false }
// === END

// === CASE: E0100 === A2 top-level `}` follow-on after `} else` newline recovery
fn rfA2ElseNewlineTopLevelDecl() -> Int {
    if rfA2Cond() {
        1
    }
    else {
        2
    }
}
fn rfA2Cond() -> Bool { false }
// === END

// Axis B — declaration-layer fallout after expression recovery.

// === CASE: E0100 === B1 top-level `}` follow-on after broken match-arm assignment body
fn rfB1MatchAssignTopLevelDecl(x: Int) {
    match x {
        0 -> out.path =
        _ -> 1,
    }
    let z = 2
}
// === END

// === CASE: E0106 === non-literal default value
fn connect(t: Int = compute()) {}
fn compute() -> Int { 0 }
// === END

// === CASE: E0107 === token not starting a struct member
pub struct S {
    123,
}
// === END

// === CASE: E0108 === token not starting an enum member
pub enum E {
    123,
}
// === END

// === CASE: E0109 === token not starting an interface member
pub interface I {
    123,
}
// === END

// === CASE: E0200 === non-associative comparison chain
fn f() { a() < b() < c() }
fn a() -> Int { 0 }
fn b() -> Int { 0 }
fn c() -> Int { 0 }
// === END

// === CASE: E0201 === `::` not followed by `<`
fn f() { let x = foo::bar() }
fn foo() {}
// === END

// === CASE: E0203 === closure with return type but no block body
fn f() { let g = |x: Int| -> Int x * 2 }
// === END

// === CASE: E0205 === token not starting a closure parameter
fn f() { let g = |123| 0 }
// === END

// === CASE: E0301 === token not starting a pattern
fn f(x: Int) -> Int { match x { + -> 1, _ -> 0 } }
// === END

// === CASE: E0400 === unknown annotation
// (Historically `#[inline]` was unknown; it was added to the permitted
// set in v0.6 A8, so the example is now any still-unregistered name.)
#[magicOptimize]
pub fn f() {}
// === END

// === CASE: E0500 === undefined name
fn f() { let x = undefinedThing }
// === END

// === CASE: E0501 === duplicate top-level declaration
fn dup() {}
fn dup() {}
// === END

// === CASE: E0503 === `self` outside a method
fn f() { let x = self }
// === END

// === CASE: E0504 === `Self` outside a type body
fn f() -> Self { 0 }
// === END

// === CASE: E0600 === `break` outside a loop
fn f() { break }
// === END

// === CASE: E0601 === `continue` outside a loop
fn f() { continue }
// === END

// === CASE: E0604 === `_` in expression position
fn f() { let x = _ }
// === END

// === CASE: E0605 === or-pattern with inconsistent bindings
pub enum E { A(Int), B(Int, Int) }
fn f(e: E) -> Int {
    match e { A(x) | B(x, y) -> x }
}
// === END

// === CASE: E0606 === interface default body reading a field on self
pub interface Greeter {
    fn greet(self) -> String { self.name }
}
// === END

// === CASE: E0607 === annotation on the wrong target
#[json]
pub fn wrongTarget() {}
// === END

// === CASE: E0607 === annotation on a `use` statement
#[deprecated]
use std.fs
// === END

// === CASE: E0608 === top-level `defer` in script
let x = 1
defer println("{x}")
// === END

// === CASE: E0609 === duplicate annotation name
#[deprecated]
#[deprecated]
pub fn f() {}
// === END

// === CASE: E0607 === #[vectorize] on a struct field (wrong target)
pub struct Bad {
    #[vectorize]
    pub count: Int,
}
// === END

// === CASE: E0739 === #[vectorize] rejects unknown argument keys
#[vectorize(foo = 4)]
pub fn hot(n: Int) -> Int { n }
// === END

// === CASE: E0739 === #[vectorize] rejects width out of range
#[vectorize(width = 99999)]
pub fn hot(n: Int) -> Int { n }
// === END

// === CASE: E0739 === #[unroll] rejects unknown argument keys
#[unroll(factor = 4)]
pub fn hot(n: Int) -> Int { n }
// === END

// === CASE: E0739 === #[parallel] takes no arguments
#[parallel(level = 2)]
pub fn hot(n: Int) -> Int { n }
// === END

// === CASE: E0739 === #[inline(...)] rejects unknown flag
#[inline(sometimes)]
pub fn mid(n: Int) -> Int { n }
// === END

// === CASE: E0739 === #[hot] takes no arguments
#[hot(priority = 1)]
pub fn hot(n: Int) -> Int { n }
// === END

// === CASE: E0739 === #[target_feature(...)] requires at least one feature
#[target_feature()]
pub fn wide(n: Int) -> Int { n }
// === END

// === CASE: E0739 === #[target_feature(...)] rejects duplicate features
#[target_feature(avx512f, avx512f)]
pub fn wide(n: Int) -> Int { n }
// === END

// === CASE: E0739 === #[noalias(...)] rejects key=value form
#[noalias(xs = 1)]
pub fn hot(xs: List<Int>) -> Int { 0 }
// === END

// === CASE: E0739 === #[noalias(...)] rejects duplicate param names
#[noalias(xs, xs)]
pub fn hot(xs: List<Int>) -> Int { 0 }
// === END

// === CASE: E0739 === #[pure] takes no arguments
#[pure(strict)]
pub fn hash(a: Int, b: Int) -> Int { a + b }
// === END

// === CASE: E0757 === `as?` on non-Error operand
fn f(n: Int) -> Int? {
    n as? Int
}
// === END

// === CASE: E0757 === `as?` target type must implement Error
fn g(err: Error) -> Int? {
    err as? Int
}
// === END

// === CASE: E0757 === `as?` target struct without `message()` must not satisfy Error
pub struct PlainNoMessage { pub x: Int }
fn gp(err: Error) -> PlainNoMessage? {
    err as? PlainNoMessage
}
// === END

// === CASE: E0202 === `as?` requires no whitespace between `as` and `?`
fn h(err: Error) -> Error? {
    err as ? Error
}
// === END

// === CASE: E0763 === `break 'label` references a label not in scope
fn no_such_label() {
    'outer: for i in 0..10 {
        break 'inner
    }
}
// === END

// === CASE: E0764 === inner label shadows an outer label of the same name
fn label_shadow() {
    'tag: for i in 0..10 {
        'tag: for j in 0..10 {
            break 'tag
        }
    }
}
// === END

// === CASE: E0743 === Handle<T> escapes via function return type
use std.thread
fn makeHandle() -> Handle<Int> {
    todo()
}
// === END

// === CASE: E0743 === Handle<T> inside struct field type
use std.thread
pub struct Pool {
    pub h: Handle<Int>,
}
// === END

// === CASE: E0743 === Handle<T> inside enum variant payload
use std.thread
pub enum Box { Wrap(Handle<Int>) }
// === END

// === CASE: E0743 === type alias for Handle<T>
use std.thread
type H = Handle<Int>
// === END

// === CASE: E0743 === Handle<T> as channel payload (call-site monomorph)
use std.thread
fn ch() {
    let _c = thread.chan::<Handle<Int>>(0)
}
// === END

// ---- primary recovery matrix (E0204) ----
// Standard template:
//   1. exactly one intentionally malformed site per CASE
//   2. preserve the nearest structural neighbour (`else`, next arm,
//      enclosing block, loop body, etc.)
//   3. end with `let z = 2` when a tail sentinel makes recovery drift
//      easy to spot in snapshots
//   4. name CASE hints `<Axis><Ordinal> ...` and helper fns `rm<Axis><Ordinal>...`
//
// Axis A — branch / arm continuity.

// === CASE: E0204 === A1 malformed then-branch expression recovers before `else`
fn rmA1Cond() -> Bool { false }
fn rmA1IfThenMissingRhs() {
    if rmA1Cond() {
        let x =
    } else {
        let y = 1
    }
    let z = 2
}
// === END

