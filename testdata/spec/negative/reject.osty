// Axis C — control-flow tail recovery.

// === CASE: E0204 === C1 malformed break value recovers to the next statement
fn rmC1BreakMalformedValue() {
    for i in 0..10 {
        break +
        let z = 2
    }
}
// === END

// === CASE: E0204 === C2 malformed labeled break value recovers to the next statement
fn rmC2LabeledBreakMalformedValue() {
    'outer: for i in 0..10 {
        break 'outer +
        let z = 2
    }
}
// === END

// === CASE: E0204 === C3 malformed continue suffix recovers to the next statement
fn rmC3ContinueMalformedSuffix() {
    for i in 0..10 {
        continue +
        let z = 2
    }
}
// === END

